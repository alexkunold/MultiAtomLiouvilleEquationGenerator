  "Out[211]=",ExpressionUUID->"97b8195c-07f5-4442-a108-5e0a7ce1e61c"]
}, Open  ]],

Cell["\<\
Next, we set the parameters for the Hamiltonian. The transCE configuration \
variable, which describes this light\[Dash]matter interaction, is\
\>", "Text",
 CellChangeTimes->{
  3.964868950316615*^9, {3.964869696729649*^9, 3.964869703282188*^9}, {
   3.964870651720611*^9, 3.96487067432911*^9}, 
   3.971288191813489*^9},ExpressionUUID->"117bc59d-2540-4452-b484-\
96cca56a4ab9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"transCE", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}], ",", "1", ",", " ", 
      SubscriptBox["R", "1"], ",", " ", 
      SubscriptBox["\[CapitalDelta]", "1"], ",", "0"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}], ",", "2", ",", " ", 
      SubscriptBox["R", "1"], ",", " ", 
      SubscriptBox["\[CapitalDelta]", "1"], ",", "\[Phi]"}], "}"}]}], 
   "}"}]}]], "Input",
 CellChangeTimes->{
  3.9648689701784077`*^9, {3.964877990128256*^9, 3.9648779956296*^9}, {
   3.964882457177184*^9, 3.964882458275833*^9}},
 CellLabel->
  "In[212]:=",ExpressionUUID->"353cbf33-a2cf-410c-b6b6-9f9b3fc2c0d4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}], ",", "1", ",", 
     SubscriptBox["R", "1"], ",", 
     SubscriptBox["\[CapitalDelta]", "1"], ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}], ",", "2", ",", 
     SubscriptBox["R", "1"], ",", 
     SubscriptBox["\[CapitalDelta]", "1"], ",", "\[Phi]"}], "}"}]}], 
  "}"}]], "Output",
 CellChangeTimes->{3.964870952358556*^9, 3.964876998446908*^9, 
  3.964877558939074*^9, 3.9648784766965513`*^9, 3.964882752525522*^9, 
  3.964882825754322*^9, 3.964883560148532*^9, 3.964885611836812*^9, 
  3.964887664994485*^9, 3.964964997122958*^9, 3.967476867693495*^9},
 CellLabel->
  "Out[212]=",ExpressionUUID->"9a8fefc7-b3fe-4d76-9064-0a934e4e0253"]
}, Open  ]],

Cell[TextData[{
 "This variable indicates that there is only one laser coupling the states \
\[VerticalSeparator]1\[RightAngleBracket] and \[VerticalSeparator]2\
\[RightAngleBracket] ({1,2}) for both atoms (1 ) and (2), with Rabi parameter \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "1"], TraditionalForm]],ExpressionUUID->
  "742d3c65-50a7-478d-979d-03d785b0a04c"],
 " and detuning ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalDelta]", "1"], TraditionalForm]],ExpressionUUID->
  "4d38df36-292c-4560-8361-a7e08f6502d4"],
 ". Note that a list of parameters ",
 StyleBox["per atom ",
  FontSlant->"Italic"],
 "is necessary",
 ". The phase due to the atoms\[CloseCurlyQuote] positions is taken to be \
zero for the first atom and \[Phi] for the second. Assuming that both atoms \
lie along the propagation direction of the incident field, there must be a \
phase difference of \[Phi] between them. The variable transdd, which lists \
the coherent interactions between atoms, is "
}], "Text",
 CellChangeTimes->{{3.9648689970376377`*^9, 3.964869024649825*^9}, {
   3.964869055455311*^9, 3.964869188975588*^9}, {3.964869230578914*^9, 
   3.9648692343387337`*^9}, 3.964870202040921*^9, {3.964870233477539*^9, 
   3.964870258191699*^9}, {3.964870344023551*^9, 3.9648703678804893`*^9}, {
   3.964878015995497*^9, 3.964878042002239*^9}, {3.964878217989825*^9, 
   3.964878320249117*^9}, {3.964878423252204*^9, 3.9648784257720957`*^9}, 
   3.964878466002437*^9, {3.9648824706274557`*^9, 3.964882534565366*^9}, {
   3.964882569215476*^9, 3.964882629818945*^9}, {3.9648826819697933`*^9, 
   3.964882708602992*^9}, {3.971288201477261*^9, 3.971288239730834*^9}, {
   3.978605851453601*^9, 
   3.978605904140292*^9}},ExpressionUUID->"c35754d7-e083-4130-a24e-\
32cde0f47ce7"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"transdd", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}], ",", "1", ",", "2", ",", 
      SubscriptBox["\[CapitalOmega]", "1"], ",", "0"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}], ",", "2", ",", "1", ",", 
      SubscriptBox["\[CapitalOmega]", "1"], ",", "0"}], "}"}]}], 
   "}"}]}]], "Input",
 CellChangeTimes->{{3.964870274970359*^9, 3.964870278612465*^9}, {
  3.964878521249243*^9, 3.96487853825541*^9}, {3.964882425516357*^9, 
  3.964882453119158*^9}},
 CellLabel->
  "In[213]:=",ExpressionUUID->"c2b4499d-84bb-47bf-9466-60bc5413e1d6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}], ",", "1", ",", "2", ",", 
     SubscriptBox["\[CapitalOmega]", "1"], ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}], ",", "2", ",", "1", ",", 
     SubscriptBox["\[CapitalOmega]", "1"], ",", "0"}], "}"}]}], 
  "}"}]], "Output",
 CellChangeTimes->{3.964870955457838*^9, 3.964877001067569*^9, 
  3.9648775615304832`*^9, 3.964878545174305*^9, 3.964882755073872*^9, 
  3.964882825806078*^9, 3.964883563732657*^9, 3.9648856146775637`*^9, 
  3.964887668014531*^9, 3.964964999463664*^9, 3.9674768677108803`*^9},
 CellLabel->
  "Out[213]=",ExpressionUUID->"42db4fa6-fdfa-4d96-b1c1-0de527452ad5"]
}, Open  ]],

Cell[TextData[{
 "The first two elements are the transitions that couple to each other. The \
list {1,2} appears twice. Each transition couples to each transition with the \
same energy gap. The next two numbers indicate which two atoms are involved. ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalOmega]", "1"], TraditionalForm]],ExpressionUUID->
  "ee9af9ca-77e9-4b00-a01c-d7746419e360"],
 " indicates the strength of the coupling. 0 indicates the energy difference \
between the transitions. All together \[OpenCurlyDoubleQuote]",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}], ",", "1", ",", "2", ",", 
    SubscriptBox["\[CapitalOmega]", "1"], ",", "0"}], "}"}]], "Input",
  CellChangeTimes->{{3.964870274970359*^9, 3.964870278612465*^9}, {
   3.964878521249243*^9, 3.96487853825541*^9}, {3.964882425516357*^9, 
   3.964882453119158*^9}},ExpressionUUID->
  "bc0857ef-baf1-4602-a900-e257dc8fc7cf"],
 "\[CloseCurlyDoubleQuote] means that the transition {1,2} in atom 1 is \
coupled to the transition {1,2} in atom 2, with strength ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalOmega]", "1"], TraditionalForm]],ExpressionUUID->
  "f5d0366e-3ea8-4603-9e73-05b2b0b1085f"],
 " and that there is no energy gap difference between the two transitions. \
The list is then repeated with the numbers indicating the atoms switched as \
the coupling is symmetrical under atomic exchanges.  In a more complex \
system, each atomic transition could be coupled to several other transitions \
and as such each coupling would have to be entered separately using the same \
format.\n"
}], "Text",
 CellChangeTimes->{{3.964878605456562*^9, 3.964878627977973*^9}, {
   3.964878660994974*^9, 3.964878688524351*^9}, {3.964878719652362*^9, 
   3.964878830308481*^9}, {3.964878879929863*^9, 3.964878973118375*^9}, 
   3.964879011851337*^9, {3.971288313217846*^9, 3.9712883302806063`*^9}, {
   3.971288363982709*^9, 3.971288613598023*^9}, {3.974890529820209*^9, 
   3.974890564677824*^9}},ExpressionUUID->"ad10d8fb-963a-48c4-b133-\
0970a55359c3"],

Cell["With these variables set, we compute the Hamiltonian", "Text",
 CellChangeTimes->{{3.9648708930994463`*^9, 3.964870907086039*^9}, 
   3.964872419717458*^9, {3.971288617753376*^9, 
   3.971288618168364*^9}},ExpressionUUID->"48c5eb8f-6cee-4992-b703-\
a90dccbfc761"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"ham", "=", 
   RowBox[{"Ham", "[", 
    RowBox[{"transCE", ",", "transdd", ",", "nl", ",", "na", ",", "t"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"MatrixForm", "[", "ham", "]"}]}], "Input",
 CellChangeTimes->{{3.9648709195144033`*^9, 3.964870973190476*^9}},
 CellLabel->
  "In[214]:=",ExpressionUUID->"779bc898-5516-455b-8cbb-2074af9ac5bf"],

Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", GridBox[{
     {"0", 
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", 
          RowBox[{"(", 
           RowBox[{"\[Phi]", "-", 
            RowBox[{"t", " ", 
             SubscriptBox["\[CapitalDelta]", "1"]}]}], ")"}]}]]}], " ", 
       SubscriptBox["R", "1"]}], 
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", "\[ImaginaryI]"}], " ", "t", " ", 
          SubscriptBox["\[CapitalDelta]", "1"]}]]}], " ", 
       SubscriptBox["R", "1"]}], "0"},
     {
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "\[Phi]"}], "+", 
            RowBox[{"t", " ", 
             SubscriptBox["\[CapitalDelta]", "1"]}]}], ")"}]}]]}], " ", 
       SubscriptBox["R", "1"]}], "0", 
      SubscriptBox["\[CapitalOmega]", "1"], 
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", "\[ImaginaryI]"}], " ", "t", " ", 
          SubscriptBox["\[CapitalDelta]", "1"]}]]}], " ", 
       SubscriptBox["R", "1"]}]},
     {
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", "t", " ", 
          SubscriptBox["\[CapitalDelta]", "1"]}]]}], " ", 
       SubscriptBox["R", "1"]}], 
      SubscriptBox["\[CapitalOmega]", "1"], "0", 
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", 
          RowBox[{"(", 
           RowBox[{"\[Phi]", "-", 
            RowBox[{"t", " ", 
             SubscriptBox["\[CapitalDelta]", "1"]}]}], ")"}]}]]}], " ", 
       SubscriptBox["R", "1"]}]},
     {"0", 
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", "t", " ", 
          SubscriptBox["\[CapitalDelta]", "1"]}]]}], " ", 
       SubscriptBox["R", "1"]}], 
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "\[Phi]"}], "+", 
            RowBox[{"t", " ", 
             SubscriptBox["\[CapitalDelta]", "1"]}]}], ")"}]}]]}], " ", 
       SubscriptBox["R", "1"]}], "0"}
    },
    GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
    GridBoxSpacings->{"Columns" -> {
        Offset[0.27999999999999997`], {
         Offset[0.7]}, 
        Offset[0.27999999999999997`]}, "Rows" -> {
        Offset[0.2], {
         Offset[0.4]}, 
        Offset[0.2]}}], "\[NoBreak]", ")"}],
  Function[BoxForm`e$, 
   MatrixForm[
   SparseArray[
    Automatic, {4, 4}, 0, {
     1, {{0, 2, 5, 8, 10}, {{2}, {3}, {1}, {3}, {4}, {1}, {2}, {4}, {2}, {
       3}}}, {(-
        E^(Complex[0, 1] ($CellContext`\[Phi] - $CellContext`t 
           Subscript[$CellContext`\[CapitalDelta], 1]))) 
       Subscript[$CellContext`R, 1], (-
        E^(Complex[0, -1] $CellContext`t 
          Subscript[$CellContext`\[CapitalDelta], 1])) 
       Subscript[$CellContext`R, 1], (-
        E^(Complex[
           0, 1] (-$CellContext`\[Phi] + $CellContext`t 
            Subscript[$CellContext`\[CapitalDelta], 1]))) 
       Subscript[$CellContext`R, 1], 
       Subscript[$CellContext`\[CapitalOmega], 1], (-
        E^(Complex[0, -1] $CellContext`t 
          Subscript[$CellContext`\[CapitalDelta], 1])) 
       Subscript[$CellContext`R, 1], (-
        E^(Complex[0, 1] $CellContext`t 
          Subscript[$CellContext`\[CapitalDelta], 1])) 
       Subscript[$CellContext`R, 1], 
       Subscript[$CellContext`\[CapitalOmega], 1], (-
        E^(Complex[0, 1] ($CellContext`\[Phi] - $CellContext`t 
           Subscript[$CellContext`\[CapitalDelta], 1]))) 
       Subscript[$CellContext`R, 1], (-
        E^(Complex[0, 1] $CellContext`t 
          Subscript[$CellContext`\[CapitalDelta], 1])) 
       Subscript[$CellContext`R, 1], (-
        E^(Complex[
           0, 1] (-$CellContext`\[Phi] + $CellContext`t 
            Subscript[$CellContext`\[CapitalDelta], 1]))) 
       Subscript[$CellContext`R, 1]}}]]]]], "Output",
 CellChangeTimes->{{3.964870949796059*^9, 3.964870973665702*^9}, 
   3.964877004147091*^9, 3.964877564303691*^9, 3.964879034543002*^9, 
   3.964882759372969*^9, 3.964882825818728*^9, 3.964883567804248*^9, 
   3.96488561958452*^9, 3.964887671774654*^9, 3.964965003309559*^9, 
   3.967476867721243*^9},
 CellLabel->
  "Out[215]//MatrixForm=",ExpressionUUID->"7160fa08-96a7-4583-91f4-\
4be079c46123"]
}, Open  ]],

Cell["\<\
The Liouville operator corresponding to the Hamiltonian is given by\
\>", "Text",
