  "Out[404]=",ExpressionUUID->"09f1a719-99e5-4271-98a1-1ef8c4cb19ff"]
}, Open  ]],

Cell["Solve the differential equations", "Text",
 CellChangeTimes->{{3.964796578415927*^9, 
  3.964796610079886*^9}},ExpressionUUID->"2f14e35a-187d-4d79-b67b-\
68f6e286bfec"],

Cell[BoxData[
 RowBox[{
  RowBox[{"sol", "=", 
   RowBox[{
    RowBox[{"NDSolve", "[", 
     RowBox[{"difeqs", ",", "rho", ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "100"}], "}"}]}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.964796615234055*^9, 3.964796630440727*^9}, {
  3.964796724647853*^9, 3.96479673777914*^9}},
 CellLabel->
  "In[408]:=",ExpressionUUID->"f5f31e42-d716-48cf-8699-2b630323e15f"],

Cell["\<\
Calculate and plot the populations of the 8 transmon quantum levels\
\>", "Text",
 CellChangeTimes->{{3.964796762880595*^9, 
  3.964796796072747*^9}},ExpressionUUID->"60f5b760-4b46-4a06-8b25-\
d87260dc6222"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"plots", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Do", "[", "\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"op", "=", 
     RowBox[{"SparseArray", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"ii", ",", "ii"}], "}"}], "->", "1"}], "}"}], ",", "ns"}], 
      "]"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"expval", "=", 
     RowBox[{"ExpectationValue", "[", 
      RowBox[{"h", ",", "rho", ",", "op"}], "]"}]}], ";", 
    "\[IndentingNewLine]", 
    RowBox[{"expvaln", "=", 
     RowBox[{"expval", "/.", "sol"}]}], ";", "\[IndentingNewLine]", 
    RowBox[{"AppendTo", "[", 
     RowBox[{"plots", ",", "expvaln"}], "]"}], ";"}], "\[IndentingNewLine]", 
   ",", 
   RowBox[{"{", 
    RowBox[{"ii", ",", "1", ",", "8"}], "}"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.964796825777532*^9, 3.964796888512545*^9}, {
  3.9647969404068813`*^9, 3.964796943453369*^9}, {3.964797008769864*^9, 
  3.9647970228110356`*^9}},
 CellLabel->
  "In[409]:=",ExpressionUUID->"965f05c0-ec50-4304-9574-148e27773ccc"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{"plots", ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "32"}], "}"}], ",", 
   RowBox[{"PlotRange", "->", "All"}], ",", 
   RowBox[{"Axes", "->", "False"}], ",", 
   RowBox[{"Frame", "->", "True"}], ",", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Style", "[", 
       RowBox[{"\"\<t (ns)\>\"", ",", "20"}], "]"}], ",", 
      RowBox[{"Style", "[", 
       RowBox[{"\"\<Populations\>\"", ",", "20"}], "]"}]}], "}"}]}], ",", 
   RowBox[{"PlotLabels", "->", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"Style", "[", 
       RowBox[{
        SubscriptBox["\[Rho]", "ii"], ",", "16"}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"ii", ",", "1", ",", "8"}], "}"}]}], "]"}]}], ",", 
   RowBox[{"ImageSize", "->", "450"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.964796915167842*^9, 3.964796961857736*^9}, {
  3.964797337082812*^9, 3.964797349054929*^9}, {3.967286111614211*^9, 
