Cell[TextData[{
 "We can also perform a spectroscopic analysis of the emission of the \
two-level system by sweeping the detuning of the pump laser and evaluating \
the correlation function corr = \[LeftAngleBracket]",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Sigma]", 
    RowBox[{"2", ",", "1"}], "1"], TraditionalForm]],ExpressionUUID->
  "ae376b97-3058-444a-b6ad-b73ad80409f1"],
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Sigma]", 
    RowBox[{"1", ",", "2"}], "2"], TraditionalForm]],ExpressionUUID->
  "693505a8-6333-4bfc-9148-b0de1fccb26e"],
 "+",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Sigma]", 
    RowBox[{"2", ",", "1"}], "2"], TraditionalForm]],ExpressionUUID->
  "f7be8197-a6b7-4072-a8ef-46ae35538c41"],
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Sigma]", 
    RowBox[{"1", ",", "2"}], "1"], TraditionalForm]],ExpressionUUID->
  "0d597e6b-62f4-4587-99b3-d9a41213314b"],
 "\[RightAngleBracket] where ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Sigma]", 
    RowBox[{"1", ",", "2"}], "1"], TraditionalForm]],ExpressionUUID->
  "35f0e763-4898-4b26-8a41-76fb1b64d376"],
 " =1\[CircleTimes] \[VerticalSeparator]1\[RightAngleBracket]\
\[LeftAngleBracket]2\[VerticalSeparator] and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Sigma]", 
    RowBox[{"1", ",", "2"}], "2"], TraditionalForm]],ExpressionUUID->
  "9141b503-3443-4370-9ffa-901e6413a2ee"],
 " = \[VerticalSeparator]1\[RightAngleBracket]\[LeftAngleBracket]2\
\[VerticalSeparator]\[CircleTimes]1"
}], "Text",
 CellChangeTimes->{{3.964874665519184*^9, 3.964874722487727*^9}, {
   3.964875676599267*^9, 3.964875680201333*^9}, {3.964875822148663*^9, 
   3.9648758315726213`*^9}, {3.964875893631707*^9, 3.964875933481038*^9}, {
   3.964876002292228*^9, 3.964876070039279*^9}, 3.964876658177387*^9, {
   3.964883743130004*^9, 3.964883872528242*^9}, {3.964965105583737*^9, 
   3.964965107441894*^9}, {3.971288854925023*^9, 
   3.971288870435422*^9}},ExpressionUUID->"45e4c3da-c8fd-439a-8403-\
2e6b3a042536"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"nd", "=", "200"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Eta]0", "=", 
   RowBox[{"SparseArray", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}], "->", "1"}], "}"}], ",", "2"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rho0", "=", 
   RowBox[{"KroneckerProduct", "[", 
    RowBox[{"\[Eta]0", ",", "\[Eta]0"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"incon", "=", 
   RowBox[{"InitialConditions", "[", 
    RowBox[{"h", ",", "rho", ",", "rho0", ",", "t"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"corr", "=", 
   RowBox[{
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{
      RowBox[{"SparseArray", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "2"}], "}"}], "->", "1"}], "}"}], ",", "2"}], 
       "]"}], ",", 
      RowBox[{"SparseArray", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"2", ",", "1"}], "}"}], "->", "1"}], "}"}], ",", "2"}], 
       "]"}]}], "]"}], "+", 
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{
      RowBox[{"SparseArray", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"2", ",", "1"}], "}"}], "->", "1"}], "}"}], ",", "2"}], 
       "]"}], ",", 
      RowBox[{"SparseArray", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "2"}], "}"}], "->", "1"}], "}"}], ",", "2"}], 
       "]"}]}], "]"}]}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"expval", "=", 
   RowBox[{"ExpectationValue", "[", 
    RowBox[{"h", ",", "rho", ",", "corr"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"listplot", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"det", "=", 
      RowBox[{
       RowBox[{"-", "150"}], "+", 
       RowBox[{"300", 
        RowBox[{"jj", "/", "nd"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"parmvals", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         SubscriptBox["R", "1"], "->", "12.0"}], ",", 
        RowBox[{
         SubscriptBox["\[CapitalDelta]", "1"], "->", "det"}], ",", 
        RowBox[{"\[Phi]", "->", "1.1"}], ",", 
        RowBox[{
         SubscriptBox["\[Gamma]", "1"], "->", "1.5"}], ",", 
        RowBox[{
         SubscriptBox["\[Gamma]", 
          RowBox[{"1", ",", "2"}]], "->", "0.5"}], ",", 
        RowBox[{
         SubscriptBox["\[CapitalOmega]", "1"], "->", "0.7"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"eqsn", "=", 
      RowBox[{"eqs", "/.", "parmvals"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"diffeq", "=", 
      RowBox[{"Join", "[", 
       RowBox[{"eqsn", ",", "incon"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sol", "=", 
      RowBox[{
       RowBox[{"NDSolve", "[", 
        RowBox[{"diffeq", ",", 
         RowBox[{"Normal", "[", "rho", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "10"}], "}"}]}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"expvaln", "=", 
      RowBox[{
       RowBox[{"expval", "/.", "sol"}], "/.", 
       RowBox[{"{", 
        RowBox[{"t", "->", "10"}], "}"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"listplot", ",", 
       RowBox[{"{", 
        RowBox[{"det", ",", "expvaln"}], "}"}]}], "]"}], ";"}], 
    "\[IndentingNewLine]", ",", 
    RowBox[{"{", 
     RowBox[{"jj", ",", "0", ",", "nd"}], "}"}]}], "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot", "[", 
  RowBox[{"listplot", ",", 
   RowBox[{"Axes", "->", "False"}], ",", 
   RowBox[{"Frame", "->", "True"}], ",", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Style", "[", 
       RowBox[{
       "\"\<\!\(\*SubscriptBox[\(\[CapitalDelta]\), \(1\)]\)\>\"", ",", 
        "20"}], "]"}], ",", 
      RowBox[{"Style", "[", 
       RowBox[{
       "\"\<\[LeftAngleBracket]\!\(TraditionalForm\`\*SubsuperscriptBox[\(\
\[Sigma]\), \(2, 1\), \(1\)]\)\!\(TraditionalForm\`\*SubsuperscriptBox[\(\
\[Sigma]\), \(1, 2\), \(2\)]\)+\!\(TraditionalForm\`\*SubsuperscriptBox[\(\
\[Sigma]\), \(2, 1\), \(2\)]\)\!\(TraditionalForm\`\*SubsuperscriptBox[\(\
\[Sigma]\), \(1, 2\), \(1\)]\)\[RightAngleBracket]\>\"", ",", "20"}], "]"}]}],
      "}"}]}], ",", 
   RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9648752944144907`*^9, 3.964875395938235*^9}, {
   3.964875458245583*^9, 3.96487548109902*^9}, {3.9648755148241377`*^9, 
