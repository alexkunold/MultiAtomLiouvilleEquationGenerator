      RowBox[{
       RowBox[{"-", "3"}], ",", "3"}], "]"}], ",", " ", 
     RowBox[{"Range", "[", 
      RowBox[{
       RowBox[{"-", "3"}], ",", "3"}], "]"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"levtrlist", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "3"}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lasertrlist", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         FractionBox["1", 
          SqrtBox["2"]], ",", 
         RowBox[{"-", 
          FractionBox["\[ImaginaryI]", 
           SqrtBox["2"]]}], ",", "0"}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         FractionBox["1", 
          SqrtBox["2"]], ",", 
         RowBox[{"-", 
          FractionBox["\[ImaginaryI]", 
           SqrtBox["2"]]}], ",", "0"}], "}"}]}], "}"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
    "levels", ",", " ", "transitions", ",", " ", "transdd", ",", " ", 
     "transLi", ",", " ", "transCE"}], "}"}], "=", 
   RowBox[{"TransitionLists", "[", 
    RowBox[{
     FractionBox["3", "2"], ",", "Jlist", ",", "Flist", ",", "mFlist", ",", 
     "levtrlist", ",", "lasertrlist", ",", "na", ",", " ", "R", ",", " ", 
     "\[Delta]", ",", "\[Phi]", ",", " ", "\[Gamma]", ",", " ", "F", ",", " ",
      "G"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.965305422997344*^9, 3.965305533417433*^9}, {
