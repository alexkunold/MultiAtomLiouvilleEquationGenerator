Cell["\<\
Calculate the dressed state Hamiltonian and the corresponding Liouville \
operator\
\>", "Text",
 CellChangeTimes->{{3.964376336864023*^9, 
  3.964376372245865*^9}},ExpressionUUID->"d48e59ea-db1e-40da-8f8c-\
969625cd3177"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"hamd", "=", 
   RowBox[{"HamDressed", "[", 
    RowBox[{"transCE", ",", " ", "transdd", ",", " ", "nl", ",", " ", "na"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"LiouvilleHR", " ", "=", " ", 
   RowBox[{"-", 
    RowBox[{"CleanUp", "[", 
     RowBox[{"LiouvilleCommutator", "[", 
      RowBox[{"h", ",", "hamd"}], "]"}], "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9640355080738487`*^9, 3.96403551932438*^9}, {
  3.964293398261392*^9, 3.964293402665019*^9}, {3.964293518490305*^9, 
  3.964293523641214*^9}, {3.964376353975134*^9, 3.9643763555080633`*^9}, {
  3.964376387561492*^9, 3.9643763956708307`*^9}},
 CellLabel->
  "In[369]:=",ExpressionUUID->"be9b67a2-9e4a-4575-96ee-91acb826666f"],

Cell["Calculate the Lindbladian superoperator", "Text",
 CellChangeTimes->{{3.96437644006109*^9, 
  3.964376450760363*^9}},ExpressionUUID->"ae7fad84-cb83-4f99-98ba-\
aaeb35761c15"],

Cell[BoxData[
 RowBox[{
  RowBox[{"LiouvilleL", "=", 
   RowBox[{"CleanUp", "[", 
    RowBox[{"LiouvilleLindbladian", "[", 
     RowBox[{"h", ",", " ", "transLi", ",", "nl", ",", "na"}], "]"}], "]"}]}],
   ";"}]], "Input",
 CellChangeTimes->{
  3.9643764690242157`*^9, {3.964376532890224*^9, 3.964376568758155*^9}, {
   3.964376615773511*^9, 3.964376643704865*^9}},
 CellLabel->
  "In[371]:=",ExpressionUUID->"ae7b9fc6-a11b-46c1-9744-ac20f3550526"],

Cell["\<\
It is important to remember that the Lindbladian superoperator remains \
invariant under rotating-frame transformations and, therefore, is calculated \
just as it would be in the standard basis. The full Liouville operator is the \
sum of LiouvilleHR and LiouvilleL\
\>", "Text",
 CellChangeTimes->{{3.964376664124815*^9, 3.964376797379021*^9}, {
   3.964376904250573*^9, 3.96437692687254*^9}, 
   3.964376981479443*^9},ExpressionUUID->"c70a31eb-2a37-44be-9896-\
c33b56d7da94"],

Cell[BoxData[
 RowBox[{
  RowBox[{"LiouvilleR", "=", 
   RowBox[{"Re", "[", 
    RowBox[{"Developer`ToPackedArray", "@", 
     RowBox[{"(", 
      RowBox[{"LiouvilleHR", "+", "LiouvilleL"}], ")"}]}], "]"}]}], 
  ";"}]], "Input",
 CellLabel->
  "In[372]:=",ExpressionUUID->"ebba3e90-abe1-4194-a02f-ce539545ff65"],

Cell[BoxData[
 RowBox[{
  RowBox[{"VRD", "=", 
   RowBox[{"MatrixExp", "[", 
    RowBox[{"LiouvilleR", " ", "t"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9642958798657207`*^9, 3.964295882474968*^9}, {
  3.964295920466454*^9, 3.96429592437541*^9}, {3.964295995097183*^9, 
  3.964296034497334*^9}, {3.964376998362877*^9, 3.96437700035515*^9}, {
  3.964378563003834*^9, 3.964378568792166*^9}},
 CellLabel->
  "In[373]:=",ExpressionUUID->"39d4fcbe-7000-420f-ba15-f8c6ab5f7e87"],

Cell["Obtain the rotating-frame transformations", "Text",
 CellChangeTimes->{{3.964376482055455*^9, 3.964376494138503*^9}, {
   3.964376590996714*^9, 3.964376594326544*^9}, {3.96437702504571*^9, 
   3.964377061458472*^9}, 3.964377095621007*^9, {3.964377560644623*^9, 
   3.964377561827079*^9}},ExpressionUUID->"0e9997d1-bca3-4c55-8477-\
4998e104f037"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{"U", ",", " ", "UT", ",", "UR", ",", " ", "URT"}], "}"}], " ", "=",
   " ", 
  RowBox[{"RotatingFrameTrans", "[", 
   RowBox[{"h", ",", "transCE", ",", "nl", ",", " ", "na", ",", " ", "t"}], 
   "]"}]}]], "Input",
 CellChangeTimes->{3.964377650259498*^9},
 CellLabel->
  "In[374]:=",ExpressionUUID->"c86948ac-323e-437e-8571-13c87eef18e6"],

