       SubscriptBox["R", "2"]}]},
     {"0", "0", "0", 
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Phi]"}]]}], " ", 
       SubscriptBox["R", "2"]}], "0", "0", 
