    RowBox[{"1", ",", "1"}]]}], "}"}]], "Output",
 CellChangeTimes->{3.9653133547852097`*^9, 3.965328298359571*^9, 
  3.965329627599186*^9, 3.965398253064588*^9, 3.965398474520894*^9, 
  3.967476863667049*^9, 3.9677153648819523`*^9},
 CellLabel->"Out[22]=",ExpressionUUID->"5430ee6c-709e-45e8-97c2-e625934fa4a7"]
}, Open  ]],

