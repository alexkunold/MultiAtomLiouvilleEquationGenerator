Cell[BoxData[{
 RowBox[{"\[Eta]0", "=", 
  RowBox[{"SparseArray", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "1"}], "}"}], "->", "1"}], "}"}], ",", "2"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"rho0", "=", 
  RowBox[{"KroneckerProduct", "[", 
   RowBox[{
   "\[Eta]0", ",", "\[Eta]0", ",", "\[Eta]0", ",", "\[Eta]0", ",", 
    "\[Eta]0"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eqs", "=", 
   RowBox[{"MasterEquation", "[", 
    RowBox[{
    "h", ",", "rho", ",", "rho0", ",", "transCE", ",", "transdd", ",", 
     "transLi", ",", "nl", ",", "na", ",", "t"}], "]"}]}], 
