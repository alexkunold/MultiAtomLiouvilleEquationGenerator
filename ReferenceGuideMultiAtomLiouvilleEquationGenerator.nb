  3.964876976051291*^9}},ExpressionUUID->"943087c2-91ad-4cca-843d-\
579e07841473"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "SetDirectory", "[", "PathToMultiAtomLiouvilleEquationGenerator", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Needs", "[", "\"\<MultiAtomLiouvilleEquationGenerator`\>\"", 
  "]"}]}], "Input",
 CellChangeTimes->{3.965317107876034*^9},
 CellLabel->
  "In[359]:=",ExpressionUUID->"4db752a5-87bb-44a9-9aad-a0a41db76217"],

Cell[TextData[{
 "We calculate the evolution operator for a system consisting of two (na=2) \
three level (nl=3) atoms interacting with two lasers with Rabi frequencies ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "1"], TraditionalForm]],ExpressionUUID->
  "10896b18-7163-4a37-ab81-d1d2e785a172"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "2"], TraditionalForm]],ExpressionUUID->
  "0ba85510-f48d-4a1d-adda-fec08073932d"],
 " and detunings  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalDelta]", "1"], TraditionalForm]],ExpressionUUID->
  "15a52ce7-3264-4122-b96c-f1e46343d36a"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalDelta]", "2"], TraditionalForm]],ExpressionUUID->
  "10a721aa-d090-4813-acef-99cf2bbc1e24"],
 ", respectively. The first laser couples the states \[VerticalSeparator]1\
\[RightAngleBracket] and \[VerticalSeparator]2\[RightAngleBracket] with  Rabi \
frequency ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "1"], TraditionalForm]],ExpressionUUID->
  "210b4993-c48b-4c13-8bb5-a26e2d3b4f55"],
 " and the second couples \[VerticalSeparator]2\[RightAngleBracket] and \
\[VerticalSeparator]3\[RightAngleBracket] with  Rabi frequency ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "2"], TraditionalForm]],ExpressionUUID->
  "29d9f522-1f08-4d83-a931-3bfa85839b93"],
 " for both atoms. Both atoms are at different positions along the \
light-propagation direction and therefore have a phase difference \[Phi]. \
First we set the numerical values of the system parameters"
}], "Text",
 CellChangeTimes->CompressedData["
1:eJxTTMoPSmViYGCQAGIQnTHdKq2g/K1jf218IYj2ufizAUR/X/+jB0T7Gzqc
BNGHP68H04FnGx+A6GfNvM8g4lqeJUBai8fHD0TrdOXEg+iWFp9yEL1VzaIa
RD+5ntcGopmOZn0E0a/Wun8B0TdOrRUpBdKai9VkQHTE6WAFEO19NlcNRMtU
b3aaB6SjrF64gGj1+emLFgLpoAerwbRWYa/QIiD9eu0qeRC9KNlWHUSvXR+l
BaKT2mpNvTreOi5Z7WcJoqv+a9qDaBZpUXcQbWSwwBtEN19YAqaZX4sfOwWk
ZWokj4PoRzFNz0G0TczZlyB6R4TbOxB9saXuPYg+cOuMUlHnW8f/PgbKIHrS
Wv+tb2a+dZR4kQemb52edwxEN71nPQ2iHf5yXQLRDxiugWkAKWPN0w==
  "],ExpressionUUID->"c9d875db-d2d0-403e-a0c1-6caf330734e8"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"parmvals", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{
     SubscriptBox["R", "1"], "->", "12.0"}], ",", 
    RowBox[{
     SubscriptBox["R", "2"], "->", "8.0"}], ",", 
    RowBox[{"\[Phi]", "->", "0"}], ",", 
    RowBox[{
     SubscriptBox["\[CapitalDelta]", "1"], "->", "1.0"}], ",", 
    RowBox[{
     SubscriptBox["\[CapitalDelta]", "2"], "->", 
     RowBox[{"-", "1.0"}]}], ",", 
    RowBox[{
     SubscriptBox["\[Gamma]", "1"], "->", "1.5"}], ",", " ", 
    RowBox[{
     SubscriptBox["\[Gamma]", "2"], "->", "5.0"}], ",", 
    RowBox[{
     SubscriptBox["\[Gamma]", 
      RowBox[{"1", ",", "1"}]], "->", "0.3"}], ",", 
    RowBox[{
     SubscriptBox["\[Gamma]", 
      RowBox[{"2", ",", "2"}]], "->", "0.1"}], ",", 
    RowBox[{
     SubscriptBox["\[CapitalOmega]", "1"], "->", "0.7"}], ",", " ", 
    RowBox[{
     SubscriptBox["\[CapitalOmega]", "2"], "->", "0.43"}]}], "}"}]}]], "Input",\

 CellChangeTimes->{{3.964033077571973*^9, 3.964033080089631*^9}},
 CellLabel->
  "In[361]:=",ExpressionUUID->"890dcf83-aacc-4354-8508-7a3c248a5ca2"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    SubscriptBox["R", "1"], "\[Rule]", "12.`"}], ",", 
   RowBox[{
    SubscriptBox["R", "2"], "\[Rule]", "8.`"}], ",", 
   RowBox[{"\[Phi]", "\[Rule]", "0"}], ",", 
   RowBox[{
    SubscriptBox["\[CapitalDelta]", "1"], "\[Rule]", "1.`"}], ",", 
   RowBox[{
    SubscriptBox["\[CapitalDelta]", "2"], "\[Rule]", 
    RowBox[{"-", "1.`"}]}], ",", 
   RowBox[{
    SubscriptBox["\[Gamma]", "1"], "\[Rule]", "1.5`"}], ",", 
   RowBox[{
    SubscriptBox["\[Gamma]", "2"], "\[Rule]", "5.`"}], ",", 
   RowBox[{
    SubscriptBox["\[Gamma]", 
     RowBox[{"1", ",", "1"}]], "\[Rule]", "0.3`"}], ",", 
   RowBox[{
    SubscriptBox["\[Gamma]", 
     RowBox[{"2", ",", "2"}]], "\[Rule]", "0.1`"}], ",", 
   RowBox[{
    SubscriptBox["\[CapitalOmega]", "1"], "\[Rule]", "0.7`"}], ",", 
   RowBox[{
    SubscriptBox["\[CapitalOmega]", "2"], "\[Rule]", "0.43`"}]}], 
  "}"}]], "Output",
 CellChangeTimes->{
  3.964033122327075*^9, 3.964293294582615*^9, 3.964365981507987*^9, 
   3.9643661720992823`*^9, 3.964380518889287*^9, 3.964533930762016*^9, 
   3.96469578019207*^9, 3.964711831896261*^9, 3.96478352469029*^9, 
   3.9647851592934647`*^9, 3.964785999294045*^9, 3.9647936063984632`*^9, 
   3.964795462123573*^9, 3.964796073328967*^9, {3.9672883584941883`*^9, 
   3.967288364874723*^9}, 3.967477507388336*^9},
 CellLabel->
  "Out[361]=",ExpressionUUID->"5b98804b-e2cf-460d-850a-4cf1557020c6"]
}, Open  ]],

Cell["\<\
This is an important step because, although the evolution operator can be \
obtained symbolically for very sparse Liouville operators, in most cases it \
must be calculated numerically. The transCE configuration variable, which \
describes this light\[Dash]matter interaction, is\
\>", "Text",
 CellChangeTimes->{{3.964032903620881*^9, 3.964032962626083*^9}, {
   3.964033030065509*^9, 3.964033114808071*^9}, 3.964868408551309*^9, 
   3.964868465051384*^9},ExpressionUUID->"095f1e58-e9a3-46a6-abeb-\
b0897cb7844e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"transCE", "=", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], ",", "1", ",", " ", 
       SubscriptBox["R", "1"], ",", " ", 
       SubscriptBox["\[CapitalDelta]", "1"], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], ",", "2", ",", " ", 
       SubscriptBox["R", "1"], ",", " ", 
       SubscriptBox["\[CapitalDelta]", "1"], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "3"}], "}"}], ",", "1", ",", " ", 
       SubscriptBox["R", "2"], ",", " ", 
       SubscriptBox["\[CapitalDelta]", "2"], ",", "\[Phi]"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "3"}], "}"}], ",", "2", ",", " ", 
       SubscriptBox["R", "2"], ",", " ", 
       SubscriptBox["\[CapitalDelta]", "2"], ",", "\[Phi]"}], "}"}]}], "}"}], 
   "/.", "parmvals"}]}]], "Input",
 CellChangeTimes->{{3.964033127578944*^9, 3.964033140238667*^9}},
 CellLabel->
  "In[362]:=",ExpressionUUID->"c8270d37-217f-46cb-b54b-58206d01b845"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}], ",", "1", ",", "12.`", ",", "1.`", ",", 
     "0"}], "}"}], ",", 
