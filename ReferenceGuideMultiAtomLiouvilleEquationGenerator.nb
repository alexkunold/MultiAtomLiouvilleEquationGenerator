Cell["\<\
Build the system of differential equations for the density matrix coefficients\
\>", "Text",
 CellChangeTimes->{{3.964795865536862*^9, 
  3.964795881832212*^9}},ExpressionUUID->"87a0d98d-3726-42d5-a3c8-\
bf08696daaec"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"rho", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[Rho]", "ii"], "[", "t", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"ii", ",", 
       RowBox[{"Length", "[", "h", "]"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eqs", "=", 
   RowBox[{"LiouvilleMasterEquation", "[", 
    RowBox[{"rho", ",", " ", "Li", ",", " ", "t"}], "]"}]}], ";"}]}], "Input",\

 CellChangeTimes->{{3.964795889352055*^9, 3.964795935906405*^9}, {
  3.964796095972372*^9, 3.964796108508734*^9}, {3.964797236522192*^9, 
  3.964797242028133*^9}},
 CellLabel->
  "In[402]:=",ExpressionUUID->"dcf533c4-9460-4843-beec-2d387f1151ad"],

Cell["\<\
We reset the consts variable to include the decay coefficient \[Gamma] and a \
drive with frequency \[CapitalDelta] that excites the transition from the \
ground state to the first excited state. We then evaluate the equations with \
these updated constants and set the initial conditions such that the transmon \
starts in the ground state. Finally, the initial conditions are combined with \
the equations.\
\>", "Text",
 CellChangeTimes->{{3.964796137419325*^9, 3.964796141399249*^9}, {
   3.964796184726709*^9, 3.964796330793775*^9}, 3.9647964310784063`*^9, {
   3.967284978967195*^9, 3.9672850029191647`*^9}, {3.974891922792007*^9, 
   3.974891927268854*^9}},ExpressionUUID->"ffe5ec29-5f9e-45ac-9a9e-\
e6213f2146dc"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"consts", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"\[HBar]", "->", "1.0"}], ",", 
    RowBox[{"\[Omega]", "->", "4.5"}], ",", 
    RowBox[{"\[Alpha]", "->", 
     RowBox[{"-", "0.30"}]}], ",", 
    RowBox[{"\[Lambda]", "->", 
     RowBox[{"0.1", " ", 
      RowBox[{"Sin", "[", 
       RowBox[{"\[CapitalDelta]", " ", "t"}], "]"}]}]}], ",", 
    RowBox[{"\[Gamma]", "->", "0.02"}]}], "}"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"eqsn", "=", 
   RowBox[{"eqs", "/.", "consts"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"inconds", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["\[Rho]", "ii"], "[", "0", "]"}], "==", 
      RowBox[{"KroneckerDelta", "[", 
       RowBox[{"ii", ",", "1"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"ii", ",", 
       RowBox[{"Length", "[", "h", "]"}]}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"difeqs", "=", 
   RowBox[{"Join", "[", 
    RowBox[{"eqsn", ",", "inconds"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{
  3.96479629129316*^9, {3.9647963341345*^9, 3.964796440814925*^9}, {
   3.964796642788137*^9, 3.964796648609537*^9}},
 CellLabel->
  "In[404]:=",ExpressionUUID->"31c4994b-89ba-48ce-97d1-1e11589042aa"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[HBar]", "\[Rule]", "1.`"}], ",", 
   RowBox[{"\[Omega]", "\[Rule]", "4.5`"}], ",", 
   RowBox[{"\[Alpha]", "\[Rule]", 
    RowBox[{"-", "0.3`"}]}], ",", 
   RowBox[{"\[Lambda]", "\[Rule]", 
    RowBox[{"0.1`", " ", 
     RowBox[{"Sin", "[", 
      RowBox[{"4.768156854956092`", " ", "t"}], "]"}]}]}], ",", 
   RowBox[{"\[Gamma]", "\[Rule]", "0.02`"}]}], "}"}]], "Output",
 CellChangeTimes->{3.9647964344254503`*^9, 3.964796743906622*^9, 
  3.964797250053857*^9, 3.967286095307628*^9, 3.9674775100518703`*^9},
