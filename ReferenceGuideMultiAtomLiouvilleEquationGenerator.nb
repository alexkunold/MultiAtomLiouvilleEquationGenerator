   3.971290539846529*^9}},ExpressionUUID->"c2ea2fbd-2a92-415e-a076-\
738604b26f6d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"nd", "=", "150"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Eta]0", "=", 
   RowBox[{"SparseArray", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}], "->", "1"}], "}"}], ",", "2"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rho0", "=", 
   RowBox[{"KroneckerProduct", "[", 
    RowBox[{
    "\[Eta]0", ",", "\[Eta]0", ",", "\[Eta]0", ",", "\[Eta]0", ",", 
     "\[Eta]0"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"incon", "=", 
   RowBox[{"InitialConditions", "[", 
    RowBox[{"h", ",", "rho", ",", "rho0", ",", "t"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Sigma]12", "=", 
   RowBox[{"SparseArray", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], "->", "1"}], "}"}], ",", "2"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Sigma]21", "=", 
   RowBox[{"SparseArray", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "1"}], "}"}], "->", "1"}], "}"}], ",", "2"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"corr1", "=", 
   RowBox[{"ExpectationValue", "[", 
    RowBox[{"h", ",", "rho", ",", 
     RowBox[{
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{
       "\[Sigma]12", ",", "one", ",", "one", ",", "one", ",", "\[Sigma]21"}], 
       "]"}], "+", 
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{
       "\[Sigma]21", ",", "one", ",", "one", ",", "one", ",", "\[Sigma]12"}], 
       "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"corr2", "=", 
   RowBox[{"ExpectationValue", "[", 
    RowBox[{"h", ",", "rho", ",", 
     RowBox[{
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{
       "one", ",", "one", ",", "one", ",", "\[Sigma]12", ",", "\[Sigma]21"}], 
       "]"}], "+", 
      RowBox[{"KroneckerProduct", "[", 
       RowBox[{
       "one", ",", "one", ",", "one", ",", "\[Sigma]21", ",", "\[Sigma]12"}], 
       "]"}]}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"listplot1", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"listplot2", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", 
  RowBox[{
   RowBox[{"Dynamic", "[", "jj", "]"}], ",", "\"\</\>\"", ",", "nd"}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"det", "=", 
      RowBox[{
       RowBox[{"-", "150"}], "+", 
       RowBox[{"300", 
        RowBox[{"jj", "/", "nd"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"parmvals", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         SubscriptBox["R", "1"], "->", "12.0"}], ",", 
        RowBox[{
         SubscriptBox["\[CapitalDelta]", "1"], "->", "det"}], ",", 
        RowBox[{"\[Phi]", "->", "1.1"}], ",", 
        RowBox[{
         SubscriptBox["\[Gamma]", "1"], "->", "1.5"}], ",", 
        RowBox[{
         SubscriptBox["\[Gamma]", 
          RowBox[{"1", ",", "2"}]], "->", "0.5"}], ",", 
        RowBox[{
         SubscriptBox["\[CapitalOmega]", "1"], "->", "0.7"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"eqsn", "=", 
      RowBox[{"eqs", "/.", "parmvals"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"diffeq", "=", 
      RowBox[{"Join", "[", 
       RowBox[{"eqsn", ",", "incon"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sol", "=", 
      RowBox[{
       RowBox[{"NDSolve", "[", 
        RowBox[{"diffeq", ",", 
         RowBox[{"Normal", "[", "rho", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "10"}], "}"}]}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"corr1n", "=", 
      RowBox[{
       RowBox[{"corr1", "/.", "sol"}], "/.", 
       RowBox[{"{", 
        RowBox[{"t", "->", "10"}], "}"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"corr2n", "=", 
      RowBox[{
       RowBox[{"corr2", "/.", "sol"}], "/.", 
       RowBox[{"{", 
        RowBox[{"t", "->", "10"}], "}"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"listplot1", ",", 
       RowBox[{"{", 
        RowBox[{"det", ",", "corr1n"}], "}"}]}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"listplot2", ",", 
       RowBox[{"{", 
        RowBox[{"det", ",", "corr2n"}], "}"}]}], "]"}], ";"}], 
    "\[IndentingNewLine]", ",", 
    RowBox[{"{", 
     RowBox[{"jj", ",", "0", ",", "nd"}], "}"}]}], "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"listplot1", ",", "listplot2"}], "}"}], ",", 
   RowBox[{"Axes", "->", "False"}], ",", 
   RowBox[{"Frame", "->", "True"}], ",", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Style", "[", 
       RowBox[{
       "\"\<\!\(\*SubscriptBox[\(\[CapitalDelta]\), \(1\)]\)\>\"", ",", 
        "20"}], "]"}], ",", 
      RowBox[{"Style", "[", 
       RowBox[{
       "\"\<\[LeftAngleBracket]\!\(TraditionalForm\`\*SubsuperscriptBox[\(\
