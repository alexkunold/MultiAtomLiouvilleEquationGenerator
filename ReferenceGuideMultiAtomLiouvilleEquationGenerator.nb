Cell[CellGroupData[{

Cell["HamDressed", "Subtitle",
 CellFrame->{{0, 0}, {0, 0.5}},
 CellFrameColor->GrayLevel[0.75],
 CellChangeTimes->{{3.954878763717317*^9, 3.9548787647156553`*^9}, 
   3.954935460414412*^9, {3.954940426468688*^9, 3.954940427257826*^9}, {
   3.95494452029814*^9, 3.954944521619375*^9}},
 CellTags->
  "HamDressed",ExpressionUUID->"2f14f56a-34d9-4bb7-8f20-7b76f0195d93"],

Cell[TextData[{
 "HamDressed[transCE, transdd, nl,  na] : transCE, trasdd \[Element] List;  \
na, nl \[Element] Ingeters\nReturns a SparseArray for the time-independent \
Hamiltonian in the dressed state base that accounts for light-matter and \
dipole-dipole interactions. The variable  transCE = {{{",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["ql", 
     RowBox[{"1", ",", "1"}]], ",", " ", 
    SubscriptBox["ql", 
     RowBox[{"1", ",", "2"}]]}], TraditionalForm]],ExpressionUUID->
  "a06faff1-d48c-4c36-b1d3-b6fee3b09d87"],
 "}, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Alpha]", "1"], ",", " ", 
    SubscriptBox["Rb", "1"], ",", " ", 
    SubscriptBox["\[CapitalDelta]", "1"], ",", " ", 
    SubscriptBox["\[Phi]", "1"]}], TraditionalForm]],ExpressionUUID->
  "ee72f5ae-737b-4585-b2e1-2af39331ef24"],
 "}, {{",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["ql", 
     RowBox[{"2", ",", "1"}]], ",", " ", 
    SubscriptBox["ql", 
     RowBox[{"2", ",", "2"}]]}], TraditionalForm]],ExpressionUUID->
  "d9d0a752-6bf5-44bb-b175-de6d329b13a0"],
 "}, ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     SubscriptBox["\[Alpha]", "2"], ",", " ", 
     SubscriptBox["Rb", "2"], ",", " ", 
     SubscriptBox["\[CapitalDelta]", "2"], ",", " ", 
     SubscriptBox["\[Phi]", "2"]}]}], TraditionalForm]],ExpressionUUID->
  "eefd9c0e-b975-4357-a34e-291ddef3e377"],
 "}, \[Ellipsis]} contains the parameters for the light-matter interaction of \
the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "k"], TraditionalForm]],ExpressionUUID->
  "197b5de1-5a1f-46e8-8ab7-83022fdd9994"],
 "-th atom. These parameters are: the two quantum levels excited by the laser \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "7aab866d-8fee-4aa2-a79f-201ef9cef39c"],
 "and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "b7b484a1-cc5b-4d71-b796-d8a63af1790a"],
 ", the Rabi parameter ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Rb", "k"], TraditionalForm]],ExpressionUUID->
  "1790cd2b-a040-44c6-b8d0-48e83346e5d4"],
 ", the detuning  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalDelta]", "k"], TraditionalForm]],ExpressionUUID->
  "5e6519be-3898-4349-bb77-18d68f234a40"],
 " and the phase ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Phi]", "k"], TraditionalForm]],ExpressionUUID->
  "f9b4f43a-c049-47d1-b15b-fe0505224dbf"],
 ".  The variable transdd={{",
 Cell[BoxData[
  FormBox[
   SubscriptBox["tr", 
    RowBox[{"1", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "154ad0b7-2fcf-4630-9382-9b32c6950412"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["tr", 
    RowBox[{"1", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "2c15c63d-bad3-467d-898c-77240157264c"],
 "}, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "1"], TraditionalForm]],ExpressionUUID->
  "8bcf9c34-8576-4409-bc09-0293c366cff3"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Beta]", "1"], TraditionalForm]],ExpressionUUID->
  "161c3ba3-2699-4de4-adfe-21d41a8b9340"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalOmega]", "1"], TraditionalForm]],ExpressionUUID->
  "bc22ef38-4a6f-4d51-bbd0-4eabdc0dc677"],
 " , ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Delta]", "1"], TraditionalForm]],ExpressionUUID->
  "b4a9ac7b-2fe2-4f23-9d7e-83cf3a36a207"],
 "}, {",
 Cell[BoxData[
  FormBox[
   SubscriptBox["tr", 
    RowBox[{"2", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "bf1a9a3a-189e-4f8f-b899-44f183ed323e"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["tr", 
    RowBox[{"2", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "43d80777-c34b-4159-9c27-6bdf3ead26e7"],
 "}, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "2"], TraditionalForm]],ExpressionUUID->
  "e9a2d37f-c671-442c-93fa-797dc4bb5b7f"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Beta]", "2"], TraditionalForm]],ExpressionUUID->
  "7e7ac656-c0a0-4079-8f3a-4f66e03aa557"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalOmega]", "2"], TraditionalForm]],ExpressionUUID->
  "dfa804f7-925a-4276-b2a2-e7e5e7aaaf0b"],
 " ,",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Delta]", "2"], TraditionalForm]],ExpressionUUID->
  "0ebe976a-294c-4a94-8486-9131a06b49f2"],
 "}, \[Ellipsis]} contains the parameters for the dipole-dipole interaction.  \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox["tr", 
    RowBox[{"k", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "012fefc5-66dc-4942-9328-b4c8b0a84b31"],
 "={",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "1", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "53edd332-465e-49ba-b1d2-7233bf70fce2"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "1", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "102f20a5-7a47-4963-86cc-c597c73db680"],
 "}, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["tr", 
    RowBox[{"k", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "cf6361e1-12d1-4863-bc78-c99574b60700"],
 "={",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "2", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "644c4265-e294-42b8-975d-4be822661235"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "2", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "8a2984a1-7486-4327-b850-2380cc994592"],
 "} are the two interacting dipole transitions corresponding to the two \
distinct ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "k"], TraditionalForm]],ExpressionUUID->
  "cce65602-3f99-4e37-8c3c-5dc21adcb8be"],
 "-th and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Beta]", "k"], TraditionalForm]],ExpressionUUID->
  "1f94482d-f4cd-4b37-b390-713b717a988e"],
 "-th atoms (",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "k"], TraditionalForm]],ExpressionUUID->
  "5fa9638d-a690-4804-b27e-dc7a17c8823c"],
 "\[NotEqual]",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    SubscriptBox["\[Beta]", "k"]}], TraditionalForm]],ExpressionUUID->
  "8603ba80-9510-4c89-94b7-9ca3ae366aa2"],
 "). The strength of the interaction is given by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalOmega]", "k"], ".", " "}], TraditionalForm]],
  ExpressionUUID->"71114a9f-ef94-48d7-ab4d-0dc146756f2b"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Delta]", "k"], TraditionalForm]],ExpressionUUID->
  "1950a810-ffa8-45b8-9305-79faf2473f1b"],
 " is the detuning between these two transitions. For HamDressed these \
parameters must be ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Delta]", "k"], TraditionalForm]],ExpressionUUID->
  "5351dfd4-73c6-4570-bbdd-d9dee5afa207"],
 "=0, otherwise the Hamiltonian becomes time-dependent. transCE and transdd \
might be empty lists in case there are no light-matter interactions or/and \
there are no dipole-dipole interactions."
}], "Text",
 CellChangeTimes->{{3.954878897778723*^9, 3.954878905190978*^9}, {
   3.954878942620962*^9, 3.954878970514427*^9}, {3.95487900917933*^9, 
   3.954879062735454*^9}, 3.954879098253928*^9, {3.954879241343924*^9, 
   3.954879412659048*^9}, {3.954879444408186*^9, 3.954879503745882*^9}, {
   3.954934336328712*^9, 3.954934465900693*^9}, {3.954935471017773*^9, 
   3.9549355378302193`*^9}, {3.954939599449833*^9, 3.954939664771409*^9}, {
   3.954939790669551*^9, 3.954939843279072*^9}, {3.954940461427494*^9, 
   3.954940479398761*^9}, {3.95494054112548*^9, 3.954940653505774*^9}, {
   3.954940687568445*^9, 3.9549407046799498`*^9}, {3.954940750010785*^9, 
   3.954940858938773*^9}, {3.954940904971528*^9, 3.954941356369125*^9}, {
   3.954941413010318*^9, 3.954941508190995*^9}, {3.954941568654795*^9, 
   3.954941812591436*^9}, {3.954941877666693*^9, 3.954942441695382*^9}, {
   3.954943150378008*^9, 3.95494319957655*^9}, {3.954943385539165*^9, 
   3.954943496240545*^9}, {3.954944019138126*^9, 3.954944043418404*^9}, {
   3.954944524708544*^9, 3.954944544385077*^9}, {3.954944582875909*^9, 
   3.954944605582519*^9}, {3.954945959818028*^9, 3.954945964066351*^9}, {
   3.954946012727757*^9, 3.9549460663994493`*^9}, 3.954954362827*^9, {
   3.95502377717341*^9, 
   3.955023778138803*^9}},ExpressionUUID->"7bc29469-0f11-4cf2-b20d-\
2c1b7125620d"],

