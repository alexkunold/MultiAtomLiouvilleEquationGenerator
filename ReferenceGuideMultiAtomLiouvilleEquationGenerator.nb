Cell[CellGroupData[{

Cell["RotatingFrameTrans", "Subtitle",
 CellFrame->{{0, 0}, {0, 0.5}},
 CellFrameColor->GrayLevel[0.75],
 CellChangeTimes->{{3.954878763717317*^9, 3.9548787647156553`*^9}, 
   3.954935460414412*^9, {3.954940426468688*^9, 3.954940427257826*^9}, {
   3.95494452029814*^9, 3.954944521619375*^9}, 3.954953213995235*^9, {
   3.954956615527276*^9, 3.954956617965029*^9}},
 CellTags->
  "RotatingFrameTrans",ExpressionUUID->"fa5046c3-93f9-4a12-8cc4-9b9f419bba07"],

Cell[TextData[{
 "RotatingFrameTrans[transCE, nl, na, t] : transCE \[Element] List, nl, na \
\[Element] Integers, t is a Mathematica symbol that represents the time \
variable\nRotatingFrameTrans[h, transCE, nl, na, t] : h \[Element] \
SparseArray, transCE \[Element] List, nl, na \[Element] Integers, t is a \
Mathematica symbol that represents the time variable\nIf the basis h is not \
provided, the function returns a List of two SparseArray objects:{",
 Cell[BoxData[
  FormBox[
   SubscriptBox["U", "R"], TraditionalForm]],ExpressionUUID->
  "d58d0adb-0520-4239-9d87-6cf10369ebc6"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["U", "R", "\[Dagger]"], TraditionalForm]],ExpressionUUID->
  "6ee0e0ba-6bf7-456a-9830-ad370ade7c3c"],
 "}, where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["U", "R"], TraditionalForm]],ExpressionUUID->
  "635bbf84-d9da-47fe-b67d-b36549fd105d"],
 " is the transformation that removes the time dependence from the \
time-dependent Hamiltonian Ham by switching to a rotating frame. The \
transformation ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["U", "R"], TraditionalForm]],ExpressionUUID->
  "9b21e9f5-499d-47cc-a161-0feb673893b6"],
 "  is composed of the n=Length[transCE] rotations, each arising  from  the \
parameters \[Mu] = {\[InvisibleComma]",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Mu]", "1"], TraditionalForm]],ExpressionUUID->
  "317a41c8-9f53-489c-a525-fd0724bd8f52"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Mu]", "2"], TraditionalForm]],ExpressionUUID->
  "bf70e9f0-6281-4be5-81fd-73a052f25685"],
 ", \[Ellipsis], ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Mu]", "n"], TraditionalForm]],ExpressionUUID->
  "52068850-cd84-4b80-b907-b98e5a821bae"],
 "} produced by RotatingFrameParms. Thus, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["U", "R"], TraditionalForm]],ExpressionUUID->
  "e7331300-ed69-4aa5-99ac-003a5d326f08"],
 "=",
 Cell[BoxData[
  FormBox[
   SubscriptBox["U", "1"], TraditionalForm]],ExpressionUUID->
  "13eb61ad-b02f-4837-859c-81d1d1569fdc"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["U", "2"], TraditionalForm]],ExpressionUUID->
  "a34d86db-5888-43d4-a44a-2d15f80ad5a0"],
 "\[Ellipsis]",
 Cell[BoxData[
  FormBox[
   SubscriptBox["U", "n"], TraditionalForm]],ExpressionUUID->
  "03a94e6d-1322-4ce5-a854-ba9159aa53b0"],
 " where each ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["U", "k"], TraditionalForm]],ExpressionUUID->
  "28f6b014-778c-4fb4-a8b4-cbdb387a524d"],
 "=MatrixExp[-\[ImaginaryI] t ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Mu]", "k"], TraditionalForm]],ExpressionUUID->
  "45c9a13e-d033-4e2e-ab99-d056855036bb"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Sigma]", 
    RowBox[{"z", ",", "k"}]], TraditionalForm]],ExpressionUUID->
  "17655de1-55cc-4e3b-a33f-489cfc466852"],
 "],  with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Mu]", "k"], TraditionalForm]],ExpressionUUID->
  "596eca22-8767-4f9e-b61a-d2a78cfe9f91"],
 "=\[Mu][[k]], and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Sigma]", 
    RowBox[{"z", ",", "k"}]], TraditionalForm]],ExpressionUUID->
  "d11f1a44-b917-4062-a24f-b58434320312"],
 " = Sigmaz[transCE[[k,1]], ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "k"], TraditionalForm]],ExpressionUUID->
  "2973cecb-db0c-4425-a5de-27d775e42042"],
 ", nl, na]. If the basis h is given, RotatingFramTrans returns a List of \
four SparseArray objects  {",
 Cell[BoxData[
  FormBox[
   SubscriptBox["U", "R"], TraditionalForm]],ExpressionUUID->
  "573fca96-ee33-4037-a239-8856ac8112cb"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["U", "R", "\[Dagger]"], TraditionalForm]],ExpressionUUID->
  "bf514791-fa0a-458c-a561-d03062cea708"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["L", "R"], TraditionalForm]],ExpressionUUID->
  "593d30fb-2996-4dae-a522-a0096a5535f1"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["L", "R", "\[Dagger]"], TraditionalForm]],ExpressionUUID->
  "7a77c88b-4f25-4d17-b9d0-ad27486e17d2"],
 "} where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["L", "R"], TraditionalForm]],ExpressionUUID->
  "760be069-cb46-4741-af4f-9ce6259ad1ba"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["L", "R", "\[Dagger]"], TraditionalForm]],ExpressionUUID->
  "5cc89016-4c67-434b-8227-97a26a956b0c"],
 " are the superoperators corresponding to the linear maps ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["L", "R"], TraditionalForm]],ExpressionUUID->
  "e2bba17d-54f6-4480-9b4d-7982eb079b00"],
 "\[Rho] =",
 Cell[BoxData[
  FormBox[
   SubscriptBox["U", "R"], TraditionalForm]],ExpressionUUID->
  "d9a4224b-fd5c-42df-ba45-b7d9e6775bf0"],
 "\[Rho]",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    SubsuperscriptBox["U", "R", "\[Dagger]"]}], TraditionalForm]],
  ExpressionUUID->"912dc10f-6c6d-494a-be39-d22bf7ae7cd3"],
 " and   ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["L", "R", "\[Dagger]"], TraditionalForm]],ExpressionUUID->
  "47a73050-324e-48bb-91e4-0ff8d49ee272"],
 "\[Rho] =",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["U", "R", "\[Dagger]"], TraditionalForm]],ExpressionUUID->
  "174f919f-204d-45df-a531-0c08f7d40910"],
 "\[Rho] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["U", "R"], TraditionalForm]],ExpressionUUID->
  "b11e60f9-213d-40b1-9f6b-c32d8710e1be"],
 ". These superoperators are useful for transforming other superoperators \
into and out of the rotating frame. The variable transCE is structured as \
transCE = {{{",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["ql", 
     RowBox[{"1", ",", "1"}]], ",", " ", 
    SubscriptBox["ql", 
     RowBox[{"1", ",", "2"}]]}], TraditionalForm]],ExpressionUUID->
  "6ed41d53-cc7f-4907-bf23-4b6b44d1ef69"],
 "}, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Alpha]", "1"], ",", " ", 
    SubscriptBox["Rb", "1"], ",", " ", 
    SubscriptBox["\[CapitalDelta]", "1"], ",", " ", 
    SubscriptBox["\[Phi]", "1"]}], TraditionalForm]],ExpressionUUID->
  "0c14651c-ec38-492d-8197-9be587f0cab3"],
 "}, {{",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["ql", 
     RowBox[{"2", ",", "1"}]], ",", " ", 
    SubscriptBox["ql", 
     RowBox[{"2", ",", "2"}]]}], TraditionalForm]],ExpressionUUID->
  "c3150e04-9df4-44f0-a7a3-24fad201b129"],
 "}, ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     SubscriptBox["\[Alpha]", "2"], ",", " ", 
     SubscriptBox["Rb", "2"], ",", " ", 
     SubscriptBox["\[CapitalDelta]", "2"], ",", " ", 
     SubscriptBox["\[Phi]", "2"]}]}], TraditionalForm]],ExpressionUUID->
  "dbe0acfa-9e90-46af-9199-777b2defc0f9"],
 "}, \[Ellipsis]}. This list contains the parameters for the light-matter \
interaction of the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "k"], TraditionalForm]],ExpressionUUID->
  "2aec3404-e04e-4ee0-959e-9a81c9104716"],
 "-th atom. These parameters are: the two quantum levels excited by the laser \
",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    SubscriptBox["ql", 
     RowBox[{"k", ",", "1"}]]}], TraditionalForm]],ExpressionUUID->
  "84b94d77-0189-4ff7-9e10-51e7f0e75262"],
 "and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["ql", 
     RowBox[{"k", ",", "2"}]], ")"}], TraditionalForm]],ExpressionUUID->
  "5378924f-bba1-4af1-b48e-1205b4e2d883"],
 ", the Rabi frequency ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Rb", "k"], TraditionalForm]],ExpressionUUID->
  "e9af01c8-726e-4582-9d13-558aabed8fa2"],
 ", the detuning  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalDelta]", "k"], TraditionalForm]],ExpressionUUID->
  "e8bd0942-5709-486b-80b0-cd766257d7a4"],
 " and the phase ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Phi]", "k"], TraditionalForm]],ExpressionUUID->
  "f7377f87-df07-4e44-8b15-9c02365b383c"],
 "."
}], "Text",
 CellChangeTimes->{{3.954878897778723*^9, 3.954878905190978*^9}, {
   3.954878942620962*^9, 3.954878970514427*^9}, {3.95487900917933*^9, 
