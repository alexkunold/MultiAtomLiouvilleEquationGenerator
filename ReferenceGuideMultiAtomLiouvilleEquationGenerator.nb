  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"dddf2037-a96b-49e8-bc12-7d3e82fc36a5"],
 " Ingeters\nReturns a SparseArray with the ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"Pauli", " ", 
     SubscriptBox["\[Sigma]", "z"]}], "-", "like"}], TraditionalForm]],
  ExpressionUUID->"3c7b5af5-f26a-427f-89aa-bdf88aa9d2ca"],
 " operator \[VerticalSeparator]",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["tr", "1"], "\[RightAngleBracket]"}], TraditionalForm]],
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"58ff7902-9f1a-4fd1-a753-d22f0fa3f226"],
 "\[LeftAngleBracket]",
 Cell[BoxData[
  FormBox[
   SubscriptBox["tr", "1"], TraditionalForm]],
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"a4989391-656f-4a37-8a5a-ce4ada5febe2"],
 "\[VerticalSeparator] - \[VerticalSeparator]",
