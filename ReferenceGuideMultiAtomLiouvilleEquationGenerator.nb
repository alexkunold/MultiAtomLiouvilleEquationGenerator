 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "1"], TraditionalForm]],ExpressionUUID->
  "ff7b2e9e-1193-4551-9a66-a4e0e42f8fd6"],
 ",  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Beta]", "1"], TraditionalForm]],ExpressionUUID->
  "6c80c0e2-9ec0-44c5-83c5-cb1c12be3797"],
 ",  ",
