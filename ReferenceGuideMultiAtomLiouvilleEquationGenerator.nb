     RowBox[{"{", 
      RowBox[{"1", ",", "6"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "6"}], "}"}], ",", "1", ",", "2", ",", 
     FractionBox[
      RowBox[{
       SubscriptBox["G", "1"], " ", 
       SubscriptBox["\[Gamma]", "1"]}], "2"], ",", "0"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "6"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "7"}], "}"}], ",", "1", ",", "2", ",", 
     FractionBox[
      RowBox[{
       SubscriptBox["G", "3"], " ", 
       SubscriptBox["\[Gamma]", "1"]}], 
      SqrtBox["6"]], ",", 
     RowBox[{
      SubscriptBox["\[CapitalDelta]\[Epsilon]", "1"], "-", 
      SubscriptBox["\[CapitalDelta]\[Epsilon]", "2"], "-", 
