Cell[CellGroupData[{

Cell["FarField", "Subtitle",
 CellFrame->{{0, 0}, {0, 0.5}},
 CellFrameColor->GrayLevel[0.75],
 CellChangeTimes->{{3.954878763717317*^9, 3.9548787647156553`*^9}, 
   3.954935460414412*^9, {3.954940426468688*^9, 3.954940427257826*^9}, {
   3.95494452029814*^9, 3.954944521619375*^9}, 3.954953213995235*^9, {
   3.954956615527276*^9, 3.954956617965029*^9}, {3.954959646489932*^9, 
   3.9549596518557587`*^9}, {3.955023187679504*^9, 3.955023188726391*^9}, {
   3.9550277873586273`*^9, 3.9550277894759407`*^9}, {3.955031354837632*^9, 
   3.955031357076072*^9}, {3.965317230065021*^9, 3.9653172318348494`*^9}},
 CellTags->"CleanUp",ExpressionUUID->"706fd419-5cb6-46cb-ab4c-b1e175a8c57b"],

Cell[TextData[{
 "FarField[transitions, levtrlist, countlist, atompos, nl, na, \[Kappa]] : \
transitions, levtrlist, countlist, atompos \[Element] Lists, nl, na \
\[Element] Integers,  \[Kappa] \[Element] Symbols.\nFarField[transitions, \
levtrlist, countlist, atompos, nl, na, \[Kappa], \[CapitalDelta]\[Kappa]] : \
transitions, levtrlist, countlist, atompos \[Element] Lists, nl, na \
\[Element] Integers,  \[Kappa], \[CapitalDelta]\[Kappa] \[Element] Symbols.\n\
Returns the far field operators a list of SparseArray objects of dimension \
Length[count-list] with the correlations of the far field given by ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["E", "l", "\[Dagger]"], TraditionalForm]],ExpressionUUID->
  "69242ca5-4890-44bc-ab2e-c30f56619399"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "l"], TraditionalForm]],ExpressionUUID->
  "adbbd10a-afb1-4a4c-83b0-7f3f14b16a88"],
 "where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["E", "l"], TraditionalForm]],ExpressionUUID->
  "cce101d8-80f6-4bc9-906d-9f64726ad002"],
 " = ",
 Cell[BoxData[
  FormBox[
   UnderoverscriptBox["\[Sum]", 
    RowBox[{"\[Alpha]", "=", "1"}], "na"], TraditionalForm]],ExpressionUUID->
  "d10bbeec-9758-41e1-8764-f3882de724f2"],
 Cell[BoxData[
  FormBox[
   UnderscriptBox["\[Sum]", "n"], TraditionalForm]],ExpressionUUID->
  "322e9069-2a9d-4769-b448-cfbc015a73e5"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox[
     RowBox[{
      SubscriptBox[
       StyleBox["p",
        FontWeight->"Bold"], "n"], "-", 
      RowBox[{
       SubscriptBox[
        OverscriptBox[
         StyleBox["R",
          FontWeight->"Bold"], "^"], "\[Alpha]"], 
       RowBox[{
        SubscriptBox[
         OverscriptBox[
          StyleBox["R",
           FontWeight->"Bold"], "^"], "\[Alpha]"], "\[CenterDot]", 
        SubscriptBox[
         StyleBox["p",
          FontWeight->"Bold"], "n"]}]}]}], 
     SubscriptBox["R", "\[Alpha]"]], 
    SubsuperscriptBox["k", "n", "2"], 
    RowBox[{"Exp", "[", 
     RowBox[{"-", 
      RowBox[{
       SubscriptBox["ik", "n"], "(", 
       RowBox[{
        SubscriptBox["R", "\[Alpha]"], "-", "R"}], ")"}]}], "]"}], 
    SubscriptBox["\[Sigma]", 
     RowBox[{"n", ",", "\[Alpha]"}]]}], TraditionalForm]],ExpressionUUID->
  "e9b575de-0f16-4412-9027-0dfced8a44e3"],
 " is the far field operator in arbitrary units.  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["p",
     FontWeight->"Bold"], "n"], TraditionalForm]],ExpressionUUID->
  "8b49e3d2-55be-4512-ad40-be337c9a730c"],
 " is the dipole matrix element of the ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "5ecb4719-2989-47c6-a0c6-47a00d37917b"],
 "-th transition, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     StyleBox["R",
      FontWeight->"Bold"], "\[Alpha]"], "=", 
    RowBox[{
     StyleBox["R",
      FontWeight->"Bold"], "-", 
     SubscriptBox[
      StyleBox["r",
       FontWeight->"Bold"], "\[Alpha]"]}]}], TraditionalForm]],ExpressionUUID->
  "0519a961-bc25-4541-9492-4f9a806c6957"],
 "= {",
 Cell[BoxData[
  FormBox[
   SubscriptBox["X", "\[Alpha]"], TraditionalForm]],ExpressionUUID->
  "ea5574a2-b7af-45f6-8ab4-851b676007e8"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Y", "\[Alpha]"], TraditionalForm]],ExpressionUUID->
  "6263eda5-cc97-42c7-8296-622f5f777ed9"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Z", "\[Alpha]"], TraditionalForm]],ExpressionUUID->
  "0ed77629-5c94-4d0c-93bb-b5cab7c4b4d5"],
 "}  is the vector from the \[Alpha]-th atom located at ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["r",
     FontWeight->"Bold"], "\[Alpha]"], TraditionalForm]],ExpressionUUID->
  "7fe32a41-507b-4a74-bf36-b054dbd495fc"],
 " = {",
 Cell[BoxData[
  FormBox[
   SubscriptBox["x", "\[Alpha]"], TraditionalForm]],ExpressionUUID->
  "8d472c79-b03b-4930-8eaf-38c297c0aa73"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["y", "\[Alpha]"], TraditionalForm]],ExpressionUUID->
  "ed152d6f-1c88-4728-9fa6-c6303f56e04b"],
 " ,",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    SubscriptBox["z", "\[Alpha]"]}], TraditionalForm]],ExpressionUUID->
  "8e5a4610-ff6b-4a94-af17-65514079b6ee"],
 "} to the detector at position ",
 StyleBox["R",
  FontWeight->"Bold"],
 " = {X, Y , Z}. The magnitude of the transition\[CloseCurlyQuote]s wave \
vector is  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", "n"], TraditionalForm]],ExpressionUUID->
  "97f4f602-09e1-46e9-a0fb-938d1002efd9"],
 ". The SparseArray object ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Sigma]", 
    RowBox[{"n", ",", "\[Alpha]"}]], TraditionalForm]],ExpressionUUID->
  "2f52c3dd-5409-4f02-bc29-141c22bcb0bb"],
 " = \[VerticalSeparator]",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox[
     RowBox[{
      SubscriptBox["n", "1"], "\[RightAngleBracket]"}], 
     RowBox[{"\[Alpha]", " ", "\[Alpha]"}]], 
    RowBox[{"\[LeftAngleBracket]", 
     SubscriptBox["n", "2"]}]}], TraditionalForm]],ExpressionUUID->
  "7250a7a5-a3a7-48cc-9950-5e16f568efa8"],
 "\[VerticalSeparator] is the transition operator associated with the ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "8fd19e48-706e-454d-addc-4a38373b721c"],
 "-th transition between the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["n", "1"], TraditionalForm]],ExpressionUUID->
  "508d3c03-edee-4f05-a686-37d6d126bc78"],
 "and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["n", "2"], TraditionalForm]],ExpressionUUID->
  "e55e810c-91e7-4e2c-86f8-50a0b2873f2a"],
 " orbitals of atom \[Alpha] as given by Sigma. The configuration variable \
transitions is a two-level nested list containing detailed information about \
the available transitions. The innermost list is of the form {q, {",
 Cell[BoxData[
  FormBox[
   SubscriptBox["n", "1"], TraditionalForm]],ExpressionUUID->
  "2e712c57-2afc-4afe-8850-3c3a33675ab5"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["n", "2"], TraditionalForm]],ExpressionUUID->
  "0fb728be-353b-4ae3-8e77-18a85241794c"],
 "}, \[CapitalDelta]m, \[LeftAngleBracket]",
 StyleBox["p",
  FontWeight->"Bold"],
 "\[RightAngleBracket]} where q indexes the group of transitions, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["n", "1"], TraditionalForm]],ExpressionUUID->
  "ce59d19f-c9bf-46f2-94c9-a865319323bb"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["n", "2"], TraditionalForm]],ExpressionUUID->
  "b5449c2e-ff1a-41aa-ab1a-e6cefadd2a4d"],
 " are the orbitals\[CloseCurlyQuote] tags, \[CapitalDelta]m is the change in \
the magnetic quantum number and \[LeftAngleBracket]",
 StyleBox["p",
  FontWeight->"Bold"],
 "\[RightAngleBracket] represents the angular part of the dipole moment \
matrix element. This variable might be obtained as part of the output of \
TransitionLists.  The configuration variable levtrlist  = {{",
 Cell[BoxData[
  FormBox[
   SubscriptBox["q", "1"], TraditionalForm]],ExpressionUUID->
  "1df8bb5c-0aee-4548-aed6-683189ba18db"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["q", "2"], TraditionalForm]],ExpressionUUID->
  "4801d2b7-f08c-42e4-a594-214863c69786"],
 "}, ...} is a list containing the transitions where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["q", "1"], TraditionalForm]],ExpressionUUID->
  "5cc53219-89e0-4bf6-b6ad-0c61e4b78395"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["q", "2"], TraditionalForm]],ExpressionUUID->
  "7c407c9c-14ba-445b-b506-9dba4e490675"],
 ", ... index the groups of quantum levels characterized by the quantum \
numbers {",
 Cell[BoxData[
  FormBox[
   SubscriptBox["j", "1"], TraditionalForm]],ExpressionUUID->
  "3ca072a3-193c-4cd1-b33f-d34dd5c5a4f9"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["f", "1"], TraditionalForm]],ExpressionUUID->
  "b2bfc02a-a3d6-48e3-8792-b433ac5aaf7e"],
 "}, {",
 Cell[BoxData[
  FormBox[
   SubscriptBox["j", "2"], TraditionalForm]],ExpressionUUID->
  "07eb1883-b070-4c68-b237-5f49220f2c3a"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["f", "2"], TraditionalForm]],ExpressionUUID->
  "cd3ec9a7-3c9c-4660-a14a-fdd254a8fa9c"],
 "), ... , respectively. This is also a configuration variable for \
TransitionLists. The configuration variable countlist has the structure {{{",
 Cell[BoxData[
  FormBox[
   SubscriptBox["q", "1"], TraditionalForm]],ExpressionUUID->
  "e777ac6a-0b6d-4dd6-896d-3ac5ca16bd73"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["q", "2"], TraditionalForm]],ExpressionUUID->
  "09fcf17b-66df-4e5d-a933-9c6be42c1d6f"],
 "}, ",
 StyleBox["e",
  FontWeight->"Bold"],
 ", ",
 StyleBox["R",
  FontWeight->"Bold"],
 " }, ... } where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["q", "1"], TraditionalForm]],ExpressionUUID->
  "055c3684-de61-4cfb-ad68-e71fb5cb5bbf"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["q", "2"], TraditionalForm]],ExpressionUUID->
  "0220df6b-d8ee-4196-9484-14873d7936e6"],
 " index the groups of quantum levels of the ",
 Cell[BoxData[
  FormBox["n", TraditionalForm]],ExpressionUUID->
  "2179b63f-bda6-4e71-b95a-de5d37fa9f07"],
 "-th transition, ",
 StyleBox["e",
  FontWeight->"Bold"],
 " = {",
 Cell[BoxData[
  FormBox[
   SubscriptBox["e", "1"], TraditionalForm]],ExpressionUUID->
  "d7bb8532-41e6-4855-88fd-f8441fe9fee1"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["e", "2"], TraditionalForm]],ExpressionUUID->
  "f8770df2-84ed-4817-8642-28fd753a1bb4"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["e", "3"], TraditionalForm]],ExpressionUUID->
  "81dd2678-d5e1-422d-b92d-33ac994723d9"],
 "} is the polarization unit vector measured by the detector positioned at ",
 StyleBox["R ",
  FontWeight->"Bold"],
 "= {X, Y , Z}. The Symbol \[Kappa] is used to obtain the magnitude of the \
wave vector  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["k", "n"], TraditionalForm]],ExpressionUUID->
  "30cbda89-a1e8-4558-84f5-d486daaeab03"],
 "in the following way. If the Symbol \[CapitalDelta]\[Kappa] is not provided \
as an argument of FarField, it is assumed  that the orbitals with the same \
quantum number f but different quantum number ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]],ExpressionUUID->
  "dab26dc1-f6d1-4253-8c50-6e8591554adf"],
 " are degenerate and therefore ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["k", "n"], "=", 
    SubscriptBox["\[Kappa]", "n"]}], TraditionalForm]],ExpressionUUID->
  "55abcdbd-8168-4592-80b2-1ae4ce48b53e"],
 ". If \[CapitalDelta]\[Kappa] is provided as an argument of FarField, it is \
assumed that the degeneracy between the orbitals with different magnetic \
quantum  numbers ",
 Cell[BoxData[
  FormBox["m", TraditionalForm]],ExpressionUUID->
  "7618115e-8cb9-420d-b367-f7416b744f2e"],
 " is lifted (for example, due to Zeeman splitting). In the latter case ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["k", "n"], "=", 
    SubscriptBox["\[Kappa]", "n"]}], TraditionalForm]],ExpressionUUID->
  "49172888-de9c-4178-8739-09989be3f6bf"],
 "- ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalDelta]\[Kappa]", 
     SubscriptBox["n", "1"]], "+", 
    SubscriptBox["\[CapitalDelta]\[Kappa]", 
     SubscriptBox["n", "2"]]}], TraditionalForm]],ExpressionUUID->
  "fc5bb0f1-be43-4606-b7f5-2959ebf74331"],
 "."
}], "Text",
 InitializationCell->True,
