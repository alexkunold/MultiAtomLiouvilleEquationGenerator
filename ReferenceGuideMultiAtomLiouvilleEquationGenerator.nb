Cell["AdjointMasterEquation", "Subtitle",
 CellFrame->{{0, 0}, {0, 0.5}},
 CellFrameColor->GrayLevel[0.75],
 CellChangeTimes->{{3.954878763717317*^9, 3.9548787647156553`*^9}, 
   3.954935460414412*^9, {3.954940426468688*^9, 3.954940427257826*^9}, {
   3.95494452029814*^9, 3.954944521619375*^9}, 3.954953213995235*^9, {
   3.954956615527276*^9, 3.954956617965029*^9}, {3.954959646489932*^9, 
   3.9549596518557587`*^9}, {3.955023187679504*^9, 3.955023188726391*^9}, {
   3.9550277873586273`*^9, 3.9550277894759407`*^9}, {3.955034894987132*^9, 
   3.955034896619713*^9}, {3.95504997174227*^9, 3.955049975311408*^9}, {
   3.963764290116918*^9, 3.963764291509638*^9}, {3.96394930541198*^9, 
   3.963949307512555*^9}},
 CellTags->
  "AdjointMasterEquation",ExpressionUUID->"0a57b3bf-f183-4c9b-8b50-\
ad971d433b75"],

Cell[TextData[{
 "AdjointMasterEquation[h, q, q0, transCE, transdd, transLi, nl, na, t] : h, \
q, q0 \[Element] SparseArray, transCE, trasdd, transLi \[Element] List;  na, \
nl \[Element] Ingeters, t is a Mathematica symbol that represents the time \
variable\nReturns a List of dimension Length[h]=Length[q] that contains the \
Liouville differential equations that correspond to the adjoint Liouville \
superoperator including both the Hamiltonian and  Lindbladian parts generated \
using LiouvilleCommutator and LiouvilleLindbladianDagger. \
AdjointMasterEquation is a wrapper of LiouvilleAdjointMasterEquation. h is \
the SparseArray that contains the matrix basis generated with MultiAtomBasis. \
The variable q should be a list of the density matrix coefficients, i.e., q = \
Tr[h \[Rho](t)]. In the case of the adjoint master equation, these \
coefficients can be interpreted as the basis matrices in the Heisenberg \
picture. The initial conditions are set through q0=\[Rho](0). The \
configuration variable  transCE = {{{",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["ql", 
     RowBox[{"1", ",", "1"}]], ",", " ", 
    SubscriptBox["ql", 
     RowBox[{"1", ",", "2"}]]}], TraditionalForm]],ExpressionUUID->
  "1e4cdad3-1716-499a-91b5-ead770e47b86"],
 "}, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Alpha]", "1"], ",", " ", 
    SubscriptBox["Rb", "1"], ",", " ", 
    SubscriptBox["\[CapitalDelta]", "1"], ",", " ", 
    SubscriptBox["\[Phi]", "1"]}], TraditionalForm]],ExpressionUUID->
  "d48cb7e9-30bd-4945-bf45-0aaaa444e63c"],
 "}, {{",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["ql", 
     RowBox[{"2", ",", "1"}]], ",", " ", 
    SubscriptBox["ql", 
     RowBox[{"2", ",", "2"}]]}], TraditionalForm]],ExpressionUUID->
  "94000221-1f94-40da-a181-a205feaf3909"],
 "}, ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     SubscriptBox["\[Alpha]", "2"], ",", " ", 
     SubscriptBox["Rb", "2"], ",", " ", 
     SubscriptBox["\[CapitalDelta]", "2"], ",", " ", 
     SubscriptBox["\[Phi]", "2"]}]}], TraditionalForm]],ExpressionUUID->
  "14ed5db7-6436-4779-bad4-34ad15af3cf8"],
 "}, \[Ellipsis]} contains the parameters for the light-matter interaction of \
the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "k"], TraditionalForm]],ExpressionUUID->
  "d84d6164-2def-45cc-9623-2b996db5a9b7"],
 "-th atom. These parameters are: the two quantum levels excited by the laser \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "b929375d-1ba4-4ad6-b885-8ef863428a59"],
 "and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "0e6c7167-01a0-4979-8433-a03693105069"],
 ", the Rabi parameter ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Rb", "k"], TraditionalForm]],ExpressionUUID->
  "d763c205-adb5-424a-ae81-189757acb24f"],
 ", the detuning  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalDelta]", "k"], TraditionalForm]],ExpressionUUID->
  "61111956-ca3d-413f-a1bc-4cd410e0e32c"],
 " and the phase ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Phi]", "k"], TraditionalForm]],ExpressionUUID->
  "1f7d2bca-48af-4774-ae9e-c83f981b4f88"],
 ".  The configuration variable transdd={{",
 Cell[BoxData[
  FormBox[
   SubscriptBox["tr", 
    RowBox[{"1", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "2b69ef1b-e0d5-4c01-836c-137de15060d4"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["tr", 
    RowBox[{"1", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "0d2d2fdc-7de1-467f-9008-78a23c1de0e4"],
 "}, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "1"], TraditionalForm]],ExpressionUUID->
  "05367721-cbbb-46a0-99ac-b017f81be551"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Beta]", "1"], TraditionalForm]],ExpressionUUID->
  "d17d3063-7eef-40e3-b77a-394ace424339"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalOmega]", "1"], TraditionalForm]],ExpressionUUID->
  "ce42ed3d-a5a1-4d62-80d9-673eb782f3bd"],
 " , ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Delta]", "1"], TraditionalForm]],ExpressionUUID->
  "159e3068-264d-4806-a3a1-21d4d7fceca9"],
 "}, {",
 Cell[BoxData[
  FormBox[
   SubscriptBox["tr", 
    RowBox[{"2", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "3dc3400d-50d1-4129-b54d-61db4def58de"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["tr", 
    RowBox[{"2", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "eaa5940b-b857-42ba-b12c-e95f1b91e576"],
 "}, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "2"], TraditionalForm]],ExpressionUUID->
  "2de8798c-e2e5-4af4-a53a-870dcd2b7105"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Beta]", "2"], TraditionalForm]],ExpressionUUID->
  "3d67170e-531a-430b-8220-310b81518ce3"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalOmega]", "2"], TraditionalForm]],ExpressionUUID->
  "26fbee9b-4a21-4506-85e0-447df7ef55f4"],
