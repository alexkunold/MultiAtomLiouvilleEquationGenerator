Cell[CellGroupData[{

Cell["Example", "Subsubsection",
 CellChangeTimes->{{3.965470474805601*^9, 
  3.965470475744413*^9}},ExpressionUUID->"3528644f-f35a-4a13-9c66-\
45351abb5447"],

Cell["\<\
In order to distinguish the dynamics of all the populations, we repeat the \
previous example but  shift the polarization vectors slightly\
\>", "Text",
 CellChangeTimes->{{3.965470422063446*^9, 3.965470508200406*^9}, {
  3.9730146783290997`*^9, 3.973014681669731*^9}, {3.9748913965284767`*^9, 
  3.974891411005917*^9}},ExpressionUUID->"ce2d4d27-4c36-4f3e-935e-\
99e8982e90b6"],

Cell["Load MultiAtomLiouvilleEquationGenerator", "Text",
 CellChangeTimes->{{3.964876966723848*^9, 
  3.964876976051291*^9}},ExpressionUUID->"499b65c4-e40e-4b7b-9d59-\
8a3512f4b655"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "SetDirectory", "[", "PathToMultiAtomLiouvilleEquationGenerator", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Needs", "[", "\"\<MultiAtomLiouvilleEquationGenerator`\>\"", 
  "]"}]}], "Input",
 CellChangeTimes->{3.965317098837603*^9},
 CellLabel->
  "In[335]:=",ExpressionUUID->"3acfb2f7-e4bf-4aa8-9f3e-1ad2008400f9"],

Cell["\<\
We set the parameters and build the master equation (see previous example)\
\>", "Text",
 CellChangeTimes->{{3.965470580160927*^9, 
  3.965470628911626*^9}},ExpressionUUID->"d75582db-cb87-45d2-b076-\
53ec8ab94fb9"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"na", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Jlist", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     FractionBox["1", "2"], ",", 
     FractionBox["3", "2"], ",", 
     FractionBox["3", "2"]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Flist", "=", 
   RowBox[{"{", 
    RowBox[{"2", ",", "3", ",", "3"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mFlist", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Range", "[", 
      RowBox[{
       RowBox[{"-", "2"}], ",", "2"}], "]"}], ",", 
     RowBox[{"Range", "[", 
      RowBox[{
       RowBox[{"-", "3"}], ",", "3"}], "]"}], ",", " ", 
     RowBox[{"Range", "[", 
      RowBox[{
       RowBox[{"-", "3"}], ",", "3"}], "]"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"levtrlist", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "2"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"2", ",", "3"}], "}"}]}], "}"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Theta]", "=", "0.5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lasertrlist", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           FractionBox["1", 
            SqrtBox["2"]], ",", 
           RowBox[{"-", 
            FractionBox["\[ImaginaryI]", 
             SqrtBox["2"]]}], ",", "0"}], "}"}], 
         RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "+", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           FractionBox["1", 
            SqrtBox["2"]], ",", 
           FractionBox["\[ImaginaryI]", 
            SqrtBox["2"]], ",", "0"}], "}"}], 
         RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "3"}], "}"}], ",", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           FractionBox["1", 
            SqrtBox["2"]], ",", 
           RowBox[{"-", 
            FractionBox["\[ImaginaryI]", 
             SqrtBox["2"]]}], ",", "0"}], "}"}], 
         RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "+", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           FractionBox["1", 
            SqrtBox["2"]], ",", 
           FractionBox["\[ImaginaryI]", 
            SqrtBox["2"]], ",", "0"}], "}"}], 
         RowBox[{"Sin", "[", "\[Theta]", "]"}]}]}]}], "}"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "levels", ",", " ", "transitions", ",", " ", "transdd", ",", " ", 
      "transLi", ",", " ", "transCE"}], "}"}], "=", 
    RowBox[{"TransitionLists", "[", 
     RowBox[{
      FractionBox["3", "2"], ",", "Jlist", ",", "Flist", ",", "mFlist", ",", 
      "levtrlist", ",", "lasertrlist", ",", "na", ",", " ", "R", ",", " ", 
      "\[Delta]", ",", "\[Phi]", ",", " ", "\[Gamma]", ",", " ", "F", ",", 
      " ", "G"}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"h", "=", 
   RowBox[{"MultiAtomBasis", "[", 
    RowBox[{"nl", ",", "na"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n", "=", 
   RowBox[{"Length", "[", "h", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rho", "=", 
   RowBox[{"SparseArray", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"ii", "->", 
       RowBox[{
        RowBox[{"Subscript", "[", 
         RowBox[{"\[Rho]", ",", "ii"}], "]"}], "[", "t", "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"ii", ",", "n"}], "}"}]}], "]"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rho0", "=", 
    RowBox[{"SparseArray", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"ii", ",", "ii"}], "}"}], "->", 
         RowBox[{"1", "/", "5"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"ii", ",", "5"}], "}"}]}], "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"nl", ",", "nl"}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"diffeqs", "=", 
   RowBox[{"MasterEquation", "[", 
    RowBox[{
    "h", ",", "rho", ",", "rho0", ",", "transCE", ",", "transdd", ",", 
     "transLi", ",", "nl", ",", "na", ",", "t"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"consts", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[Gamma]", "1"], "->", "0.07573"}], ",", 
     RowBox[{
      SubscriptBox["\[Gamma]", "2"], "->", "0.001343"}], ",", 
     RowBox[{
      SubscriptBox["R", "1"], "->", "0.1"}], ",", 
     RowBox[{
      SubscriptBox["R", "2"], "->", "0.1"}], ",", 
     RowBox[{
      SubscriptBox["\[Delta]", "1"], "->", "0.0"}], ",", 
     RowBox[{
      SubscriptBox["\[Delta]", "2"], "->", "0.0"}], ",", 
     RowBox[{
      SubscriptBox["\[Phi]", 
       RowBox[{"1", ",", "1"}]], "->", "0"}], ",", 
     RowBox[{
      SubscriptBox["\[Phi]", 
       RowBox[{"2", ",", "1"}]], "->", "0"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"diffeqsn", "=", 
    RowBox[{"diffeqs", "/.", "consts"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tmax", "=", "100000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sol", "=", 
   RowBox[{
    RowBox[{"NDSolve", "[", 
     RowBox[{"diffeqsn", ",", 
      RowBox[{"Normal", "[", "rho", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "tmax"}], "}"}]}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.965470750919216*^9, 3.965470766844946*^9}, {
  3.9654709434375753`*^9, 3.965470949465244*^9}, {3.9654709958145533`*^9, 
  3.965470997485064*^9}},
 CellLabel->"In[66]:=",ExpressionUUID->"047b2291-59c5-44c8-ae78-b3447d48371c"],

Cell[TextData[{
 "When plotting the populations of 5 ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", 
    RowBox[{"1", "/", "2"}]], TraditionalForm]],ExpressionUUID->
  "fd0edd33-1c4a-4820-99cd-98de304b476b"],
 ", F=2; 5 ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", 
    RowBox[{"3", "/", "2"}]], TraditionalForm]],ExpressionUUID->
  "7eee0867-19c2-41e6-b70d-6f4e079740a0"],
 ", F=3 and 5 ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["D", 
    RowBox[{"3", "/", "2"}]], TraditionalForm]],ExpressionUUID->
  "789d1e4d-a9fe-43b2-b547-8c088815bf7f"],
 "F=3, we confirm once again that the optical pumping conditions are \
fulfilled. However, orbitals that were unpopulated in the previous example \
now acquire a small population"
}], "Text",
 CellChangeTimes->{{3.965469961806018*^9, 3.965470024716945*^9}, {
  3.965470062782212*^9, 3.9654700922386513`*^9}, {3.965470343308342*^9, 
  3.9654703798309717`*^9}, {3.9654706684406853`*^9, 3.96547072181415*^9}, {
  3.965471065036703*^9, 3.9654711316790524`*^9}, {3.974891425818224*^9, 
  3.9748914270752773`*^9}},ExpressionUUID->"aed4ffe2-0b27-4155-8a4b-\
643386a6349f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"groups", "=", 
   RowBox[{"{", 
    RowBox[{
    "\"\<\!\(\*SuperscriptBox[\(5\), \(2\)]\)\!\(\*SuperscriptBox[\(S\), \
\(1/2\)]\) F=2\>\"", ",", 
     "\"\<5 \!\(TraditionalForm\`\*SubscriptBox[\(P\), \(3/2\)]\)F=3\>\"", 
     ",", " ", 
     "\"\<5 \!\(TraditionalForm\`\*SubscriptBox[\(D\), \(3/2\)]\)F=3\>\""}], 
    "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pl", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"con", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"con", "+=", "1"}], ";", "\[IndentingNewLine]", 
     RowBox[{"pops", "=", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Subscript", "[", 
           RowBox[{"\[Rho]", ",", "ii"}], "]"}], "[", "t", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"ii", ",", 
           RowBox[{"lev", "[", 
            RowBox[{"[", 
             RowBox[{";;", ",", "1"}], "]"}], "]"}]}], "}"}]}], "]"}], "/.", 
       "sol"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"pl", ",", 
       RowBox[{"Plot", "[", 
        RowBox[{"pops", ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "tmax"}], "}"}], ",", 
         RowBox[{"PlotRange", "->", "All"}], ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"Axes", "->", "False"}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{"\"\<t (ns)\>\"", ",", "20"}], "]"}], ",", 
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"groups", "[", 
               RowBox[{"[", "con", "]"}], "]"}], ",", "20"}], "]"}]}], 
           "}"}]}], ",", 
         RowBox[{"PlotLabels", "->", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"StringJoin", "[", 
             RowBox[{"\"\<m=\>\"", ",", 
              RowBox[{"ToString", "[", "m", "]"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"m", ",", 
              RowBox[{"lev", "[", 
               RowBox[{"[", 
                RowBox[{";;", ",", "2"}], "]"}], "]"}]}], "}"}]}], "]"}]}]}], 
        "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", ",", 
    RowBox[{"{", 
     RowBox[{"lev", ",", "levels"}], "}"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"GraphicsColumn", "[", "pl", "]"}]}], "Input",
 CellChangeTimes->{{3.965415750988456*^9, 3.96541583540367*^9}, {
   3.9654158808654213`*^9, 3.9654160230487328`*^9}, {3.965416088521467*^9, 
   3.965416211263298*^9}, {3.965416290769897*^9, 3.965416322389675*^9}, {
   3.965416489547517*^9, 3.965416511361714*^9}, {3.96541663263232*^9, 
