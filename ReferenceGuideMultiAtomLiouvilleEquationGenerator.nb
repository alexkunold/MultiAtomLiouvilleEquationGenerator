Cell[CellGroupData[{

Cell["Superradiance", "Subtitle",
 CellFrame->{{0, 0}, {0, 0.5}},
 CellFrameColor->GrayLevel[0.75],
 CellChangeTimes->{{3.954878763717317*^9, 3.9548787647156553`*^9}, 
   3.954935460414412*^9, {3.954940426468688*^9, 3.954940427257826*^9}, {
   3.95494452029814*^9, 3.954944521619375*^9}, 3.954953213995235*^9, {
   3.954956615527276*^9, 3.954956617965029*^9}, {3.954959646489932*^9, 
   3.9549596518557587`*^9}, {3.955023187679504*^9, 3.955023188726391*^9}, {
   3.9550277873586273`*^9, 3.9550277894759407`*^9}, {3.955034894987132*^9, 
   3.955034896619713*^9}, {3.95504997174227*^9, 3.955049975311408*^9}, {
   3.963764290116918*^9, 3.963764291509638*^9}, {3.96403184486744*^9, 
   3.964031850967843*^9}, {3.964375236714116*^9, 3.964375279615838*^9}, 
   3.964375681733578*^9, 3.965225142672127*^9, 3.965225379506308*^9, {
   3.968253900137935*^9, 3.968253903675173*^9}},
 CellTags->
  "Superradiance",ExpressionUUID->"b142af42-8907-442a-a985-777c3109b7ed"],

Cell["\<\
We illustrate the phenomenon of superradiance by comparing the spontaneous \
emission of a single atom with that of five coupled atoms. Superradiance is a \
collective quantum effect where a group of emitters radiate light much more \
intensely and faster than they would if each one emitted independently.\
\>", "Text",
 CellChangeTimes->{{3.9653159099304247`*^9, 3.965316056533812*^9}, {
   3.965316160628994*^9, 3.965316161538636*^9}, 3.965316224460072*^9, {
   3.9682539155933647`*^9, 3.968253959990611*^9}, {3.968253996313877*^9, 
   3.968254000228367*^9}, {3.968261894287912*^9, 
   3.968261902017795*^9}},ExpressionUUID->"5bc6d7e3-233d-4515-a2f8-\
fbfd421655ee"],

Cell[TextData[Cell[BoxData[
 ButtonBox["\<\"Content\"\>",
  Appearance->Automatic,
  BaseStyle->{FontColor -> RGBColor[
      Rational[1, 3], 
      Rational[1, 3], 1]},
  ButtonFunction:>NotebookLocate["Content"],
  Evaluator->Automatic,
  Method->"Preemptive"]], "Output",
 CellChangeTimes->{
  3.967476292796187*^9},ExpressionUUID->"d47e2f3f-09a2-4b6e-b7fc-\
26bde6c3e009"]], "Text",
 CellChangeTimes->{
  3.967476672909765*^9},ExpressionUUID->"fdd51bbc-3480-451d-a533-\
6af11f984eda"],

Cell[CellGroupData[{

Cell["Example", "Subsubsection",
 CellChangeTimes->{{3.965315919943549*^9, 
  3.965315920830645*^9}},ExpressionUUID->"95449e40-f094-4073-a4cc-\
27c138027fbb"],

Cell["Load MultiAtomLiouvilleEquationGenerator", "Text",
 CellChangeTimes->{{3.964876966723848*^9, 
  3.964876976051291*^9}},ExpressionUUID->"0800b973-cdbb-424e-8e4a-\
01c15d501399"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "SetDirectory", "[", "PathToMultiAtomLiouvilleEquationGenerator", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Needs", "[", "\"\<MultiAtomLiouvilleEquationGenerator`\>\"", 
  "]"}]}], "Input",
 CellChangeTimes->{3.965317107876034*^9},
 CellLabel->"In[2]:=",ExpressionUUID->"e083c35a-b16d-4e17-bec5-f7a9b5ed7141"],

Cell["For this example we employ five two-level atoms", "Text",
 CellChangeTimes->{{3.964876966723848*^9, 3.964876976051291*^9}, {
  3.968253890919015*^9, 3.9682538961828203`*^9}, {3.968263738670349*^9, 
  3.968263801346403*^9}, {3.9730147446240892`*^9, 
  3.97301474920424*^9}},ExpressionUUID->"6396fbe4-30e9-46e9-baff-\
34aab3cf6e10"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"na", "=", "5"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nl", "=", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n", " ", "=", " ", 
   SuperscriptBox["nl", "na"]}], ";"}]}], "Input",
 CellLabel->"In[4]:=",ExpressionUUID->"cd858da3-5f48-46c7-be0e-26387b684a86"],

Cell["\<\
We set the matrix basis, density matrix and initial density matrix\
\>", "Text",
 CellChangeTimes->{{3.9682638804399557`*^9, 3.9682639296141453`*^9}, {
  3.968264010712554*^9, 3.9682640160490417`*^9}, {3.973014753925634*^9, 
  3.973014754815628*^9}},ExpressionUUID->"0be61248-aec7-47c2-bf2a-\
a529f918d9e5"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"h", "=", 
   RowBox[{"MultiAtomBasis", "[", 
    RowBox[{"nl", ",", "na"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"rho", "=", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"Subscript", "[", 
        RowBox[{"\[Rho]", ",", "ii"}], "]"}], "[", "t", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"ii", ",", "1", ",", 
        SuperscriptBox["n", "2"]}], "}"}]}], "]"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Eta]0", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rho0", "=", 
   RowBox[{"KroneckerProduct", "[", 
    RowBox[{
    "\[Eta]0", ",", "\[Eta]0", ",", "\[Eta]0", ",", "\[Eta]0", ",", 
     "\[Eta]0"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.968263989555808*^9, 3.9682639924928637`*^9}},
 CellLabel->"In[7]:=",ExpressionUUID->"0e9edef3-2f55-4c4f-ae03-a4ba5626bb1e"],

Cell["\<\
The configuration files for the Hamiltonian and Lindbladian Liouville \
superoperators are defined such that all atoms are equally coupled. Two \
distinct atoms are assigned coupling parameters M\[Gamma] and W\[Gamma] for \
the Hamiltonian and Lindbladian Liouville superoperators, respectively. No \
self-coupling terms are included in the transdd part of the Hamiltonian. The \
configuration files are therefore specified as follows:\
\>", "Text",
 CellChangeTimes->{{3.968264023722806*^9, 3.968264229469678*^9}, {
  3.968264407697288*^9, 
  3.968264444856309*^9}},ExpressionUUID->"6e2597ef-64fd-4755-870c-\
2cb27627921b"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"transCE", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"transLi", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"transdd", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"\[Alpha]", "==", "\[Beta]"}], ",", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"AppendTo", "[", 
         RowBox[{"transLi", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", "2"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", "2"}], "}"}], ",", "\[Alpha]", ",", "\[Beta]", 
            ",", "\[Gamma]", ",", "0"}], "}"}]}], "]"}], ";"}], ",", 
       "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"AppendTo", "[", 
         RowBox[{"transLi", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", "2"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", "2"}], "}"}], ",", "\[Alpha]", ",", "\[Beta]", 
            ",", 
            RowBox[{"W", " ", "\[Gamma]"}], ",", "0"}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"AppendTo", "[", 
         RowBox[{"transdd", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"1", ",", "2"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"1", ",", "2"}], "}"}], ",", "\[Alpha]", ",", "\[Beta]", 
            ",", 
            RowBox[{"M", " ", "\[Gamma]"}], ",", "0"}], "}"}]}], "]"}], 
        ";"}]}], "\[IndentingNewLine]", "]"}], ";"}], "\[IndentingNewLine]", 
    ",", 
    RowBox[{"{", 
     RowBox[{"\[Alpha]", ",", "1", ",", "na"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"\[Beta]", ",", "1", ",", "na"}], "}"}]}], "]"}], 
  ";"}]}], "Input",
 CellLabel->"In[11]:=",ExpressionUUID->"7f853942-3e0c-4c6c-a079-caab5e1be910"],

Cell["\<\
At this point, we are ready to derive the master equation in terms of the \
differential equations for the density matrix coefficients (this might take \
some time)\
\>", "Text",
 CellChangeTimes->{{3.968264268062166*^9, 3.968264323160355*^9}, {
  3.96826479763059*^9, 3.968264799398775*^9}, {3.9682660782673893`*^9, 
  3.968266084532166*^9}},ExpressionUUID->"6321c576-549b-4731-8c3a-\
30049c2b0935"],

Cell[BoxData[
 RowBox[{
  RowBox[{"diffeqs", "=", 
   RowBox[{"MasterEquation", "[", 
    RowBox[{
    "h", ",", "rho", ",", "rho0", ",", "transCE", ",", "transdd", ",", 
     "transLi", ",", "nl", ",", "na", ",", "t"}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[15]:=",ExpressionUUID->"85fc869d-0123-463c-9810-a3d1aa0a8a4f"],

Cell["\<\
For comparison, we first calculate the emission from five independent atoms. \
To this end, we set the coupling parameters to zero, compute the numerical \
form of the differential equations, and obtain the corresponding solution\
\>", "Text",
 CellChangeTimes->{{3.968264580649838*^9, 3.968264688395522*^9}, {
  3.968264838019518*^9, 
  3.968264848729392*^9}},ExpressionUUID->"b333642a-d1c8-473f-9d12-\
ac8fb5084744"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"consts", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Gamma]", "\[Rule]", "0.151458"}], ",", 
     RowBox[{"W", "\[Rule]", "0.0"}], ",", 
     RowBox[{"M", "->", "0.0"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"diffeqsn", "=", 
    RowBox[{"diffeqs", "/.", "consts"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tmin", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"tmax", "=", "15"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sol", "=", 
   RowBox[{
    RowBox[{"NDSolve", "[", 
     RowBox[{"diffeqsn", ",", "rho", ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "tmin", ",", "tmax"}], "}"}]}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.9682642635331306`*^9, 3.968264264025749*^9}, 
   3.96826463845909*^9, {3.968264703396247*^9, 
   3.9682647159511213`*^9}},ExpressionUUID->"5d91bb27-9306-4c67-a16d-\
89485eb264d4"],

Cell[TextData[{
 "The field of the emitted light contains the contributions from the five \
atoms E \[Proportional]",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     UnderoverscriptBox["\[Sum]", 
      RowBox[{"\[Alpha]", "=", "1"}], "5"], 
     SubscriptBox["\[Sigma]", 
      RowBox[{"1", ",", "\[Alpha]"}]]}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fd3b8027-6166-4439-86f0-2ffa7550fa9c"],
 " where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Sigma]", 
    RowBox[{"1", ",", "\[Alpha]"}]], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "00bc96b3-4af4-47c6-8099-b142e54cdf20"],
 " denotes the atomic lowering operator  \[VerticalSeparator]1",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[RightAngleBracket]", "\[Alpha]"], 
    RowBox[{
     SubscriptBox["\[InvisiblePrefixScriptBase]", "\[Alpha]"], 
     "\[LeftAngleBracket]"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "913e16bc-f350-4199-9a88-242622333fd2"],
 "2\[VerticalSeparator] for atom \[Alpha], hence ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["E", "\[Dagger]"], "E"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "f16ba99c-370a-4275-a5f3-a051be3e9f3b"],
 ", which is proportional to the emission power, is given by"
}], "Text",
 CellChangeTimes->{{3.968264736552693*^9, 3.968264741493206*^9}, {
  3.968264854130155*^9, 3.9682648639170513`*^9}, {3.9682650760335484`*^9, 
  3.968265076753087*^9}, {3.968265133386554*^9, 3.9682651351206493`*^9}, {
  3.968265167094575*^9, 3.968265328218481*^9}, {3.968265369483334*^9, 
  3.968265445139306*^9}},ExpressionUUID->"6d8433a7-c88f-4dc9-9fc2-\
3d5798a948c0"],

Cell[BoxData[
 RowBox[{
  RowBox[{"EtE", "=", 
   RowBox[{"Sum", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"SigmaT", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", "\[Alpha]", ",", "nl", ",", 
        "na"}], "]"}], ".", 
      RowBox[{"Sigma", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", "\[Beta]", ",", "nl", ",", 
        "na"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Alpha]", ",", "na"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\[Beta]", ",", "na"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellLabel->"In[21]:=",ExpressionUUID->"69e7e9bf-73b8-44b0-8ae5-9e3a24d7ab68"],

Cell[TextData[{
 "Using the solution we compute  \[LeftAngleBracket]",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["E", "\[Dagger]"], "E"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "fce0eaff-cfd4-49fb-aaf5-32cfb7893f2a"],
 "\[RightAngleBracket], the expected value of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["E", "\[Dagger]"], "E"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "381d6cdc-e7ed-4957-bd22-ef90af452dac"]
}], "Text",
 CellChangeTimes->{{3.9682654776501303`*^9, 3.968265499820153*^9}, {
  3.968265864983757*^9, 
  3.968265890298545*^9}},ExpressionUUID->"90b56d6b-9429-4884-a56a-\
b7b344cf96f9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"evi", "=", 
   RowBox[{
    RowBox[{"Re", "[", 
     RowBox[{"ExpectationValue", "[", 
      RowBox[{"h", ",", "rho", ",", "EtE"}], "]"}], "]"}], "/.", "sol"}]}], 
  ";"}]], "Input",
 CellLabel->"In[22]:=",ExpressionUUID->"0ae0ade0-4e43-4192-a231-bbffe49d475d"],

Cell[TextData[{
 "We calculate a list of 50 time vs. emission power points and fit the list \
to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["I", "0"], 
    RowBox[{"exp", "(", 
     RowBox[{
      RowBox[{"-", "t"}], "/", "\[Tau]"}], ")"}]}], TraditionalForm]],
  ExpressionUUID->"667f9b11-4a5a-4146-aedd-3a3440f39fe0"],
 " to obtain the decay time \[Tau] "
}], "Text",
 CellChangeTimes->{{3.968264879439313*^9, 3.96826488244697*^9}, {
   3.968264981544465*^9, 3.968265073764543*^9}, 3.9682653580862513`*^9, {
   3.968265520758965*^9, 3.968265642421019*^9}, {3.973014836122868*^9, 
   3.973014854560223*^9}},ExpressionUUID->"f70f729e-5ff0-464b-b9da-\
253dcf1e1ab4"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"nd", "=", "50"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"datai", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"tmin", "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"tmax", "-", "tmin"}], ")"}], 
         RowBox[{"ii", "/", "nd"}]}]}], ",", 
       RowBox[{"evi", "/.", 
        RowBox[{"{", 
         RowBox[{"t", "->", 
          RowBox[{"tmin", "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"tmax", "-", "tmin"}], ")"}], 
            RowBox[{"ii", "/", "nd"}]}]}]}], "}"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"ii", ",", "0", ",", "nd"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"fit", "=", 
  RowBox[{"FindFit", "[", 
   RowBox[{"datai", ",", 
    RowBox[{"I0", " ", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", " ", "t"}], "/", "\[Tau]"}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"I0", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Tau]", ",", "5"}], "}"}]}], "}"}], ",", "t"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"funi", "=", 
   RowBox[{
    RowBox[{"I0", " ", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", " ", "t"}], "/", "\[Tau]"}], "]"}]}], "/.", "fit"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.9682656575713377`*^9, 3.968265663553228*^9}},
 CellLabel->"In[27]:=",ExpressionUUID->"143c0e98-42d3-4bd0-b1c1-d42a148a89e9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"I0", "\[Rule]", "5.00000008040708`"}], ",", 
   RowBox[{"\[Tau]", "\[Rule]", "6.6024904338665635`"}]}], "}"}]], "Output",
 CellChangeTimes->{{3.968265659393824*^9, 3.9682656645480833`*^9}},
 CellLabel->"Out[29]=",ExpressionUUID->"936fc1ff-d56e-4aab-83c1-ad90e85e1176"]
}, Open  ]],

Cell["Note that \[Tau] = 1/\[Gamma] = 6.60249", "Text",
 CellChangeTimes->{{3.968265688678277*^9, 
  3.9682657167795687`*^9}},ExpressionUUID->"865de97f-7ff5-409a-a663-\
c1897276ca5b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"1", "/", "\[Gamma]"}], "/.", "consts"}]], "Input",
 CellChangeTimes->{{3.968265676629118*^9, 3.968265678075119*^9}, {
  3.968265723312786*^9, 3.9682657263837643`*^9}},
 CellLabel->"In[32]:=",ExpressionUUID->"74b6363b-61f4-4c84-a36f-11f372cd0558"],

Cell[BoxData["6.602490459401285`"], "Output",
 CellChangeTimes->{3.9682656790962133`*^9, 3.968265726986525*^9},
 CellLabel->"Out[32]=",ExpressionUUID->"3f22e6eb-be1d-4163-a060-a1a0e451d769"]
}, Open  ]],

Cell["\<\
This is expected, since the atoms are independent. We plot the fitted \
function, the data points and the numerical solution for the expected value\
\>", "Text",
 CellChangeTimes->{{3.9682657402034483`*^9, 3.9682657596476297`*^9}, {
  3.96826579521489*^9, 
  3.968265841347699*^9}},ExpressionUUID->"2aad5815-dbed-4f60-ac59-\
a36a4ea058f9"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Plot", "[", 
