Cell[TextData[{
 "We set the configuration countlist to generate two far-field operators. The \
first corresponds to transitions between orbitals in groups 1 and 2, with a \
dipole matrix element parallel to the polarization vector ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    SqrtBox["2"]}], TraditionalForm]],ExpressionUUID->
  "e2d18f12-3d7a-435f-a000-329b9335ad45"],
 "{1, \[ImaginaryI], 0}. The second corresponds to transitions between \
orbitals in groups 2 and 3, with a dipole matrix element parallel to the \
polarization vector ",
 Cell[BoxData[
  FormBox[
   RowBox[{"1", "/", 
    SqrtBox["2"]}], TraditionalForm]],ExpressionUUID->
  "2b697939-f64b-4815-8b92-45f77e49b8cb"],
 "{1, -\[ImaginaryI], 0}. Both detectors are placed at a distance R from the \
atomic system along the z-axis"
}], "Text",
 CellChangeTimes->{
  3.965399661424448*^9, {3.965400122274788*^9, 3.965400317560134*^9}, {
   3.965401978389646*^9, 3.965402091011919*^9}, {3.965402124850102*^9, 
   3.965402222577279*^9}, {3.9654022756626883`*^9, 3.965402315155532*^9}, {
   3.9654023843338194`*^9, 3.965402389147929*^9}, 3.965402443476119*^9, {
   3.965402487278619*^9, 3.9654025117611437`*^9}, {3.965403252506503*^9, 
   3.965403282284423*^9}, {3.965403336524493*^9, 
   3.9654033383372583`*^9}},ExpressionUUID->"6e1be73d-9426-422e-aebc-\
57a1565ab235"],

Cell[BoxData[
 RowBox[{
  RowBox[{"countlist", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         FractionBox["1", 
          SqrtBox["2"]], ",", 
         FractionBox["\[ImaginaryI]", 
          SqrtBox["2"]], ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "R"}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         FractionBox["1", 
          SqrtBox["2"]], ",", 
         RowBox[{"-", 
          FractionBox["\[ImaginaryI]", 
           SqrtBox["2"]]}], ",", "0"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"0", ",", "0", ",", "R"}], "}"}]}], "}"}]}], "}"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.965330324620825*^9, 3.965330410500785*^9}, 
   3.965402726183899*^9, {3.965402980467102*^9, 3.96540299259692*^9}},
 CellLabel->"In[39]:=",ExpressionUUID->"e59318cd-32ba-4e72-bf21-ff77f994089c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"atompos", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"r", ",", "0", ",", "0"}], "}"}]}], "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.965330475110306*^9, 3.965330486127773*^9}, {
   3.965330679673049*^9, 3.965330679797909*^9}, {3.965402570356976*^9, 
