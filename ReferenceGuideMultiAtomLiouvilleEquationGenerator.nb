Cell["\<\
We use MasterEquation to obtain the master equation and set the system \
parameters in the variable consts\
\>", "Text",
 CellChangeTimes->{{3.965413589379351*^9, 3.96541359030262*^9}, {
   3.965413621362692*^9, 3.965413625363721*^9}, {3.965413697432278*^9, 
   3.965413755466044*^9}, {3.965469857101219*^9, 3.965469884168627*^9}, {
   3.965470241489749*^9, 3.965470259292671*^9}, 
   3.965470400834089*^9},ExpressionUUID->"b8189c37-6221-4453-b317-\
7a76ad9841ea"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"diffeqs", "=", 
   RowBox[{"MasterEquation", "[", 
    RowBox[{
    "h", ",", "rho", ",", "rho0", ",", "transCE", ",", "transdd", ",", 
     "transLi", ",", "nl", ",", "na", ",", "t"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"consts", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[Gamma]", "1"], "->", "0.07573"}], ",", 
     RowBox[{
      SubscriptBox["\[Gamma]", "2"], "->", "0.001343"}], ",", 
     RowBox[{
      SubscriptBox["R", "1"], "->", "0.1"}], ",", 
     RowBox[{
      SubscriptBox["R", "2"], "->", "0.1"}], ",", 
     RowBox[{
      SubscriptBox["\[Delta]", "1"], "->", "0.0"}], ",", 
     RowBox[{
      SubscriptBox["\[Delta]", "2"], "->", "0.0"}], ",", 
     RowBox[{
      SubscriptBox["\[Phi]", 
       RowBox[{"1", ",", "1"}]], "->", "0"}], ",", 
     RowBox[{
      SubscriptBox["\[Phi]", 
       RowBox[{"2", ",", "1"}]], "->", "0"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"diffeqsn", "=", 
   RowBox[{"diffeqs", "/.", "consts"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.965413727357942*^9, 3.965413766155585*^9}, {
  3.965413846934396*^9, 3.965413854135702*^9}, {3.965414276253392*^9, 
  3.965414299035035*^9}, {3.965414340484762*^9, 3.965414350694361*^9}, {
  3.965469892402093*^9, 3.965469905737317*^9}},
 CellLabel->"In[56]:=",ExpressionUUID->"fc1c636a-1052-4028-abe2-918dc54f5388"],

Cell[TextData[{
 "The constants in consts correspond to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[InvisiblePrefixScriptBase]", "87"], "Rb"}], 
   TraditionalForm]],ExpressionUUID->"07d5afaa-741e-4f19-b557-d55eca7f4859"],
 " and are given in units of ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["ns", 
    RowBox[{"-", "1"}]], TraditionalForm]],ExpressionUUID->
  "b17b3cfb-1a30-45d2-8052-33e9a632fe3d"],
 ". Finally, we solve the system of differential equations"
}], "Text",
 CellChangeTimes->{{3.9654699254942408`*^9, 3.965469934029615*^9}, {
  3.965470124831411*^9, 3.965470189931021*^9}, {3.965470275890581*^9, 
  3.9654702985786047`*^9}},ExpressionUUID->"0cb84d8f-a302-4622-b123-\
1dd9612e3190"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"tmax", "=", "100000"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sol", "=", 
   RowBox[{
    RowBox[{"NDSolve", "[", 
     RowBox[{"diffeqsn", ",", 
      RowBox[{"Normal", "[", "rho", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "0", ",", "tmax"}], "}"}]}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.965415610370604*^9, 3.965415648749666*^9}, {
  3.965415940407845*^9, 3.965415999402177*^9}, {3.965416151110453*^9, 
  3.965416158627451*^9}},
 CellLabel->"In[59]:=",ExpressionUUID->"c078c206-5c1c-482f-84fc-45acc32d8f3f"],

Cell[TextData[{
 "We plot the populations of 5 ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", 
    RowBox[{"1", "/", "2"}]], TraditionalForm]],ExpressionUUID->
  "22b5219f-0b30-40c8-b0b7-f3560c1da68a"],
 ", F=2; 5 ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", 
    RowBox[{"3", "/", "2"}]], TraditionalForm]],ExpressionUUID->
  "8c06b370-c814-4b12-81aa-715311a88dcd"],
 ", F=3 and 5 ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["D", 
    RowBox[{"3", "/", "2"}]], TraditionalForm]],ExpressionUUID->
  "4b2e96c4-cca2-4efb-9d3b-84d4392ad0a3"],
 "F=3, confirming that optical pumping conditions are reached"
}], "Text",
 CellChangeTimes->{{3.965469961806018*^9, 3.965470024716945*^9}, {
  3.965470062782212*^9, 3.9654700922386513`*^9}, {3.965470343308342*^9, 
  3.9654703798309717`*^9}},ExpressionUUID->"088d83ea-0574-4330-987b-\
231adcaea481"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"groups", "=", 
   RowBox[{"{", 
    RowBox[{
    "\"\<\!\(\*SuperscriptBox[\(5\), \(2\)]\)\!\(\*SuperscriptBox[\(S\), \
\(1/2\)]\) F=2\>\"", ",", 
     "\"\<5 \!\(TraditionalForm\`\*SubscriptBox[\(P\), \(3/2\)]\)F=3\>\"", 
     ",", " ", 
     "\"\<5 \!\(TraditionalForm\`\*SubscriptBox[\(D\), \(3/2\)]\)F=3\>\""}], 
    "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pl", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"con", "=", "0"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"con", "+=", "1"}], ";", "\[IndentingNewLine]", 
     RowBox[{"pops", "=", 
      RowBox[{
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"Subscript", "[", 
           RowBox[{"\[Rho]", ",", "ii"}], "]"}], "[", "t", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"ii", ",", 
           RowBox[{"lev", "[", 
            RowBox[{"[", 
             RowBox[{";;", ",", "1"}], "]"}], "]"}]}], "}"}]}], "]"}], "/.", 
       "sol"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"pl", ",", 
       RowBox[{"Plot", "[", 
        RowBox[{"pops", ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "tmax"}], "}"}], ",", 
         RowBox[{"PlotRange", "->", "All"}], ",", 
         RowBox[{"Frame", "->", "True"}], ",", 
         RowBox[{"Axes", "->", "False"}], ",", 
         RowBox[{"FrameLabel", "->", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Style", "[", 
             RowBox[{"\"\<t (ns)\>\"", ",", "20"}], "]"}], ",", 
            RowBox[{"Style", "[", 
             RowBox[{
              RowBox[{"groups", "[", 
               RowBox[{"[", "con", "]"}], "]"}], ",", "20"}], "]"}]}], 
           "}"}]}], ",", 
         RowBox[{"PlotLabels", "->", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"StringJoin", "[", 
             RowBox[{"\"\<m=\>\"", ",", 
              RowBox[{"ToString", "[", "m", "]"}]}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"m", ",", 
              RowBox[{"lev", "[", 
               RowBox[{"[", 
                RowBox[{";;", ",", "2"}], "]"}], "]"}]}], "}"}]}], "]"}]}]}], 
        "]"}]}], "]"}], ";"}], "\[IndentingNewLine]", ",", 
    RowBox[{"{", 
     RowBox[{"lev", ",", "levels"}], "}"}]}], "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"GraphicsColumn", "[", "pl", "]"}]}], "Input",
 CellChangeTimes->{{3.965415750988456*^9, 3.96541583540367*^9}, {
   3.9654158808654213`*^9, 3.9654160230487328`*^9}, {3.965416088521467*^9, 
