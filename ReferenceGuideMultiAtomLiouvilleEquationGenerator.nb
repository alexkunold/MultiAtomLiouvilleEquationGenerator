Cell["\<\
Plot the imaginary part of the Green\[CloseCurlyQuote]s function as a \
function of the distance between atoms. First we define the dipole matrix \
elements considering that both belong to the same transition\
\>", "Text",
 CellChangeTimes->{{3.954878267343335*^9, 3.954878302452935*^9}, {
  3.9550228120733747`*^9, 3.955022812792588*^9}, {3.965305034952674*^9, 
  3.965305068248769*^9}, {3.9653051364750757`*^9, 3.965305259962713*^9}, {
  3.965305300518214*^9, 3.965305340668613*^9}, {3.96530540082684*^9, 
  3.965305408632818*^9}, {3.965305475001536*^9, 3.965305475821154*^9}, {
  3.965305753689602*^9, 3.965305758677067*^9}, {3.965305798611388*^9, 
  3.9653058211371393`*^9}, {3.965398817953855*^9, 3.96539882219979*^9}, {
  3.965398908808282*^9, 3.96539895189121*^9}, {3.965399009564953*^9, 
  3.965399032671966*^9}, {3.96539914443134*^9, 3.965399226493723*^9}, {
  3.968248419370947*^9, 3.968248422456901*^9}, {3.968248482042006*^9, 
  3.968248485581057*^9}, {3.968248638850754*^9, 3.968248696996821*^9}, {
  3.968248739903627*^9, 
  3.968248811603243*^9}},ExpressionUUID->"4c8add18-424d-435e-9cfe-\
319ec031a249"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"p1", "=", 
   RowBox[{"{", 
    RowBox[{
     FractionBox["1", 
      SqrtBox["3"]], ",", 
     FractionBox["\[ImaginaryI]", 
      SqrtBox["3"]], ",", "0"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p2", "=", 
   RowBox[{"{", 
    RowBox[{
     FractionBox["1", 
      SqrtBox["3"]], ",", 
     FractionBox["\[ImaginaryI]", 
      SqrtBox["3"]], ",", "0"}], "}"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.968248703212574*^9, 3.9682487368096457`*^9}, {
  3.968248789311982*^9, 3.968248802181645*^9}},
 CellLabel->"In[53]:=",ExpressionUUID->"5c33c0a4-1ad1-4518-9ec5-3c3e466adb97"],

Cell["\<\
Assuming that the coupling corresponds to two atoms along the y axis\
\>", "Text",
 CellChangeTimes->{{3.968248846280694*^9, 
  3.968248871536087*^9}},ExpressionUUID->"13b5ca4c-9190-49b2-991d-\
1d04ab2c7bec"],

Cell[BoxData[
 RowBox[{
  RowBox[{"rhat", "=", 
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "0"}], "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.9682488211240797`*^9, 3.9682488266131783`*^9}, 
   3.9682489943657913`*^9},
 CellLabel->"In[56]:=",ExpressionUUID->"4a0141c6-bf9d-4104-b667-1a2d13c9c5d2"],

Cell["\<\
and that the wave lenght is 0.780 \[Mu]m, the imaginary part of the Green\
\[CloseCurlyQuote]s function is\
\>", "Text",
 CellChangeTimes->{{3.968248895153452*^9, 
  3.96824896633829*^9}},ExpressionUUID->"6c444b62-e57f-4d54-8262-\
5dd8fae173fd"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"WDipoleDipoleElement", "[", 
    RowBox[{"p1", ",", "p2", ",", "rhat", ",", " ", 
     RowBox[{
      FractionBox[
       RowBox[{"2", "\[Pi]"}], "0.780"], "r"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"r", ",", "0", ",", "1.800"}], "}"}], ",", 
   RowBox[{"Axes", "->", "False"}], ",", 
   RowBox[{"Frame", "->", "True"}], ",", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Style", "[", 
       RowBox[{"\"\<r (\[Mu]m)\>\"", ",", "20"}], "]"}], ",", 
      RowBox[{"Style", "[", 
       RowBox[{
       "\"\<\!\(\*SubscriptBox[\(W\), \(i, j\)]\)(\[Kappa] r)\>\"", ",", 
        "20"}], "]"}]}], "}"}]}], ",", 
   RowBox[{"PlotRange", "->", "All"}]}], "]"}]], "Input",
