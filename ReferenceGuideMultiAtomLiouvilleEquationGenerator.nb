Cell[TextData[{
 "This transition has dipole matrix element parallel to ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", "/", 
     SqrtBox["2"]}]}], TraditionalForm]],ExpressionUUID->
  "93b539cd-9233-4a3a-9c02-b500ba68628c"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[ImaginaryI]", "/", 
    SqrtBox["2"]}], TraditionalForm]],ExpressionUUID->
  "96636b5f-f050-4829-9732-5f7a30fe2925"],
 " }, which is orthogonal to  ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"1", "/", 
     SqrtBox["2"]}]}], TraditionalForm]],ExpressionUUID->
  "2f0f0ce1-926a-4c9e-a138-49480c584f50"],
 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{"-", "\[ImaginaryI]"}], "/", 
    SqrtBox["2"]}], TraditionalForm]],ExpressionUUID->
  "7f8f7d50-2beb-4bfe-b12b-971a136439f0"],
 " }. Hence, is not an element of transCE."
}], "Text",
 CellChangeTimes->{
  3.965313531468025*^9, {3.9653137024291573`*^9, 
   3.965313737732969*^9}},ExpressionUUID->"2b63ca01-b51d-4cc0-820e-\
52462d156b74"],

Cell["\<\
When \[CapitalDelta]\[Epsilon] is not specified as an argument of \
TransitionLists the energy shifts are omitted from  transdd, transLi and \
transCE\
\>", "Text",
 CellChangeTimes->{{3.965398274163369*^9, 3.965398340153858*^9}, {
  3.965398510359947*^9, 3.965398575349107*^9}, {3.965398708625728*^9, 
