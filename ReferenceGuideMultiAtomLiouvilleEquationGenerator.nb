Cell[TextData[{
 "Now we can observe the dynamics of different expectation values . For \
example, to compute the correlations \[LeftAngleBracket]",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Sigma]", 
    RowBox[{"2", ",", "1"}], "1"], TraditionalForm]],ExpressionUUID->
  "b6b7a240-49d0-49c7-bb8e-e67d601d56e0"],
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Sigma]", 
    RowBox[{"1", ",", "2"}], "5"], TraditionalForm]],ExpressionUUID->
  "4209e063-e9ed-452a-9076-c22906868e6c"],
 "+",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Sigma]", 
    RowBox[{"2", ",", "1"}], "5"], TraditionalForm]],ExpressionUUID->
  "f1a42dab-6538-424a-b896-1b3c409027e4"],
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Sigma]", 
    RowBox[{"1", ",", "2"}], "1"], TraditionalForm]],ExpressionUUID->
  "6fabf75a-c1f9-487e-b815-02e1005f36fe"],
 "\[RightAngleBracket] and \[LeftAngleBracket]",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Sigma]", 
    RowBox[{"2", ",", "1"}], "1"], TraditionalForm]],ExpressionUUID->
  "5ace3ca4-da72-4d9d-b3a9-13894e300fca"],
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Sigma]", 
    RowBox[{"1", ",", "2"}], "2"], TraditionalForm]],ExpressionUUID->
  "a6b5cd60-c5d3-4ea2-846a-5b8d216f76f9"],
 "+",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Sigma]", 
    RowBox[{"2", ",", "1"}], "2"], TraditionalForm]],ExpressionUUID->
  "fcadbc26-7158-491e-861f-b64ae0506206"],
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Sigma]", 
    RowBox[{"1", ",", "2"}], "1"], TraditionalForm]],ExpressionUUID->
  "bc9140ac-e912-439f-8501-f1b4d3989318"],
 "\[RightAngleBracket] where ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Sigma]", 
    RowBox[{"1", ",", "2"}], "1"], TraditionalForm]],ExpressionUUID->
  "5d435c73-c21b-4081-83fc-72cff066c883"],
 " =1\[CircleTimes]1\[CircleTimes]1\[CircleTimes]1\[CircleTimes] \
\[VerticalSeparator]1\[RightAngleBracket]\[LeftAngleBracket]2\
\[VerticalSeparator] , ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Sigma]", 
    RowBox[{"1", ",", "2"}], "2"], TraditionalForm]],ExpressionUUID->
  "f16e0e61-4f1a-4f7e-9ea9-1b2575acb318"],
 " = 1\[CircleTimes]1\[CircleTimes]1\[CircleTimes]\[VerticalSeparator]1\
\[RightAngleBracket]\[LeftAngleBracket]2\[VerticalSeparator]\[CircleTimes]1 \
and ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Sigma]", 
    RowBox[{"1", ",", "2"}], "5"], TraditionalForm]],ExpressionUUID->
  "9ce421cb-7b9d-4358-8f74-51dd372df38f"],
 " = \[VerticalSeparator]1\[RightAngleBracket]\[LeftAngleBracket]2\
\[VerticalSeparator]\[CircleTimes]1\[CircleTimes]1\[CircleTimes]1\
\[CircleTimes]1"
}], "Text",
