 CellLabel->
  "Out[172]=",ExpressionUUID->"209ebd5e-741b-4e6c-8eeb-5de0f6a7cad8"]
}, Open  ]],

Cell[TextData[{
 "This variable indicates that there is only one laser field, coupling the \
states \[VerticalSeparator]1\[RightAngleBracket] and \[VerticalSeparator]2\
\[RightAngleBracket] ({1,2}) of a single atom (1), with Rabi frequency ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "1"], TraditionalForm]],ExpressionUUID->
  "f5d09a13-a757-4f5c-a92c-206d2dd72c1f"],
 " and detuning ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalDelta]", "1"], TraditionalForm]],ExpressionUUID->
  "66b0c1db-a184-4936-9266-3383b2e02ff5"],
 ". The phase due to the atom\[CloseCurlyQuote]s position is taken to be \
zero, assuming the atom is located at the origin. Since there is only one \
atom, the variable transdd,which lists the coherent interactions between \
atoms is an empty list"
}], "Text",
 CellChangeTimes->{{3.9648689970376377`*^9, 3.964869024649825*^9}, {
   3.964869055455311*^9, 3.964869188975588*^9}, {3.964869230578914*^9, 
   3.9648692343387337`*^9}, 3.964870202040921*^9, {3.964870233477539*^9, 
   3.964870258191699*^9}, {3.964870344023551*^9, 3.9648703678804893`*^9}, {
   3.96487811440835*^9, 3.964878147415024*^9}, {3.964878179100533*^9, 
   3.964878200072987*^9}, 3.966352174920802*^9, {3.9663522159410477`*^9, 
   3.9663522264482512`*^9}, {3.971287129559608*^9, 3.97128716040856*^9}, {
   3.9712881254403143`*^9, 3.9712881467644978`*^9}, {3.9748902353464108`*^9, 
   3.974890271888164*^9}, {3.9786050324008102`*^9, 
   3.97860504072927*^9}},ExpressionUUID->"3890704e-9449-4d7e-9584-\
ad2f7600c060"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"transdd", "=", 
  RowBox[{"{", "}"}]}]], "Input",
