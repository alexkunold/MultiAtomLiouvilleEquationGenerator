Cell[CellGroupData[{

Cell["Example", "Subsubsection",
 CellChangeTimes->{{3.954934528317594*^9, 3.9549345300556*^9}, 
   3.964030686639983*^9},ExpressionUUID->"86ffd3ce-469e-4be3-ac4d-\
df547d92f64d"],

Cell[TextData[{
 "Calculate the adjoint Liouville superoperator corresponding to the adjoint \
Lindbladian part of the adjoint master equation of a system of two (na=2) \
three level (nl=3) atoms. The only  transitions with non-vanishing dipole \
matrix elements are  \[VerticalSeparator]1\[RightAngleBracket] \[RightArrow]\
\[VerticalSeparator]2\[RightAngleBracket] and \[VerticalSeparator]2\
\[RightAngleBracket] \[RightArrow]\[VerticalSeparator]3\[RightAngleBracket]. \
The transition  \[VerticalSeparator]1\[RightAngleBracket] \[RightArrow]\
\[VerticalSeparator]2\[RightAngleBracket] is tagged with the number 1, and \
the transition  \[VerticalSeparator]2\[RightAngleBracket] \[RightArrow]\
\[VerticalSeparator]3\[RightAngleBracket] is tagged with the number 2. The \
strength of the dipole couplings are tagged accordingly: ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "1"], TraditionalForm]],ExpressionUUID->
  "c7566a56-c8ed-43e1-8e01-430f84bec117"],
 " is the coupling due to the dipole element of the transition 1 if only one \
atom is involved, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", 
    RowBox[{"1", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "9d6ed49c-a66c-4c87-9a03-0155ef95460c"],
 " is the coupling due to the dipole element of the transition 1 if two \
different atoms are involved,  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "2"], TraditionalForm]],ExpressionUUID->
  "906ff3fe-4ff9-441c-a058-28fa1166db2a"],
 " is the coupling due to the dipole element of the transition 2 if only one \
atom is involved and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", 
    RowBox[{"2", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "4c823275-5bf9-4bc6-8cdb-ae4208f9c38e"],
 " is the coupling due to the dipole element of the transition 2 if two \
different atoms are involved."
}], "Text",
 CellChangeTimes->{{3.954934577830982*^9, 3.954934666984077*^9}, {
   3.954934791806799*^9, 3.95493488777148*^9}, {3.954935370006019*^9, 
   3.954935373498506*^9}, {3.954935556056313*^9, 3.954935600422351*^9}, {
   3.954942537342256*^9, 3.954942578376485*^9}, {3.9549427153918667`*^9, 
   3.954942906391176*^9}, {3.954942937754725*^9, 3.954943027463854*^9}, {
   3.954943883336549*^9, 3.9549439062399797`*^9}, {3.954944165431011*^9, 
   3.954944225207417*^9}, {3.954944258618572*^9, 3.95494430743131*^9}, {
   3.954954676178163*^9, 3.954954734957655*^9}, {3.9549568531902533`*^9, 
   3.954956855512775*^9}, 3.954959193924027*^9, {3.954962078172947*^9, 
   3.954962089528637*^9}, {3.954962304826511*^9, 3.954962305011799*^9}, {
