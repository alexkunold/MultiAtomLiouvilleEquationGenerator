Cell["\<\
ADJOINT MASTER EQUATION
Set the initial conditions for the adjoint master equation\
\>", "Text",
 CellChangeTimes->{{3.955038613351335*^9, 3.955038620082892*^9}, {
  3.964030388618929*^9, 
  3.964030405166686*^9}},ExpressionUUID->"be95b7c3-9284-4562-a193-\
1f2cecfa9d55"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ainconds", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["q", "ii"], "[", "0", "]"}], "==", 
      RowBox[{"Tr", "[", 
       RowBox[{
        RowBox[{"h", "[", 
         RowBox[{"[", "ii", "]"}], "]"}], ".", "\[Rho]0"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"ii", ",", "1", ",", "81"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.955037809567502*^9, 3.955037862837812*^9}, {
  3.955037899340591*^9, 3.955037926037444*^9}, {3.955038710181897*^9, 
  3.955038724849325*^9}},
 CellLabel->"In[75]:=",ExpressionUUID->"2ff434cc-1a5f-44f3-a725-0438a6b910c1"],

Cell["\<\
Join the differential equations with the initial conditions for the master \
equation, solve the resulting system, compute the expected value of the \
operator op, and superimpose the master equation plot (light blue, thick \
line) onto the adjoint master equation plot (dark blue, thin line).\
\>", "Text",
 CellChangeTimes->{{3.964030418321993*^9, 3.964030622393161*^9}, {
  3.964030749872782*^9, 3.9640307841532707`*^9}, {3.964030822169091*^9, 
  3.964030843872171*^9}, {3.964030887383319*^9, 
  3.964030896807365*^9}},ExpressionUUID->"9e0020cd-362d-4165-a4d7-\
c1111ed395aa"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"adeqs", "=", 
   RowBox[{
    RowBox[{"Join", "[", 
     RowBox[{"aleqs", ",", "ainconds"}], "]"}], "/.", "conds"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"asol", "=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{"adeqs", ",", 
     RowBox[{"Normal", "[", "vq", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "10.0"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"aexpval", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"TensorContract", "[", 
      RowBox[{
       RowBox[{"h", ".", "op"}], ",", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], "}"}]}], "]"}], ".", "vq"}], "/.", 
    "asol"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"expval", ",", "aexpval"}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", ".5"}], "}"}], ",", 
   RowBox[{"PlotRange", "->", "All"}], ",", 
   RowBox[{"PlotStyle", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"LightBlue", ",", 
        RowBox[{"Thickness", "[", "0.03", "]"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"Blue", ",", 
        RowBox[{"Thickness", "[", "0.005", "]"}]}], "}"}]}], "}"}]}]}], 
  "]"}]}], "Input",
 CellChangeTimes->{{3.955037933528566*^9, 3.955037948192758*^9}, {
  3.9550379865070972`*^9, 3.955037994938753*^9}, {3.955038176855754*^9, 
  3.955038179629255*^9}, {3.9550387222339973`*^9, 3.955038730454807*^9}, {
  3.95504832109671*^9, 3.955048337508197*^9}, {3.955048531166765*^9, 
  3.955048544784427*^9}, {3.955048752326185*^9, 3.9550487713215322`*^9}, {
