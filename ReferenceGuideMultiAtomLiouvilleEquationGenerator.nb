 CellChangeTimes->{3.965317098837603*^9},
 CellLabel->
  "In[310]:=",ExpressionUUID->"9cca2e19-8eec-494d-babf-9aa2f0358966"],

Cell[TextData[{
 "We wish to generate the master equation for a single ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[InvisiblePrefixScriptBase]", "87"], "Rb"}], 
   TraditionalForm]],ExpressionUUID->"f8667605-c45d-4457-8fba-0612683968c4"],
 " atom, taking in to account the orbitals 5 ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", 
    RowBox[{"1", "/", "2"}]], TraditionalForm]],ExpressionUUID->
  "667b3bef-25e5-4c23-9dd4-c76c38783c64"],
 ", F=2; 5 ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", 
    RowBox[{"3", "/", "2"}]], TraditionalForm]],ExpressionUUID->
  "fbec765d-3ac9-4746-a123-7952bea5428b"],
 ", F=3 and 5 ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["D", 
    RowBox[{"3", "/", "2"}]], TraditionalForm]],ExpressionUUID->
  "31f7b325-e34b-40b8-9b50-8ffadfa18312"],
 ", F=3. We first obtain the configuration variables produced by \
TransitionLists. Jlist lists  the J value for each level. F list lists the F \
value for each level. mFlist are the ranges for the mF variable for each \
level. levtrlist indicates which levels are coupled by lasers. lasrtrlist \
indicates, for each laser, which levels it couples and the corresponding \
polarization vector."
}], "Text",
 CellChangeTimes->{{3.965413198435312*^9, 3.965413223365117*^9}, {
   3.9654134148727007`*^9, 3.965413428276422*^9}, {3.965470891700315*^9, 
   3.965470907454111*^9}, 3.967289911382855*^9, {3.971290758113042*^9, 
   3.9712907611418753`*^9}, {3.971291104175909*^9, 3.9712911135273933`*^9}, {
   3.971291266904172*^9, 3.971291370312874*^9}, {3.973014360948551*^9, 
   3.973014379561975*^9}},ExpressionUUID->"66b4e9e3-c7a0-4fcb-a457-\
a2d7482b172a"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"na", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Jlist", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     FractionBox["1", "2"], ",", 
     FractionBox["3", "2"], ",", 
     FractionBox["3", "2"]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Flist", "=", 
   RowBox[{"{", 
    RowBox[{"2", ",", "3", ",", "3"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mFlist", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Range", "[", 
      RowBox[{
       RowBox[{"-", "2"}], ",", "2"}], "]"}], ",", 
