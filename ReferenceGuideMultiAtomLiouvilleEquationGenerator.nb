 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Delta]", "2"], TraditionalForm]],ExpressionUUID->
  "150ef060-c66a-42d7-ada1-5df75d7a039a"],
 "}, \[Ellipsis]} contains the parameters for the dipole-dipole interaction.  \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox["tr", 
    RowBox[{"k", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "f10b2da3-53ba-4fd7-a0f2-d08faf852d2d"],
 "={",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "1", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "b54d2a9d-2d49-486a-9733-ab3fdd4291fc"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "1", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "e7243bb4-1ded-4852-abe5-525e55518700"],
 "}, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["tr", 
    RowBox[{"k", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "60df7e74-81b6-49a4-aeb9-a48905d48cb4"],
 "={",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "2", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "d196ef45-2c8b-4df4-9e7a-ddbfd8bdac51"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "2", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "60a36fa2-75f7-4af9-8932-f3f1cd77dded"],
 "} are the two interacting dipole transitions corresponding to the two \
distinct ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "k"], TraditionalForm]],ExpressionUUID->
  "9746ba86-2694-4544-b256-f99e1c8f58ce"],
 "-th and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Beta]", "k"], TraditionalForm]],ExpressionUUID->
  "143ea39d-a033-4199-8f6e-2ab19d99075f"],
 "-th atoms (",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "k"], TraditionalForm]],ExpressionUUID->
  "e9196712-ed68-4677-abf7-7e7148d366f7"],
 "\[NotEqual]",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    SubscriptBox["\[Beta]", "k"]}], TraditionalForm]],ExpressionUUID->
  "19161af1-2ac6-476d-8338-ba6edee4dba4"],
 "). The strength of the interaction is given by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalOmega]", "k"], ".", " "}], TraditionalForm]],
  ExpressionUUID->"728063c4-7633-4eee-832c-d35c11f73639"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Delta]", "k"], TraditionalForm]],ExpressionUUID->
  "5705d46e-3bd9-4014-8fae-a56cdfff7e2b"],
 " is the detuning between these two transitions. For ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Delta]", "k"], TraditionalForm]],ExpressionUUID->
  "cdae4a9a-648c-4f1a-9515-990baef302a7"],
 " to be significant, it must be much smaller than both energy transitions \
themselves. Usually ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Delta]", "k"], TraditionalForm]],ExpressionUUID->
  "f34f705e-daf7-4a5f-82ea-7ddf6293fde3"],
 "=0. transCE and transdd might be empty lists in case there are no \
light-matter interactions or/and there are no dipole-dipole interactions. The \
configuration variable transLi = {{",
 Cell[BoxData[
  FormBox[
   SubscriptBox["tr", 
    RowBox[{"1", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "aad16278-1195-45cc-b87b-9d4885434a60"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["tr", 
    RowBox[{"1", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "98a26295-dcc8-4c22-b1a6-8e5e60874881"],
