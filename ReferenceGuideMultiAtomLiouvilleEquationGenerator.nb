Cell["\<\
Plot the real part of the Green\[CloseCurlyQuote]s function as a function of \
the distance between atoms. First we define the dipole matrix elements \
considering that both belong to the same transition\
\>", "Text",
 CellChangeTimes->{{3.954878267343335*^9, 3.954878302452935*^9}, {
  3.9550228120733747`*^9, 3.955022812792588*^9}, {3.965305034952674*^9, 
  3.965305068248769*^9}, {3.9653051364750757`*^9, 3.965305259962713*^9}, {
  3.965305300518214*^9, 3.965305340668613*^9}, {3.96530540082684*^9, 
  3.965305408632818*^9}, {3.965305475001536*^9, 3.965305475821154*^9}, {
  3.965305753689602*^9, 3.965305758677067*^9}, {3.965305798611388*^9, 
  3.9653058211371393`*^9}, {3.965398817953855*^9, 3.96539882219979*^9}, {
  3.965398908808282*^9, 3.96539895189121*^9}, {3.965399009564953*^9, 
  3.965399032671966*^9}, {3.96539914443134*^9, 3.965399226493723*^9}, {
  3.968248419370947*^9, 3.968248422456901*^9}, {3.968248482042006*^9, 
  3.968248485581057*^9}, {3.968248638850754*^9, 3.968248696996821*^9}, {
  3.968248739903627*^9, 3.968248811603243*^9}, {3.968249178076486*^9, 
  3.968249178663537*^9}},ExpressionUUID->"efdee159-7ef1-43cb-84c6-\
777601bb3419"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"p1", "=", 
   RowBox[{"{", 
    RowBox[{
     FractionBox["1", 
      SqrtBox["3"]], ",", 
     FractionBox["\[ImaginaryI]", 
      SqrtBox["3"]], ",", "0"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p2", "=", 
   RowBox[{"{", 
    RowBox[{
     FractionBox["1", 
      SqrtBox["3"]], ",", 
     FractionBox["\[ImaginaryI]", 
      SqrtBox["3"]], ",", "0"}], "}"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.968248703212574*^9, 3.9682487368096457`*^9}, {
