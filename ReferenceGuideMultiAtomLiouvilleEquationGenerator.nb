Cell[TextData[{
 "Generate the far-field operators of the two possible transitions of two ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["\[InvisiblePrefixScriptBase]", "87"], "Rb"}], 
   TraditionalForm]],ExpressionUUID->"ce7ba9fb-a58c-44a0-b361-129602783fac"],
 " atoms, taking in to account the orbitals 5 ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", 
    RowBox[{"1", "/", "2"}]], TraditionalForm]],ExpressionUUID->
  "c0731cc1-7aaf-4d4b-b914-a30b22b0cf5f"],
 "F=2, 5 ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", 
    RowBox[{"3", "/", "2"}]], TraditionalForm]],ExpressionUUID->
  "f59e444a-70b5-4fb3-b540-7e3f06f44275"],
 "F=3 and 5 ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["D", 
    RowBox[{"3", "/", "2"}]], TraditionalForm]],ExpressionUUID->
  "af66ec97-4e9a-4fa2-87e8-676941a4e7b8"],
 "F=3. We first obtain some of the configuration variables needed for \
FarField from TransitionLists"
}], "Text",
 CellChangeTimes->{{3.954878267343335*^9, 3.954878302452935*^9}, {
  3.9550228120733747`*^9, 3.955022812792588*^9}, {3.965305034952674*^9, 
  3.965305068248769*^9}, {3.9653051364750757`*^9, 3.965305259962713*^9}, {
  3.965305300518214*^9, 3.965305340668613*^9}, {3.96530540082684*^9, 
  3.965305408632818*^9}, {3.965305475001536*^9, 3.965305475821154*^9}, {
  3.965305753689602*^9, 3.965305758677067*^9}, {3.965305798611388*^9, 
  3.9653058211371393`*^9}, {3.965398817953855*^9, 3.96539882219979*^9}, {
  3.965398908808282*^9, 3.96539895189121*^9}, {3.965399009564953*^9, 
  3.965399032671966*^9}, {3.96539914443134*^9, 
  3.965399226493723*^9}},ExpressionUUID->"647adad7-6df0-4ca6-8ad2-\
d1e2b2d09c52"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"na", "=", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Jlist", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     FractionBox["1", "2"], ",", 
     FractionBox["3", "2"], ",", 
     FractionBox["3", "2"]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Flist", "=", 
   RowBox[{"{", 
    RowBox[{"2", ",", "3", ",", "3"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mFlist", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Range", "[", 
      RowBox[{
       RowBox[{"-", "2"}], ",", "2"}], "]"}], ",", 
     RowBox[{"Range", "[", 
      RowBox[{
       RowBox[{"-", "3"}], ",", "3"}], "]"}], ",", " ", 
     RowBox[{"Range", "[", 
      RowBox[{
       RowBox[{"-", "3"}], ",", "3"}], "]"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"levtrlist", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"2", ",", "3"}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"lasertrlist", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         FractionBox["1", 
          SqrtBox["2"]], ",", 
         RowBox[{"-", 
          FractionBox["\[ImaginaryI]", 
           SqrtBox["2"]]}], ",", "0"}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         FractionBox["1", 
          SqrtBox["2"]], ",", 
         FractionBox["\[ImaginaryI]", 
          SqrtBox["2"]], ",", "0"}], "}"}]}], "}"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"{", 
    RowBox[{
    "levels", ",", " ", "transitions", ",", " ", "transdd", ",", " ", 
     "transLi", ",", " ", "transCE"}], "}"}], "=", 
   RowBox[{"TransitionLists", "[", 
    RowBox[{
     FractionBox["3", "2"], ",", "Jlist", ",", "Flist", ",", "mFlist", ",", 
     "levtrlist", ",", "lasertrlist", ",", "na", ",", " ", "R", ",", " ", 
     "\[CapitalDelta]\[Epsilon]", ",", " ", "\[Delta]", ",", "\[Phi]", ",", 
     " ", "\[Gamma]", ",", " ", "F", ",", " ", "G"}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.965305422997344*^9, 3.965305533417433*^9}, {
  3.965305658792672*^9, 3.965305762683863*^9}, {3.965306152954194*^9, 
  3.965306198731835*^9}, {3.9653990781641817`*^9, 3.9653990786176043`*^9}},
 CellLabel->"In[28]:=",ExpressionUUID->"65e91447-0d1b-4e4a-af9f-e7d00f38ba13"],

Cell[TextData[{
 "In this case there are three groups of orbitals. These are indexed as \
follows:\n1, characterized by the quantum numbers ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["j", "1"], TraditionalForm]],ExpressionUUID->
  "daab333d-8e8c-4b3f-bb8d-b61b36e4e19c"],
 "=1/2 and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["f", "1"], TraditionalForm]],ExpressionUUID->
  "7faa60b9-d3a0-4c07-a26d-88e8aea7d213"],
 "=2.\n2, characterized by the quantum numbers ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["j", "2"], TraditionalForm]],ExpressionUUID->
  "b046a501-2d06-4c5f-9526-7c79e53af243"],
 "=3/2 and  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["f", "2"], TraditionalForm]],ExpressionUUID->
  "41d9968b-6e9c-4717-8d07-3c54efce2142"],
 "=3\n3, characterized by the quantum numbers ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["j", "3"], TraditionalForm]],ExpressionUUID->
  "6f3198f6-c27a-4754-8142-8bfa6f4d56ff"],
 "=3/2 and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["f", "3"], TraditionalForm]],ExpressionUUID->
  "8707e032-d936-4535-b319-693001be3ecc"],
 "=3.\nEach one of them is composed of the orbitals specified in the variable \
levels. The orbitals in group 1 are"
}], "Text",
 CellChangeTimes->{{3.954934577830982*^9, 3.954934666984077*^9}, {
  3.954934791806799*^9, 3.95493488777148*^9}, {3.954935370006019*^9, 
