    RowBox[{"k", ",", "2", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "8591d5c5-e4a8-48bd-90ba-89067a3377b8"],
 "} are the two interacting dipole transitions ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "1", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "7e3c59f3-6503-468e-94a8-88be28614cab"],
 "\[RightArrow] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "1", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "f58a55a3-0b24-41c7-88d9-c50b955a091f"],
 " (between the quantum levels tagged as ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "1", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "7c13861b-f95b-4fa4-813c-7d0b4a4da6c9"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "1", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "fac967e3-fba1-423f-b084-1055d77b2bc5"],
 ") and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "2", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "14433df0-7360-4df6-a6d3-f761bb1e0338"],
 "\[RightArrow] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "2", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "1f7773bc-3cea-441f-8709-a6dbb6f6f6d6"],
 " (between the quantum levels tagged as ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "2", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "93307222-78f0-41a1-8b01-0f30978d314e"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "2", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "4d2390c6-44cc-41bd-ad80-4cdf8a1990b3"],
 ") of the two distinct ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "k"], TraditionalForm]],ExpressionUUID->
  "27305849-0594-4bc5-b8ec-abc5b671562d"],
 "-th and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Beta]", "k"], TraditionalForm]],ExpressionUUID->
  "876e355f-19e0-46a8-a491-982936f1e81a"],
 "-th atoms. The strength of the interaction is given by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", "k"], ".", " "}], TraditionalForm]],
  ExpressionUUID->"31c5180a-9c93-443f-afb0-09192a707947"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Delta]", "k"], TraditionalForm]],ExpressionUUID->
  "84f62950-1f16-43e6-b30d-dbdb1deef6d8"],
 " is the detuning between these two transitions. These usually vanish, i.e. ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Delta]", "k"], TraditionalForm]],ExpressionUUID->
  "c03e6027-3c69-4b5d-be7b-5db53afda61e"],
 "=0."
}], "Text",
