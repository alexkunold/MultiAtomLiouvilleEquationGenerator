 CellLabel->"In[53]:=",ExpressionUUID->"f1b09c72-0b5c-440e-b025-ac506c1e8610"],

Cell["\<\
Assuming that the coupling corresponds to two atoms along the y axis\
\>", "Text",
 CellChangeTimes->{{3.968248846280694*^9, 
  3.968248871536087*^9}},ExpressionUUID->"70515177-7b11-4a1a-ba51-\
6eefc9bc7ea6"],

Cell[BoxData[
 RowBox[{
