 ButtonBox["\<\"Content\"\>",
  Appearance->Automatic,
  BaseStyle->{FontColor -> RGBColor[
      Rational[1, 3], 
      Rational[1, 3], 1]},
  ButtonFunction:>NotebookLocate["Content"],
  Evaluator->Automatic,
  Method->"Preemptive"]], "Output",
 CellChangeTimes->{
  3.967476292796187*^9},ExpressionUUID->"40dfb794-3439-417a-bff0-\
dcf147c2a862"]], "Text",
 CellChangeTimes->{
  3.967476614227085*^9},ExpressionUUID->"40e62806-644e-487a-ba52-\
cc279691fefb"],

Cell[CellGroupData[{

Cell["A single two-level atom", "Subtitle",
 CellChangeTimes->{{3.965227025287992*^9, 3.965227035576562*^9}, 
   3.965227158581449*^9},
 CellTags->
  "A single two-level \
atom",ExpressionUUID->"07031bd8-0ff4-4ff2-bee5-5616bc0d87cc"],

Cell["\<\
We set up the master equation for a single two-level atom. Using this \
solution, we plot the time dependence of the quantum-level populations. We \
also compute the emission as a function of the laser detuning.\
\>", "Text",
 CellChangeTimes->{{3.9653150299923987`*^9, 3.96531516100245*^9}, 
   3.965315306607422*^9, {3.9748901943308992`*^9, 
   3.974890195763776*^9}},ExpressionUUID->"ed3d9663-a79c-4ca3-b7fd-\
19bb5e969df4"],

Cell[TextData[Cell[BoxData[
 ButtonBox["\<\"Content\"\>",
  Appearance->Automatic,
  BaseStyle->{FontColor -> RGBColor[
      Rational[1, 3], 
      Rational[1, 3], 1]},
  ButtonFunction:>NotebookLocate["Content"],
  Evaluator->Automatic,
  Method->"Preemptive"]], "Output",
 CellChangeTimes->{
  3.967476292796187*^9},ExpressionUUID->"33444adb-f419-4933-a067-\
d1ad3ef38cfe"]], "Text",
 CellChangeTimes->{
  3.967476632961639*^9},ExpressionUUID->"65b8afce-1004-43e4-9763-\
25adb4c47943"],

Cell[CellGroupData[{

Cell["Example", "Subsubsection",
 CellChangeTimes->{{3.965315181522459*^9, 
  3.965315182521527*^9}},ExpressionUUID->"2b82ab89-0b89-4495-8442-\
b78d4e7c7859"],

Cell["Load MultiAtomLiouvilleEquationGenerator", "Text",
 CellChangeTimes->{{3.964876966723848*^9, 
  3.964876976051291*^9}},ExpressionUUID->"85a4d750-0dcc-4540-8d55-\
f13c9d24c8f7"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
  "SetDirectory", "[", "PathToMultiAtomLiouvilleEquationGenerator", "]"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"Needs", "[", "\"\<MultiAtomLiouvilleEquationGenerator`\>\"", 
  "]"}]}], "Input",
 CellChangeTimes->{3.965227251574109*^9, 3.965227291922023*^9, 
  3.965317068856021*^9},
 CellLabel->
  "In[165]:=",ExpressionUUID->"36421a79-8856-49e7-8e00-4511ccf5428f"],

Cell["\<\
We start by setting the matrix basis. We set  the number of atoms (na) and \
the number of quantum levels (nl) per atom.  We then set the dimension of the \
Hilbert space (n) , define the basis (h) and create the time-dependent \
density matrix coefficients (\[Rho][t])\
\>", "Text",
 CellChangeTimes->{{3.964870476853927*^9, 3.964870506502221*^9}, {
   3.964872674609602*^9, 3.9648726790460873`*^9}, {3.966343004745277*^9, 
   3.9663430052708073`*^9}, {3.971287078470808*^9, 3.971287099960805*^9}, {
   3.971287980044429*^9, 3.9712880826851053`*^9}, 
   3.971290084459866*^9},ExpressionUUID->"31214b28-6a70-40b8-9b58-\
ef3069fe8c5f"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"na", "=", "1"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"nl", "=", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"n", " ", "=", " ", 
   SuperscriptBox["nl", 
    RowBox[{"2", "na"}]]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"h", "=", 
  RowBox[{"MultiAtomBasis", "[", 
   RowBox[{"nl", ",", "na"}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"rho", "=", 
  RowBox[{"SparseArray", "[", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"ii", "->", 
      RowBox[{
       SubscriptBox["\[Rho]", "ii"], "[", "t", "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"ii", ",", "1", ",", "n"}], "}"}]}], "]"}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.964870511766149*^9, 3.964870537030835*^9}, {
  3.964870598238103*^9, 3.964870625368714*^9}, {3.964872685349288*^9, 
  3.964872785377911*^9}, {3.964872944481517*^9, 3.964872945287474*^9}},
 CellLabel->
  "In[167]:=",ExpressionUUID->"3bc4d4c8-ac81-497d-99a6-7eb8515bdb4e"],

