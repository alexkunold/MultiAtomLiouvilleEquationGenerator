Cell[CellGroupData[{

Cell["Example", "Subsubsection",
 CellChangeTimes->{{3.954934528317594*^9, 3.9549345300556*^9}, 
   3.964030663339798*^9},ExpressionUUID->"00775db9-e753-413f-8b0e-\
ed029072d6ff"],

Cell[TextData[{
 "Generate the Hamiltonian for a system consisting of two (na=2) three level \
(nl=3) atoms subject to two lasers with Rabi parameters ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "1"], TraditionalForm]],ExpressionUUID->
  "bdf58bf0-214e-4483-9480-6b263ec5b1a5"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "2"], TraditionalForm]],ExpressionUUID->
  "7207d0ce-41ef-4b1d-b367-7628daa61c67"],
 " and detuning parameters ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalDelta]", "1"], TraditionalForm]],ExpressionUUID->
  "2a4dcc22-1b3c-4ce7-b31a-683d4ec3588b"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalDelta]", "2"], TraditionalForm]],ExpressionUUID->
  "2e451828-4f78-412e-8906-ac77ac61d96b"],
 ", respectively. The first laser couples the states \[VerticalSeparator]1\
\[RightAngleBracket] and \[VerticalSeparator]2\[RightAngleBracket] with a \
Rabi parameter ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "1"], TraditionalForm]],ExpressionUUID->
  "600ebc4b-9cd4-47f5-898f-f2170230e228"],
 " and the second couples \[VerticalSeparator]2\[RightAngleBracket] and \
\[VerticalSeparator]3\[RightAngleBracket] with a Rabi parameter ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "2"], TraditionalForm]],ExpressionUUID->
  "e62e9530-2728-4130-8e3d-8c35a78d1b04"],
 " for both atoms. Both atoms are at different positions along the \
light-propagation direction and therefore have a phase difference \[Phi]. The \
transCE variable that describes this light-matter interaction is"
}], "Text",
 CellChangeTimes->{{3.954934577830982*^9, 3.954934666984077*^9}, {
  3.954934791806799*^9, 3.95493488777148*^9}, {3.954935370006019*^9, 
  3.954935373498506*^9}, {3.954935556056313*^9, 3.954935600422351*^9}, {
  3.954942537342256*^9, 3.954942578376485*^9}, {3.9549427153918667`*^9, 
  3.954942906391176*^9}, {3.954942937754725*^9, 3.954943027463854*^9}, {
  3.954943883336549*^9, 3.9549439062399797`*^9}, {3.954944165431011*^9, 
  3.954944225207417*^9}, {3.954944258618572*^9, 
  3.95494430743131*^9}},ExpressionUUID->"d6031954-aa0f-4e5e-a5c8-\
cee8e2e8f11e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"transCE", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], ",", "1", ",", " ", 
       SubscriptBox["R", "1"], ",", " ", 
       SubscriptBox["\[CapitalDelta]", "1"], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], ",", "2", ",", " ", 
       SubscriptBox["R", "1"], ",", " ", 
       SubscriptBox["\[CapitalDelta]", "1"], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "3"}], "}"}], ",", "1", ",", " ", 
       SubscriptBox["R", "2"], ",", " ", 
       SubscriptBox["\[CapitalDelta]", "2"], ",", "\[Phi]"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "3"}], "}"}], ",", "2", ",", " ", 
       SubscriptBox["R", "2"], ",", " ", 
       SubscriptBox["\[CapitalDelta]", "2"], ",", "\[Phi]"}], "}"}]}], 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.954934673092539*^9, 3.954934702241617*^9}, {
  3.954934779155659*^9, 3.954934779301485*^9}, {3.9549348453122*^9, 
  3.954934853986453*^9}, {3.954935610882814*^9, 3.954935613829378*^9}, {
  3.9549429109365587`*^9, 3.954942921127887*^9}, {3.954943031222378*^9, 
  3.954943120861352*^9}, {3.95494321025631*^9, 3.9549432284364448`*^9}, {
  3.954943293200025*^9, 3.954943356527552*^9}, {3.954943505108894*^9, 
  3.954943590515995*^9}, {3.954943742662021*^9, 3.954943750531349*^9}, {
  3.9549441186025457`*^9, 3.954944133903529*^9}},
 CellLabel->"In[22]:=",ExpressionUUID->"ce19680a-26bb-411e-94d5-e3e2dee42de8"],

Cell["\<\
Assuming that the transitions \[VerticalSeparator]1\[RightAngleBracket] \
\[RightArrow] \[VerticalSeparator]2\[RightAngleBracket] and \
\[VerticalSeparator]2\[RightAngleBracket] \[RightArrow] \[VerticalSeparator]3\
\[RightAngleBracket] have different energy differences and, therefore, do not \
interact among themselves, the trandd parameter is given by\
\>", "Text",
 CellChangeTimes->{{3.954943757912268*^9, 3.954943860078283*^9}, {
  3.954943915641076*^9, 
  3.9549439395929527`*^9}},ExpressionUUID->"9be43007-f821-4dc7-a2cf-\
0ea0da967644"],

Cell[BoxData[
 RowBox[{
  RowBox[{"transdd", "=", 
   RowBox[{"transdd", "=", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", "1", ",", "2", ",", 
        SubscriptBox["\[CapitalOmega]", "1"], ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], ",", "1", ",", "2", ",", 
        SubscriptBox["\[CapitalOmega]", "2"], ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"1", ",", "2"}], "}"}], ",", "2", ",", "1", ",", 
        SubscriptBox["\[CapitalOmega]", "1"], ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], ",", " ", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], ",", "2", ",", "1", ",", 
        SubscriptBox["\[CapitalOmega]", "2"], ",", "0"}], "}"}]}], "}"}]}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.96394558288769*^9, 3.96394561249136*^9}},
 CellLabel->"In[23]:=",ExpressionUUID->"39142ea4-bd08-47f3-b9d9-f865cf48d8d3"],

Cell["The Hamiltonian is generated with", "Text",
 CellChangeTimes->{{3.95493475727353*^9, 3.954934764219641*^9}, {
  3.9549402790945473`*^9, 3.95494028553578*^9}, {3.954943971074165*^9, 
  3.954943983108457*^9}},ExpressionUUID->"ed4d6591-ffac-4570-9a37-\
63624de5f18d"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ham", "=", 
  RowBox[{"Ham", "[", 
   RowBox[{
   "transCE", ",", " ", "transdd", ",", " ", "3", ",", " ", "2", ",", " ", 
    "t"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.954934770233245*^9, 3.954934774708423*^9}, 
   3.954935623131463*^9, {3.954943993355521*^9, 3.954944014403923*^9}, {
   3.95494432382261*^9, 3.954944325088129*^9}},
 CellLabel->"In[24]:=",ExpressionUUID->"4433e99b-f40b-4cb9-aff5-77447329c3c2"],

