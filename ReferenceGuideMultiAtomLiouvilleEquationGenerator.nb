Cell[TextData[{
 "The only  transitions with non-vanishing dipole matrix elements are  \
\[VerticalSeparator]1\[RightAngleBracket] \[RightArrow]\[VerticalSeparator]2\
\[RightAngleBracket] and \[VerticalSeparator]2\[RightAngleBracket] \
\[RightArrow]\[VerticalSeparator]3\[RightAngleBracket]. The transition  \
\[VerticalSeparator]1\[RightAngleBracket] \[RightArrow]\[VerticalSeparator]2\
\[RightAngleBracket] is labeled as transition 1, and the transition  \
\[VerticalSeparator]2\[RightAngleBracket] \[RightArrow]\[VerticalSeparator]3\
\[RightAngleBracket] is labeled as transition 2. The strengths of the \
corresponding decay rates are denoted accordingly: ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "1"], TraditionalForm]],ExpressionUUID->
  "12bc66de-75b4-4be2-a4bb-a748a5c17ff9"],
 " is the rate due to the dipole element of the transition 1 if a single atom \
is involved, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", 
    RowBox[{"1", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "6a1b3ac7-9f5b-48b0-acf8-3955481b8dbc"],
 " is the rate due to the dipole element of the transition 1 when two \
different atoms are involved,  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "2"], TraditionalForm]],ExpressionUUID->
  "55787db5-1eec-4532-8c74-7db8cee0e174"],
 " is the rate due to the dipole element of the transition 2 if a single atom \
is involved and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", 
    RowBox[{"2", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "1c5517d2-401a-4783-9c4c-18681077655b"],
 " is the rate due to the dipole element of the transition 2 when two \
different atoms are involved. The transLi configuration variable is thus \
given by"
}], "Text",
 CellChangeTimes->{{3.963769409499422*^9, 3.963769421166786*^9}, {
   3.963769497910138*^9, 3.96376951499914*^9}, {3.964868680243566*^9, 
   3.964868695784617*^9}, {3.964868731710349*^9, 3.964868740373434*^9}, 
   3.964868778218131*^9, {3.964868812772867*^9, 3.964868865002063*^9}, {
   3.97861165780951*^9, 
   3.978611684006341*^9}},ExpressionUUID->"188ad194-6d43-4403-b8a1-\
f7f25e95fdc7"],

