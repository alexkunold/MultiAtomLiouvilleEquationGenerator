Cell[CellGroupData[{

Cell["LiouvilleAdjointMasterEquation", "Subtitle",
 CellFrame->{{0, 0}, {0, 0.5}},
 CellFrameColor->GrayLevel[0.75],
 CellChangeTimes->{{3.954878763717317*^9, 3.9548787647156553`*^9}, 
   3.954935460414412*^9, {3.954940426468688*^9, 3.954940427257826*^9}, {
   3.95494452029814*^9, 3.954944521619375*^9}, 3.954953213995235*^9, {
   3.954956615527276*^9, 3.954956617965029*^9}, {3.954959646489932*^9, 
   3.9549596518557587`*^9}, {3.955023187679504*^9, 3.955023188726391*^9}, {
   3.9550277873586273`*^9, 3.9550277894759407`*^9}, {3.955034894987132*^9, 
   3.955034896619713*^9}, {3.95504997174227*^9, 3.955049975311408*^9}, {
   3.955050428675227*^9, 3.955050431758748*^9}},
 CellTags->
  "LiouvilleAdjointMasterEquation",ExpressionUUID->"ff65014c-49df-44d1-b299-\
f811ff55c84e"],

Cell[TextData[{
 "LiouvilleAdjointMasterEquation[q, Lit, t] : q, Lit \[Element] SparseArray,  \
t is a Mathematica symbol that represents the time variable\nReturns a List \
of dimension  Length[q] = Length[Li] that contains the Liouville differential \
equations that correspond to the adjoint Liouville superoperator Lit which \
includes both the adjoint Lindbladian and Hamiltonian parts generated using \
LiouvilleCommutator and LiouvilleLindbladianDagger. The variable q should \
represent Tr[h(t) \[Rho](0)] or the expectation value \[LeftAngleBracket]",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Psi]", "0"], TraditionalForm]],ExpressionUUID->
  "2f39608f-d4ce-489c-aba8-db333b550adc"],
 "\[VerticalSeparator]h(t)\[VerticalSeparator]",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Psi]", "0"], TraditionalForm]],ExpressionUUID->
  "39649c0c-2773-484d-bfaa-28147baa411d"],
 "\[RightAngleBracket] where \[Rho](0) and \[VerticalSeparator]",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Psi]", "0"], TraditionalForm]],ExpressionUUID->
  "d327118f-7d20-4a87-9223-8b6286ef4bc6"],
 "\[RightAngleBracket] denote the initial density matrix and the initial pure \
state of the system, respectively, and h(t) are the Heisemberg picture \
operators of the  basis h generated using MultiAtomBasis."
}], "Text",
 CellChangeTimes->{{3.954878897778723*^9, 3.954878905190978*^9}, {
