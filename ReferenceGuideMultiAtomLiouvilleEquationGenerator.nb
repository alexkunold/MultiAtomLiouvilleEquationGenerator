  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"18f9a14b-0324-4016-bcd9-090828b8dc79"],
 " Ingeters\nReturns a SparseArray with the adjoint jump operator \
\[VerticalSeparator]",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["tr", "2"], "\[RightAngleBracket]"}], TraditionalForm]],
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"b2f92ce1-0b97-49e8-8d72-9e961b5a8dc7"],
 "\[LeftAngleBracket]",
 Cell[BoxData[
  FormBox[
   SubscriptBox["tr", "1"], TraditionalForm]],
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"93e83795-041e-4ba0-8657-429087a19e27"],
 "\[VerticalSeparator] between states \[VerticalSeparator]",
 Cell[BoxData[
  FormBox[
   SubscriptBox["tr", "1"], TraditionalForm]],ExpressionUUID->
  "1482d2ad-a9b7-474e-bc6b-bc08e4ebef95"],
 Cell[BoxData[
