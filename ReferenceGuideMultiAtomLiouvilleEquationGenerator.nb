Cell[CellGroupData[{

Cell["LiouvilleLindbladian", "Subtitle",
 CellFrame->{{0, 0}, {0, 0.5}},
 CellFrameColor->GrayLevel[0.75],
 CellChangeTimes->{{3.954878763717317*^9, 3.9548787647156553`*^9}, 
   3.954935460414412*^9, {3.954940426468688*^9, 3.954940427257826*^9}, {
   3.95494452029814*^9, 3.954944521619375*^9}, 3.954953213995235*^9, {
   3.954956615527276*^9, 3.954956617965029*^9}, {3.954959646489932*^9, 
   3.9549596518557587`*^9}},
 CellTags->
  "LiouvilleLindbladian",ExpressionUUID->"94d60b92-1436-495b-876b-\
1bb1f975b8ea"],

Cell[TextData[{
 "LiouvilleLindbladian[h, transLi, nl, na] : h \[Element] SparseArray, \
transLi \[Element] List, nl, na \[Element] Integers\nLiouvilleLindbladian[h, \
transLi, nl, na, t] : h \[Element] SparseArray, transLi \[Element] List, nl, \
na \[Element] Integers, t is a Mathematica symbol that represents the time \
variable\nReturns a SparseArray of dimension  Length[h] that contains the \
Liouville superoperator corresponding to the Lindbladian of the master \
equation.  na and nl are the numbers of atoms and quantum levels of the \
system. h is the SparseArray that contains the matrix basis generated with \
MultiAtomBasis.The variable transLi = {{",
 Cell[BoxData[
  FormBox[
   SubscriptBox["tr", 
    RowBox[{"1", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "eb5e26c9-1feb-405a-b1be-4191c8093452"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["tr", 
    RowBox[{"1", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "477efe6b-85fc-4592-8ca7-0257281aefa8"],
 "}, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "1"], TraditionalForm]],ExpressionUUID->
  "fa615189-99ce-46ae-9c39-bbfba27bee8e"],
 ",  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Beta]", "1"], TraditionalForm]],ExpressionUUID->
  "2313a4bf-fdc5-4ea7-ae8a-809363c53f48"],
 ",  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "1"], TraditionalForm]],ExpressionUUID->
  "cd57360f-656d-4987-82be-a2eb4516bfad"],
 " , ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Delta]", "1"], TraditionalForm]],ExpressionUUID->
  "ebf2f016-408f-4b1b-ad92-c15cab6c27ec"],
 "}, {",
 Cell[BoxData[
  FormBox[
   SubscriptBox["tr", 
    RowBox[{"2", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "cde87700-e599-4c8f-b734-8a182749e42a"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["tr", 
    RowBox[{"2", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "26e4b496-bfcd-4a39-8ca3-de3335381e74"],
 "}, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "2"], TraditionalForm]],ExpressionUUID->
  "3e547734-60b2-491b-891a-4e1eb293f75c"],
 ",  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Beta]", "2"], TraditionalForm]],ExpressionUUID->
  "e2b9d5a3-d72d-463e-8f90-79db329687ac"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "2"], TraditionalForm]],ExpressionUUID->
  "51ee17b1-5a2b-4ac7-b6bc-e6ae98a87b3c"],
 " ,",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    SubscriptBox["\[Delta]", "2"]}], TraditionalForm]],ExpressionUUID->
  "48cd0cdd-40bc-455f-94c4-6e5b264acc4a"],
 "}, \[Ellipsis]} contains the parameters for the dipole-dipole interaction.  \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox["tr", 
    RowBox[{"k", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "88a43eef-4297-4ef9-8a37-b48588bf2723"],
 "={",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "1", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "65e37b01-7461-4962-96c3-54a8e335d616"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "1", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "983cf574-00ac-4dad-b25b-0839644a9b4b"],
 "}, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["tr", 
    RowBox[{"k", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "3d6dd652-c77b-4dfa-9ffa-54184caa811e"],
 "={",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "2", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "fae08bdd-c951-4c18-aef6-d0839aa3240e"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "2", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "0ef95a76-2c7c-49b6-bf10-a941d67a14b6"],
 "} are the two interacting dipole transitions ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "1", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "5dea234e-f3b7-4bc4-a948-8702012c9f5a"],
 "\[RightArrow] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "1", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "ed8ff152-aaab-44be-8728-f4b723a9dddd"],
 " (between the quantum levels tagged as ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "1", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "b5b22e22-6585-42d8-9fe8-85611112cf6c"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "1", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "202f03c0-3d66-47d6-a96b-32b3405e9031"],
 ") and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "2", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "9555615c-7356-4c3b-ac20-759375094886"],
 "\[RightArrow] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "2", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "5bb3fcbb-c91a-47ff-bb7e-3b04d4d1d995"],
 " (between the quantum levels tagged as ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "2", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "f0782043-8006-43b5-8744-43d6080f08d6"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "2", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "77e04b31-d311-40be-bb12-98e6afd65a63"],
 ") of the two distinct ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "k"], TraditionalForm]],ExpressionUUID->
  "6c8db655-3ed4-42c6-938e-7c80854c2d2a"],
 "-th and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Beta]", "k"], TraditionalForm]],ExpressionUUID->
  "8041d59b-5825-4e95-9b5a-ff412117e830"],
 "-th atoms. The strength of the interaction is given by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", "k"], ".", " "}], TraditionalForm]],
  ExpressionUUID->"c5a16a84-1f3e-4aa9-b70e-b139a84abbbc"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Delta]", "k"], TraditionalForm]],ExpressionUUID->
  "9f84b720-be9f-46d9-b507-2a033b32e643"],
 " is the detuning between these two transitions. These usually vanish, i.e. ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Delta]", "k"], TraditionalForm]],ExpressionUUID->
  "e82de230-3e00-4d00-b20f-63450ee1ec60"],
 "=0. In this case, the time variable t can be omitted as an argument of \
LiouvilleLindbladian."
}], "Text",
 CellChangeTimes->{{3.954878897778723*^9, 3.954878905190978*^9}, {
   3.954878942620962*^9, 3.954878970514427*^9}, {3.95487900917933*^9, 
