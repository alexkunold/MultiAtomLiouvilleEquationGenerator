        RowBox[{"Thickness", "[", "0.02", "]"}], ",", "LightBlue"}], "]"}], 
      ",", 
      RowBox[{"Directive", "[", 
       RowBox[{
        RowBox[{"Thickness", "[", "0.005", "]"}], ",", "Blue"}], "]"}]}], 
     "}"}]}]}], "]"}]], "Input",
