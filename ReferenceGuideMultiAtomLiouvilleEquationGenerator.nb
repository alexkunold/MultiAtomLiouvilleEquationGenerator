Cell[CellGroupData[{

Cell["Examples", "Subsubsection",
 CellChangeTimes->{{3.954934528317594*^9, 
  3.9549345300556*^9}},ExpressionUUID->"a3e49ff9-9d70-454b-9a49-1ea91c979db9"],

Cell[TextData[{
 "Generate the differential equations for the density matrix coefficients \
that arise from a system consisting of two (na=2) three level (nl=3) atoms \
subject to two lasers with Rabi parameters ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "1"], TraditionalForm]],ExpressionUUID->
  "bc700934-988b-4090-a9aa-ab4c4dc168f0"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "2"], TraditionalForm]],ExpressionUUID->
  "a1395cd6-0fe9-4189-937f-7e0a4c2f783f"],
 " and detuning parameters ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalDelta]", "1"], TraditionalForm]],ExpressionUUID->
  "56b7814a-08d3-4c06-96d7-e8fa4b804b25"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalDelta]", "2"], TraditionalForm]],ExpressionUUID->
  "529f49f6-0557-46b4-9e4a-f86d7f6bb001"],
 ", respectively. The first laser couples the states \[VerticalSeparator]1\
\[RightAngleBracket] and \[VerticalSeparator]2\[RightAngleBracket] with a \
Rabi parameter ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "1"], TraditionalForm]],ExpressionUUID->
  "e6f74fbd-e2bd-498d-af3b-897b33fbee3c"],
 " and the second couples \[VerticalSeparator]2\[RightAngleBracket] and \
\[VerticalSeparator]3\[RightAngleBracket] with a Rabi parameter ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "2"], TraditionalForm]],ExpressionUUID->
  "a4800046-7d07-4b0c-9b0b-b82eceb52879"],
 " for both atoms. Both atoms are at different positions along the \
light-propagation direction and therefore have a phase difference \[Phi]. The \
transCE configuration variable that describes this light-matter interaction is"
}], "Text",
 CellChangeTimes->{{3.954934577830982*^9, 3.954934666984077*^9}, {
  3.954934791806799*^9, 3.95493488777148*^9}, {3.954935370006019*^9, 
  3.954935373498506*^9}, {3.954935556056313*^9, 3.954935600422351*^9}, {
  3.954942537342256*^9, 3.954942578376485*^9}, {3.9549427153918667`*^9, 
  3.954942906391176*^9}, {3.954942937754725*^9, 3.954943027463854*^9}, {
  3.954943883336549*^9, 3.9549439062399797`*^9}, {3.954944165431011*^9, 
  3.954944225207417*^9}, {3.954944258618572*^9, 3.95494430743131*^9}, {
  3.955028501608778*^9, 3.955028519257123*^9}, {3.955035411238178*^9, 
  3.955035413371133*^9}, {3.955036308420064*^9, 3.95503641333373*^9}, {
  3.955036473918412*^9, 3.955036498833945*^9}, {3.963769259922654*^9, 
  3.963769290458452*^9}, {3.963769337312436*^9, 3.963769400659548*^9}, {
  3.963769437005883*^9, 
  3.963769437150453*^9}},ExpressionUUID->"a6756fff-236d-4bea-beed-\
5b22ed7fc4a9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"transCE", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], ",", "1", ",", " ", 
       SubscriptBox["R", "1"], ",", " ", 
       SubscriptBox["\[CapitalDelta]", "1"], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], ",", "2", ",", " ", 
       SubscriptBox["R", "1"], ",", " ", 
       SubscriptBox["\[CapitalDelta]", "1"], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "3"}], "}"}], ",", "1", ",", " ", 
       SubscriptBox["R", "2"], ",", " ", 
       SubscriptBox["\[CapitalDelta]", "2"], ",", "\[Phi]"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "3"}], "}"}], ",", "2", ",", " ", 
       SubscriptBox["R", "2"], ",", " ", 
       SubscriptBox["\[CapitalDelta]", "2"], ",", "\[Phi]"}], "}"}]}], 
    "}"}]}], ";"}]], "Input",
 CellLabel->"In[80]:=",ExpressionUUID->"097df7c7-cda1-4dbd-9568-45f1b662b628"],

Cell["\<\
Assuming that the transitions \[VerticalSeparator]1\[RightAngleBracket] \
\[RightArrow] \[VerticalSeparator]2\[RightAngleBracket] and \
\[VerticalSeparator]2\[RightAngleBracket] \[RightArrow] \[VerticalSeparator]3\
\[RightAngleBracket] have different energy differences and, therefore, do not \
interact among themselves, the transdd parameter is given by\
\>", "Text",
 CellChangeTimes->{3.963769453558571*^9, 
  3.964034237514468*^9},ExpressionUUID->"2c629599-b9ff-4aaf-b43f-\
52410ddbfb08"],

Cell[BoxData[
 RowBox[{
  RowBox[{"transdd", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], ",", "1", ",", "2", ",", 
       SubscriptBox["\[CapitalOmega]", "1"], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", "3"}], "}"}], ",", "1", ",", "2", ",", 
       SubscriptBox["\[CapitalOmega]", "2"], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], ",", "2", ",", "1", ",", 
       SubscriptBox["\[CapitalOmega]", "1"], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", "3"}], "}"}], ",", "2", ",", "1", ",", 
       SubscriptBox["\[CapitalOmega]", "2"], ",", "0"}], "}"}]}], "}"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{
  3.963945658183689*^9, {3.963945757960421*^9, 3.963945759143816*^9}},
 CellLabel->"In[81]:=",ExpressionUUID->"7bc615ea-6bfc-43ab-9ed9-334ed9c7a350"],

Cell[TextData[{
 "The only  transitions with non-vanishing dipole matrix elements are  \
\[VerticalSeparator]1\[RightAngleBracket] \[RightArrow]\[VerticalSeparator]2\
\[RightAngleBracket] and \[VerticalSeparator]2\[RightAngleBracket] \
\[RightArrow]\[VerticalSeparator]3\[RightAngleBracket]. The transition  \
\[VerticalSeparator]1\[RightAngleBracket] \[RightArrow]\[VerticalSeparator]2\
\[RightAngleBracket] is tagged with the number 1, and the transition  \
\[VerticalSeparator]2\[RightAngleBracket] \[RightArrow]\[VerticalSeparator]3\
\[RightAngleBracket] is tagged with the number 2. The strength of the dipole \
couplings are tagged accordingly: ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "1"], TraditionalForm]],ExpressionUUID->
  "6e7dd8bd-2040-43b0-8d76-6eec9a71ecfc"],
 " is the coupling due to the dipole element of the transition 1 if only one \
atom is involved, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", 
    RowBox[{"1", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "12c3b4a2-bb72-41c5-aed7-813952a835ec"],
 " is the coupling due to the dipole element of the transition 1 if two \
different atoms are involved,  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "2"], TraditionalForm]],ExpressionUUID->
  "c90afe7d-9cb8-4cc0-b351-1a694d1729f0"],
 " is the coupling due to the dipole element of the transition 2 if only one \
atom is involved and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", 
    RowBox[{"2", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "dca77bc7-fc94-43f7-b715-e349cf54a774"],
 " is the coupling due to the dipole element of the transition 2 if two \
different atoms are involved. The transLi configuration variable is thus \
given by"
}], "Text",
 CellChangeTimes->{{3.963769409499422*^9, 3.963769421166786*^9}, {
  3.963769497910138*^9, 
  3.96376951499914*^9}},ExpressionUUID->"c9b1ce32-c464-4140-b1f3-\
2e72c7d8c124"],

Cell[BoxData[
 RowBox[{
  RowBox[{"transLi", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], ",", "1", ",", "1", ",", 
       SubscriptBox["\[Gamma]", "1"], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], ",", "2", ",", "2", ",", 
       SubscriptBox["\[Gamma]", "1"], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], ",", "1", ",", "2", ",", 
       SubscriptBox["\[Gamma]", 
        RowBox[{"1", ",", "1"}]], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], ",", "2", ",", "1", ",", 
       SubscriptBox["\[Gamma]", 
        RowBox[{"1", ",", "1"}]], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "3"}], "}"}], ",", "1", ",", "1", ",", 
       SubscriptBox["\[Gamma]", "2"], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "3"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "3"}], "}"}], ",", "2", ",", "2", ",", 
       SubscriptBox["\[Gamma]", "2"], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], ",", "1", ",", "2", ",", 
       SubscriptBox["\[Gamma]", 
        RowBox[{"2", ",", "2"}]], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], ",", "2", ",", "1", ",", 
       SubscriptBox["\[Gamma]", 
        RowBox[{"2", ",", "2"}]], ",", "0"}], "}"}]}], "}"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.96376472150296*^9, 3.963764722715586*^9}, {
