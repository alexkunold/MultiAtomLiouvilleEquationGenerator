Cell[CellGroupData[{

Cell["The dressed state evolution operator", "Subtitle",
 CellFrame->{{0, 0}, {0, 0.5}},
 CellFrameColor->GrayLevel[0.75],
 CellChangeTimes->{{3.954878763717317*^9, 3.9548787647156553`*^9}, 
   3.954935460414412*^9, {3.954940426468688*^9, 3.954940427257826*^9}, {
   3.95494452029814*^9, 3.954944521619375*^9}, 3.954953213995235*^9, {
   3.954956615527276*^9, 3.954956617965029*^9}, {3.954959646489932*^9, 
   3.9549596518557587`*^9}, {3.955023187679504*^9, 3.955023188726391*^9}, {
   3.9550277873586273`*^9, 3.9550277894759407`*^9}, {3.955034894987132*^9, 
   3.955034896619713*^9}, {3.95504997174227*^9, 3.955049975311408*^9}, {
   3.963764290116918*^9, 3.963764291509638*^9}, {3.96403184486744*^9, 
   3.964031850967843*^9}, {3.964375236714116*^9, 3.964375279615838*^9}, 
   3.964375681733578*^9, 3.965225142672127*^9, 3.965225379506308*^9},
 CellTags->
  "The dressed state evolution \
operator",ExpressionUUID->"631cf8df-92b3-46c2-aab2-6aec6117fce5"],

Cell["\<\
We illustrate how to transform the solution of the master equation from the \
dressed-state basis to the standard-state basis for a system of two \
three-level atoms. This method provides a way to obtain the explicit form of \
the evolution operator. The resulting solution is shown to be consistent with \
that obtained directly from the master equation in the standard basis.\
\>", "Text",
 CellChangeTimes->{{3.9653159099304247`*^9, 3.965316056533812*^9}, {
   3.965316160628994*^9, 3.965316161538636*^9}, 
   3.965316224460072*^9},ExpressionUUID->"05f2272d-0360-40be-8cdd-\
3a9be789b8ab"],

Cell[TextData[Cell[BoxData[
 ButtonBox["\<\"Content\"\>",
  Appearance->Automatic,
  BaseStyle->{FontColor -> RGBColor[
      Rational[1, 3], 
      Rational[1, 3], 1]},
  ButtonFunction:>NotebookLocate["Content"],
  Evaluator->Automatic,
  Method->"Preemptive"]], "Output",
 CellChangeTimes->{
  3.967476292796187*^9},ExpressionUUID->"ecbad068-751c-45a6-8d90-\
e22686ef370c"]], "Text",
 CellChangeTimes->{
  3.9674766729097652`*^9},ExpressionUUID->"58cb42da-6930-40b7-a4e7-\
af1b9d3a73e4"],

