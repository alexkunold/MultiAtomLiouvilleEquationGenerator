  3.964533931961261*^9, 3.964695781529866*^9, 3.964711833204875*^9, 
  3.964783525964068*^9, 3.964785160613293*^9, 3.96478600053758*^9, 
  3.964793607827842*^9, 3.964795463477751*^9, 3.964796074806718*^9, 
  3.967288392763026*^9, 3.967477508619614*^9},
 CellLabel->
  "Out[374]=",ExpressionUUID->"21b0ee88-35f8-4bd2-a307-41e1c7ae2e9d"]
}, Open  ]],

Cell["\<\
and use them to convert the results from the rotating frame to the standard \
basis\
\>", "Text",
 CellChangeTimes->{{3.964377574581027*^9, 
  3.964377592362548*^9}},ExpressionUUID->"e6c0e7fb-9f75-4c9d-8d20-\
c87feabb92d2"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Rho]0", "=", 
   RowBox[{"SparseArray", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "1"}], "}"}], "->", "1"}], ",", "9"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rhot", "=", 
   RowBox[{"URT", ".", "VRD", ".", "UR", ".", 
    RowBox[{"Proj", "[", 
     RowBox[{"h", ",", "\[Rho]0"}], "]"}]}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.964378358665801*^9, 3.964378372243167*^9}, {
  3.9643784604461603`*^9, 3.9643784732361*^9}, {3.964378606111863*^9, 
  3.96437862742831*^9}},
 CellLabel->
  "In[375]:=",ExpressionUUID->"ef928e96-ab03-475a-a7be-691d2368ef2c"],

Cell["\<\
To illustrate the procedure for calculating expectation values, we construct \
the operator op  =  \[VerticalSeparator]1\[RightAngleBracket]\
\[LeftAngleBracket]2\[VerticalSeparator]\[CircleTimes]1+ \
\[VerticalSeparator]2\[RightAngleBracket]\[LeftAngleBracket]1\
\[VerticalSeparator]\[CircleTimes]1, and then evaluate its expectation value\
\>", "Text",
 CellChangeTimes->{{3.964378932688842*^9, 3.964378951068099*^9}, 
   3.967288285372512*^9},ExpressionUUID->"a64ae506-808d-4b85-ac14-\
98eb54d28c26"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"op", "=", 
   RowBox[{
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{
      RowBox[{"SparseArray", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "2"}], "}"}], "->", "1"}], ",", "3"}], "]"}], ",", 
      RowBox[{"IdentityMatrix", "[", "3", "]"}]}], "]"}], "+", 
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{
      RowBox[{"SparseArray", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"2", ",", "1"}], "}"}], "->", "1"}], ",", "3"}], "]"}], ",", 
      RowBox[{"IdentityMatrix", "[", "3", "]"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rexpval", " ", "=", " ", 
   RowBox[{"ExpectationValue", "[", 
    RowBox[{"h", ",", "rhot", ",", "op"}], "]"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.964379014059057*^9, 3.964379015445838*^9}, {
  3.964379087830946*^9, 3.964379186053607*^9}},
 CellLabel->
  "In[377]:=",ExpressionUUID->"49ed6abf-9efa-493a-ae14-138c747a9a8e"],

Cell["\<\
To compare, we also find the system\[CloseCurlyQuote]s evolution through the \
master equation \
\>", "Text",
 CellChangeTimes->{{3.964377267117847*^9, 
  3.964377313855739*^9}},ExpressionUUID->"e78a6993-41ae-48be-8f82-\
4f1ab3c32f4d"],

Cell[BoxData[
 RowBox[{
  RowBox[{"eqs", "=", 
   RowBox[{"MasterEquation", "[", 
    RowBox[{
    "h", ",", "rho", ",", "\[Rho]0", ",", "transCE", ",", "transdd", ",", 
     "transLi", ",", "nl", ",", "na", ",", "t"}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.963943595506553*^9, 3.963943621538735*^9}, {
   3.96394374642449*^9, 3.963943747471256*^9}, {3.963944541413476*^9, 
   3.963944556148516*^9}, {3.963945677095483*^9, 3.963945683908945*^9}, 
   3.964377321026716*^9, {3.964377454484881*^9, 3.964377461755391*^9}, {
   3.967288297992744*^9, 3.967288300169633*^9}},
 CellLabel->
  "In[379]:=",ExpressionUUID->"2ad7f05b-8d04-42a6-a24c-c94d573a870d"],

Cell["and numerically solve the differential equations", "Text",
 CellChangeTimes->{{3.9640299558248253`*^9, 3.964029990308799*^9}, {
  3.964379211987804*^9, 3.964379212537512*^9}, {3.967288323680768*^9, 
  3.967288324105832*^9}},ExpressionUUID->"619be4e1-807b-4553-9d08-\
1eb70954d9c6"],

Cell[BoxData[
 RowBox[{
  RowBox[{"sol", "=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{"eqs", ",", 
     RowBox[{"Normal", "[", "rho", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "10.0"}], "}"}]}], "]"}]}], ";"}]], "Input",\

 CellChangeTimes->{{3.955038224798077*^9, 3.955038312785888*^9}, {
   3.9550387328243017`*^9, 3.9550387375586967`*^9}, {3.955038909426608*^9, 
   3.955038920257182*^9}, 3.967288329440683*^9},
 CellLabel->
  "In[380]:=",ExpressionUUID->"354e9b72-c19b-45b2-b692-cfbaed22a55c"],

Cell["and find the expectation value of op using this solution", "Text",
 CellChangeTimes->{{3.964379233246297*^9, 
  3.964379246999831*^9}},ExpressionUUID->"73beec17-d732-4a6a-aeaf-\
c52177e1b827"],

Cell[BoxData[
 RowBox[{
  RowBox[{"expval", "=", 
   RowBox[{
    RowBox[{"ExpectationValue", "[", 
     RowBox[{"h", ",", "rho", ",", "op"}], "]"}], "/.", "sol"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.964379269243259*^9, 3.964379301173184*^9}},
 CellLabel->
  "In[381]:=",ExpressionUUID->"a002b09c-7766-482a-9532-d94ef26497b3"],

Cell["\<\
Superimpose the solutions obtained from the dressed state and the standard \
basis\
\>", "Text",
 CellChangeTimes->{{3.964030021176975*^9, 3.964030043882319*^9}, {
   3.964030090190791*^9, 3.964030096889349*^9}, {3.964030127525902*^9, 
   3.9640301299600983`*^9}, {3.964030268710431*^9, 3.96403029012081*^9}, {
   3.964030346838591*^9, 3.96403035101052*^9}, 3.96437768844435*^9, {
   3.96437881848643*^9, 3.964378850529519*^9}, {3.9786117145041323`*^9, 
   3.978611714911306*^9}},ExpressionUUID->"c15ea252-deac-4898-9c55-\
4d5170116d45"],

Cell[CellGroupData[{

