Cell[CellGroupData[{

Cell["Ham", "Subtitle",
 CellFrame->{{0, 0}, {0, 0.5}},
 CellFrameColor->GrayLevel[0.75],
 CellChangeTimes->{{3.954878763717317*^9, 3.9548787647156553`*^9}, 
   3.954935460414412*^9, {3.954940426468688*^9, 3.954940427257826*^9}},
 CellTags->"Ham",ExpressionUUID->"cc766e13-9807-4023-881f-f4a6c7734e4f"],

Cell[TextData[{
 "Ham[transCE, transdd, nl,  na, t] : transCE, trasdd \[Element] List;  na, \
nl \[Element] Ingeters, t is a Mathematica symbol that represents the time \
variable\nReturns a SparseArray for the time-dependent Hamiltonian in the \
interaction picture that accounts for light-matter and dipole-dipole \
interactions. The variable  transCE = {{{",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["ql", 
     RowBox[{"1", ",", "1"}]], ",", " ", 
    SubscriptBox["ql", 
     RowBox[{"1", ",", "2"}]]}], TraditionalForm]],ExpressionUUID->
  "41558967-d092-4231-9468-8b54a51e313e"],
 "}, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Alpha]", "1"], ",", " ", 
    SubscriptBox["Rb", "1"], ",", " ", 
    SubscriptBox["\[CapitalDelta]", "1"], ",", " ", 
    SubscriptBox["\[Phi]", "1"]}], TraditionalForm]],ExpressionUUID->
  "563cd4fb-0994-4212-85ef-05826e002b54"],
 "}, {{",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["ql", 
     RowBox[{"2", ",", "1"}]], ",", " ", 
    SubscriptBox["ql", 
     RowBox[{"2", ",", "2"}]]}], TraditionalForm]],ExpressionUUID->
  "103f6e11-e6d1-48ec-aa96-d641a6a86950"],
 "}, ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     SubscriptBox["\[Alpha]", "2"], ",", " ", 
     SubscriptBox["Rb", "2"], ",", " ", 
     SubscriptBox["\[CapitalDelta]", "2"], ",", " ", 
     SubscriptBox["\[Phi]", "2"]}]}], TraditionalForm]],ExpressionUUID->
  "2ec586ff-185b-448f-8c90-3e033ecd8768"],
 "}, \[Ellipsis]} contains the parameters for the light-matter interaction of \
the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "k"], TraditionalForm]],ExpressionUUID->
  "7170bfbf-d3c7-4458-8424-13ac5326f0bc"],
 "-th atom. These parameters are: the two quantum levels excited by the laser \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "3ec4e900-91e2-4044-87ae-1eaa01fa4816"],
 "and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "efe9ceb1-5045-476a-b737-0470ce44df71"],
 ", the Rabi parameter ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Rb", "k"], TraditionalForm]],ExpressionUUID->
  "40a2d966-55be-447d-8660-47e810b7649b"],
 ", the detuning  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalDelta]", "k"], TraditionalForm]],ExpressionUUID->
  "944eb234-ae49-483c-8d5a-40e09d105230"],
 " and the phase ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Phi]", "k"], TraditionalForm]],ExpressionUUID->
  "507ab169-7430-485d-8268-575da9f3e82b"],
 ".  The variable transdd={{",
 Cell[BoxData[
  FormBox[
   SubscriptBox["tr", 
    RowBox[{"1", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "6d156438-f647-4846-97a5-318473569c04"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["tr", 
    RowBox[{"1", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "d8259112-2742-4fa4-93d7-45fd979b7119"],
 "}, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "1"], TraditionalForm]],ExpressionUUID->
  "88916308-7a05-4abc-86ff-671eb3b2f551"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Beta]", "1"], TraditionalForm]],ExpressionUUID->
  "20b3d5fa-9417-412e-8390-65cc917002dd"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalOmega]", "1"], TraditionalForm]],ExpressionUUID->
  "89d0497e-6340-4144-a854-ad2f59facdb5"],
 " , ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Delta]", "1"], TraditionalForm]],ExpressionUUID->
  "945b3648-7ff2-45a0-8359-98371aadbbba"],
 "}, {",
 Cell[BoxData[
  FormBox[
   SubscriptBox["tr", 
    RowBox[{"2", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "2855fdb2-e452-42c1-a1a7-b26f099a543d"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["tr", 
    RowBox[{"2", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "f7120946-ec9b-4f89-a44f-e2f153da7b01"],
 "}, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "2"], TraditionalForm]],ExpressionUUID->
  "4c2e03cf-1ce3-4415-9638-9363a90c0ecd"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Beta]", "2"], TraditionalForm]],ExpressionUUID->
  "66695928-1c1e-467b-be16-47ce2a2c7783"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalOmega]", "2"], TraditionalForm]],ExpressionUUID->
  "51121359-337d-486c-ad1b-a691a9ac3a8d"],
 " ,",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Delta]", "2"], TraditionalForm]],ExpressionUUID->
  "bd7c30f9-4870-4ff9-b733-41608bcc5aa9"],
 "}, \[Ellipsis]} contains the parameters for the dipole-dipole interaction.  \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox["tr", 
    RowBox[{"k", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "06dde49c-c78d-45fb-a557-0287879358c7"],
 "={",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "1", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "da5778bc-290f-4b48-8f55-9bbe27c7b098"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "1", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "8e233985-3884-4656-8914-0c8916551357"],
 "}, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["tr", 
    RowBox[{"k", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "84c0e0d1-5b88-4210-81b8-3c106c2a2fbb"],
 "={",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "2", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "3c7e0948-897a-4195-b7b7-ad68e6f6a054"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "2", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "d51b6776-8f62-4c4a-8b6c-a379f1b55e6f"],
 "} are the two interacting dipole transitions corresponding to the two \
distinct ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "k"], TraditionalForm]],ExpressionUUID->
  "ec0b5089-604f-4ccb-a057-1383b68f8df7"],
 "-th and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Beta]", "k"], TraditionalForm]],ExpressionUUID->
  "9398c873-edd0-4813-96fc-bcc40b0e7cf2"],
 "-th atoms (",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "k"], TraditionalForm]],ExpressionUUID->
  "0fd7bc4a-b2a2-4781-842b-7b132453e66a"],
 "\[NotEqual]",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    SubscriptBox["\[Beta]", "k"]}], TraditionalForm]],ExpressionUUID->
  "701712d1-932f-4983-8c51-c3a57dcf13e3"],
 "). The strength of the interaction is given by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalOmega]", "k"], ".", " "}], TraditionalForm]],
  ExpressionUUID->"aabf7acb-08b6-4ce8-bfa1-df2d5d13c70e"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Delta]", "k"], TraditionalForm]],ExpressionUUID->
  "0ccb0691-ca82-40f4-93b8-63e23e516f8b"],
 " is the detuning between these two transitions. For ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Delta]", "k"], TraditionalForm]],ExpressionUUID->
  "5933319b-01f1-4f85-94c1-f6b492f13579"],
 " to be significant, it must be much smaller than both energy transitions \
themselves. Usually ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Delta]", "k"], TraditionalForm]],ExpressionUUID->
  "4b2f8efa-d7d2-4463-ab33-d07a6ec84cb5"],
 "=0. transCE and transdd might be empty lists in case there are no \
light-matter interactions or/and there are no dipole-dipole interactions."
}], "Text",
 CellChangeTimes->{{3.954878897778723*^9, 3.954878905190978*^9}, {
   3.954878942620962*^9, 3.954878970514427*^9}, {3.95487900917933*^9, 
   3.954879062735454*^9}, 3.954879098253928*^9, {3.954879241343924*^9, 
   3.954879412659048*^9}, {3.954879444408186*^9, 3.954879503745882*^9}, {
   3.954934336328712*^9, 3.954934465900693*^9}, {3.954935471017773*^9, 
   3.9549355378302193`*^9}, {3.954939599449833*^9, 3.954939664771409*^9}, {
   3.954939790669551*^9, 3.954939843279072*^9}, {3.954940461427494*^9, 
   3.954940479398761*^9}, {3.95494054112548*^9, 3.954940653505774*^9}, {
   3.954940687568445*^9, 3.9549407046799498`*^9}, {3.954940750010785*^9, 
   3.954940858938773*^9}, {3.954940904971528*^9, 3.954941356369125*^9}, {
   3.954941413010318*^9, 3.954941508190995*^9}, {3.954941568654795*^9, 
   3.954941812591436*^9}, {3.954941877666693*^9, 3.954942441695382*^9}, {
   3.954943150378008*^9, 3.95494319957655*^9}, {3.954943385539165*^9, 
   3.954943496240545*^9}, {3.954944019138126*^9, 3.954944043418404*^9}, {
   3.954944620719135*^9, 3.954944623937914*^9}, {3.954945566549717*^9, 
   3.9549455716149607`*^9}, {3.954945975262001*^9, 3.954945978966226*^9}, 
   3.954954375838986*^9, {3.955023785579678*^9, 
   3.955023786487822*^9}},ExpressionUUID->"eb76272c-dc18-4aac-b96d-\
a955be7fa113"],

