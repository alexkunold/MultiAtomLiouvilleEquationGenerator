Cell[TextData[{
 "We can also perform a spectroscopic analysis of the emission of the \
two-level system by sweeping the detuning and evaluating the emission as the \
expectation value \[LeftAngleBracket]",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Sigma]", 
    RowBox[{"1", ",", "2"}], "\[Dagger]"], TraditionalForm]],ExpressionUUID->
  "6b86d26a-3bfe-44f9-8f2a-0d5fed5919c7"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Sigma]", 
    RowBox[{"1", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "596fe99c-15a1-4a13-881c-1c48e7cd958d"],
 "\[RightAngleBracket] where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Sigma]", 
    RowBox[{"1", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "54e4f0d6-9bcf-4e21-99be-42c30d98f348"],
 " = \[VerticalSeparator]1\[RightAngleBracket]\[LeftAngleBracket]2\
\[VerticalSeparator]"
}], "Text",
 CellChangeTimes->{{3.964874665519184*^9, 3.964874722487727*^9}, {
   3.964875676599267*^9, 3.964875680201333*^9}, {3.964875822148663*^9, 
   3.9648758315726213`*^9}, {3.964875893631707*^9, 3.964875933481038*^9}, {
   3.964876002292228*^9, 3.964876070039279*^9}, 3.964876658177387*^9, {
   3.97489040152427*^9, 
   3.974890414182672*^9}},ExpressionUUID->"05460696-f5c2-47ad-8440-\
2aca7b25ba04"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"nd", "=", "200"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rho0", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"incon", "=", 
   RowBox[{"InitialConditions", "[", 
    RowBox[{"h", ",", "rho", ",", "rho0", ",", "t"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Sigma]12", "=", 
   RowBox[{"SparseArray", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], "->", "1"}], "}"}], ",", "2"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"expval", "=", 
   RowBox[{"ExpectationValue", "[", 
    RowBox[{"h", ",", "rho", ",", 
     RowBox[{
      RowBox[{"Transpose", "[", "\[Sigma]12", "]"}], ".", "\[Sigma]12"}]}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"listplot", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Do", "[", "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"det", "=", 
      RowBox[{
       RowBox[{"-", "50"}], "+", 
       RowBox[{"100", 
        RowBox[{"jj", "/", "nd"}]}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"parmvals", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         SubscriptBox["R", "1"], "->", "2.0"}], ",", 
        RowBox[{
         SubscriptBox["\[CapitalDelta]", "1"], "->", "det"}], ",", 
        RowBox[{
         SubscriptBox["\[Gamma]", "1"], "->", "1.5"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"eqsn", "=", 
      RowBox[{"eqs", "/.", "parmvals"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"diffeq", "=", 
      RowBox[{"Join", "[", 
       RowBox[{"eqsn", ",", "incon"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"sol", "=", 
      RowBox[{
       RowBox[{"NDSolve", "[", 
        RowBox[{"diffeq", ",", 
         RowBox[{"Normal", "[", "rho", "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"t", ",", "0", ",", "10"}], "}"}]}], "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"expvaln", "=", 
      RowBox[{
       RowBox[{"expval", "/.", "sol"}], "/.", 
       RowBox[{"{", 
        RowBox[{"t", "->", "10"}], "}"}]}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"AppendTo", "[", 
      RowBox[{"listplot", ",", 
       RowBox[{"{", 
        RowBox[{"det", ",", "expvaln"}], "}"}]}], "]"}], ";"}], 
    "\[IndentingNewLine]", ",", 
    RowBox[{"{", 
     RowBox[{"jj", ",", "0", ",", "nd"}], "}"}]}], "]"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"ListPlot", "[", 
  RowBox[{"listplot", ",", 
   RowBox[{"Axes", "->", "False"}], ",", 
   RowBox[{"Frame", "->", "True"}], ",", 
   RowBox[{"FrameLabel", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Style", "[", 
       RowBox[{
       "\"\<\!\(\*SubscriptBox[\(\[CapitalDelta]\), \(1\)]\)\>\"", ",", 
        "20"}], "]"}], ",", 
      RowBox[{"Style", "[", 
       RowBox[{"\"\<Emission\>\"", ",", "20"}], "]"}]}], "}"}]}], ",", 
   RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9648752944144907`*^9, 3.964875395938235*^9}, {
  3.964875458245583*^9, 3.96487548109902*^9}, {3.9648755148241377`*^9, 
