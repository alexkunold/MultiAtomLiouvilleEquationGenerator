Cell[TextData[{
 "Build the Lindbladian superoperator of a 3 level system composed of the \
Lindblad operators ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["A", "1"], TraditionalForm]],ExpressionUUID->
  "f9dde663-18e7-4b48-9ace-6e89acf40d4d"],
 " = ",
 Cell[BoxData[
  TagBox[
   RowBox[{"(", "\[NoBreak]", GridBox[{
      {"0", "1", "0"},
      {"0", "0", "0"},
      {"0", "0", "0"}
     },
     GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[0.7]}, 
         Offset[0.27999999999999997`]}, "Rows" -> {
         Offset[0.2], {
          Offset[0.4]}, 
         Offset[0.2]}}], "\[NoBreak]", ")"}],
   Function[BoxForm`e$, 
    MatrixForm[
    SparseArray[Automatic, {3, 3}, 0, {1, {{0, 1, 1, 1}, {{2}}}, {1}}]]]]],
  CellChangeTimes->{3.964700030191224*^9},ExpressionUUID->
  "529c8ee0-bde3-41c3-98ff-ebf752e6b88c"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["A", "2"], TraditionalForm]],ExpressionUUID->
  "23a45718-4013-4695-8893-32b7c0c58b72"],
 " = ",
 Cell[BoxData[
  TagBox[
   RowBox[{"(", "\[NoBreak]", GridBox[{
      {"0", "0", "0"},
      {"0", "0", "1"},
      {"0", "0", "0"}
     },
     GridBoxAlignment->{"Columns" -> {{Center}}, "Rows" -> {{Baseline}}},
     GridBoxSpacings->{"Columns" -> {
         Offset[0.27999999999999997`], {
          Offset[0.7]}, 
         Offset[0.27999999999999997`]}, "Rows" -> {
         Offset[0.2], {
          Offset[0.4]}, 
         Offset[0.2]}}], "\[NoBreak]", ")"}],
   Function[BoxForm`e$, 
    MatrixForm[
    SparseArray[Automatic, {3, 3}, 0, {1, {{0, 0, 1, 1}, {{3}}}, {1}}]]]]],
  CellChangeTimes->{{3.964700030191224*^9, 3.964700049026522*^9}},
  ExpressionUUID->"07fcb6c3-8d78-4d21-bd78-af38c13c9bad"],
 "  that correspond to the transitions \[VerticalSeparator]1\
\[RightAngleBracket] \[Rule] \[VerticalSeparator]2\[RightAngleBracket] and \
\[VerticalSeparator]2\[RightAngleBracket] \[Rule] \[VerticalSeparator]3\
\[RightAngleBracket], respectively. The matrix basis that spans the 3 level \
space is"
}], "Text",
