Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{
     SuperscriptBox[
      SubscriptBox["\[Rho]", "1"], "\[Prime]",
      MultilineFunction->None], "[", "t", "]"}], "\[Equal]", 
    RowBox[{
     RowBox[{"1.5`", " ", 
      RowBox[{
       SubscriptBox["\[Rho]", "2"], "[", "t", "]"}]}], "-", 
     RowBox[{"16.970562748477143`", " ", 
      RowBox[{"Sin", "[", 
       RowBox[{"1.1`", "\[VeryThinSpace]", "-", 
        RowBox[{"1.`", " ", "t"}]}], "]"}], " ", 
