   3.9550228471308317`*^9}},ExpressionUUID->"5ca393ff-90e4-4c50-acf0-\
fa39efb2d831"],

Cell["\<\
Generate the matrix basis por two atoms (na=2) with three levels (nl=3)\
\>", "Text",
 CellChangeTimes->{{3.954963162257332*^9, 
  3.954963211682609*^9}},ExpressionUUID->"603825aa-dbd8-4c67-9467-\
e8bb1e793ada"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"h", " ", "=", " ", 
  RowBox[{"MultiAtomBasis", "[", 
   RowBox[{"3", ",", "2"}], "]"}]}]], "Input",
 CellChangeTimes->{{3.954962458433217*^9, 3.954962474854609*^9}},
 CellLabel->"In[46]:=",ExpressionUUID->"eaf93856-1b6c-457a-b38e-86911e18fb59"],

Cell[BoxData[
 InterpretationBox[
