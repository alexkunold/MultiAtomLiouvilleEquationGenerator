Cell[CellGroupData[{

Cell["Example", "Subsubsection",
 CellChangeTimes->{{3.954934528317594*^9, 3.9549345300556*^9}, 
   3.964030690007098*^9},ExpressionUUID->"e3932bd7-35a6-45fb-a09c-\
3b2c9ee1a6b8"],

Cell[TextData[{
 "Generate the Liouville superoperator for the Hamiltonian of a system \
consisting of two (na=2) three level (nl=3) atoms subject to two lasers with \
Rabi parameters ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "1"], TraditionalForm]],ExpressionUUID->
  "8a18050d-d3dd-4243-9840-261987bd733b"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "2"], TraditionalForm]],ExpressionUUID->
  "d9a6fdc1-5a4a-4c9c-a071-05167270fd1a"],
 " and detuning parameters ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalDelta]", "1"], TraditionalForm]],ExpressionUUID->
  "55219fe4-dc51-4e8a-8635-09179e7d475e"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalDelta]", "2"], TraditionalForm]],ExpressionUUID->
  "b714b6ec-0b48-422e-8a00-3f01dba4babb"],
 ", respectively. The first laser couples the states \[VerticalSeparator]1\
\[RightAngleBracket] and \[VerticalSeparator]2\[RightAngleBracket] with a \
Rabi parameter ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "1"], TraditionalForm]],ExpressionUUID->
  "38b78562-2ab3-4b7e-abec-bfe652caf2e6"],
 " and the second couples \[VerticalSeparator]2\[RightAngleBracket] and \
\[VerticalSeparator]3\[RightAngleBracket] with a Rabi parameter ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["R", "2"], TraditionalForm]],ExpressionUUID->
  "51a8c6a5-8c17-4777-85e0-70b22d9d3947"],
 " for both atoms. Both atoms are at different positions along the \
light-propagation direction and therefore have a phase difference \[Phi]. The \
transCE variable that describes this light-matter interaction is"
}], "Text",
 CellChangeTimes->{{3.954934577830982*^9, 3.954934666984077*^9}, {
  3.954934791806799*^9, 3.95493488777148*^9}, {3.954935370006019*^9, 
  3.954935373498506*^9}, {3.954935556056313*^9, 3.954935600422351*^9}, {
  3.954942537342256*^9, 3.954942578376485*^9}, {3.9549427153918667`*^9, 
  3.954942906391176*^9}, {3.954942937754725*^9, 3.954943027463854*^9}, {
  3.954943883336549*^9, 3.9549439062399797`*^9}, {3.954944165431011*^9, 
  3.954944225207417*^9}, {3.954944258618572*^9, 3.95494430743131*^9}, {
  3.955028501608778*^9, 
  3.955028519257123*^9}},ExpressionUUID->"a80ba90e-9064-47c0-a877-\
a6dbe6e5b239"],

Cell[BoxData[
 RowBox[{
  RowBox[{"transCE", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], ",", "1", ",", " ", 
       SubscriptBox["R", "1"], ",", " ", 
       SubscriptBox["\[CapitalDelta]", "1"], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], ",", "2", ",", " ", 
       SubscriptBox["R", "1"], ",", " ", 
       SubscriptBox["\[CapitalDelta]", "1"], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "3"}], "}"}], ",", "1", ",", " ", 
       SubscriptBox["R", "2"], ",", " ", 
       SubscriptBox["\[CapitalDelta]", "2"], ",", "\[Phi]"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "3"}], "}"}], ",", "2", ",", " ", 
       SubscriptBox["R", "2"], ",", " ", 
       SubscriptBox["\[CapitalDelta]", "2"], ",", "\[Phi]"}], "}"}]}], 
    "}"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.954934673092539*^9, 3.954934702241617*^9}, {
  3.954934779155659*^9, 3.954934779301485*^9}, {3.9549348453122*^9, 
  3.954934853986453*^9}, {3.954935610882814*^9, 3.954935613829378*^9}, {
  3.9549429109365587`*^9, 3.954942921127887*^9}, {3.954943031222378*^9, 
  3.954943120861352*^9}, {3.95494321025631*^9, 3.9549432284364448`*^9}, {
  3.954943293200025*^9, 3.954943356527552*^9}, {3.954943505108894*^9, 
  3.954943590515995*^9}, {3.954943742662021*^9, 3.954943750531349*^9}, {
  3.9549441186025457`*^9, 3.954944133903529*^9}},
 CellLabel->"In[52]:=",ExpressionUUID->"88fd9cb1-4214-4464-b185-3e7e76d8c9a7"],

Cell["\<\
Assuming that the transitions \[VerticalSeparator]1\[RightAngleBracket] \
\[RightArrow] \[VerticalSeparator]2\[RightAngleBracket] and \
\[VerticalSeparator]2\[RightAngleBracket] \[RightArrow] \[VerticalSeparator]3\
\[RightAngleBracket] have different energy differences and, therefore, do not \
interact among themselves, the transdd parameter is given by\
\>", "Text",
 CellChangeTimes->{{3.954943757912268*^9, 3.954943860078283*^9}, {
   3.954943915641076*^9, 3.9549439395929527`*^9}, 
   3.964034252237245*^9},ExpressionUUID->"7900cbe6-e5dc-4075-978d-\
17fa8cb8e36c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"transdd", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], ",", "1", ",", "2", ",", 
       SubscriptBox["\[CapitalOmega]", "1"], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", "3"}], "}"}], ",", "1", ",", "2", ",", 
       SubscriptBox["\[CapitalOmega]", "2"], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], ",", "2", ",", "1", ",", 
       SubscriptBox["\[CapitalOmega]", "1"], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "3"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", "3"}], "}"}], ",", "2", ",", "1", ",", 
       SubscriptBox["\[CapitalOmega]", "2"], ",", "0"}], "}"}]}], "}"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.95503018710518*^9, 3.955030201026013*^9}},
 CellLabel->"In[53]:=",ExpressionUUID->"e5e318ad-5571-4de7-a8cb-c56d88480ddb"],

