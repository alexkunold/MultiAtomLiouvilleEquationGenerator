       RowBox[{"-", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", "\[Phi]"}]]}], " ", 
       SubscriptBox["R", "2"]}]},
     {"0", "0", "0", 
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Phi]"}]]}], " ", 
       SubscriptBox["R", "2"]}], "0", "0", 
      RowBox[{
       FractionBox["1", "3"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", 
          SubscriptBox["\[CapitalDelta]", "1"]}], "+", 
         SubscriptBox["\[CapitalDelta]", "2"]}], ")"}]}], 
      RowBox[{"-", 
       SubscriptBox["R", "1"]}], "0"},
     {"0", "0", "0", "0", 
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Phi]"}]]}], " ", 
       SubscriptBox["R", "2"]}], 
      SubscriptBox["\[CapitalOmega]", "2"], 
      RowBox[{"-", 
       SubscriptBox["R", "1"]}], 
      RowBox[{
       FractionBox["1", "3"], " ", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{"2", " ", 
          SubscriptBox["\[CapitalDelta]", "1"]}], "+", 
         SubscriptBox["\[CapitalDelta]", "2"]}], ")"}]}], 
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{"\[ImaginaryI]", " ", "\[Phi]"}]]}], " ", 
       SubscriptBox["R", "2"]}]},
     {"0", "0", "0", "0", "0", 
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Phi]"}]]}], " ", 
       SubscriptBox["R", "2"]}], "0", 
      RowBox[{
       RowBox[{"-", 
        SuperscriptBox["\[ExponentialE]", 
         RowBox[{
          RowBox[{"-", "\[ImaginaryI]"}], " ", "\[Phi]"}]]}], " ", 
       SubscriptBox["R", "2"]}], 
      RowBox[{
       FractionBox["2", "3"], " ", 
       RowBox[{"(", 
        RowBox[{
         SubscriptBox["\[CapitalDelta]", "1"], "+", 
         RowBox[{"2", " ", 
          SubscriptBox["\[CapitalDelta]", "2"]}]}], ")"}]}]}
    },
