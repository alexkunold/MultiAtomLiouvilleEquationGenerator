Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"\[Sigma]12", "=", 
   RowBox[{"SparseArray", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], "->", "1"}], "}"}], ",", "2"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"\[Sigma]21", "=", 
   RowBox[{"SparseArray", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "1"}], "}"}], "->", "1"}], "}"}], ",", "2"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"one", "=", 
   RowBox[{"SparseArray", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}], "->", "1"}], ",", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"2", ",", "2"}], "}"}], "->", "1"}]}], "}"}], ",", "2"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"corr1", "=", 
  RowBox[{"ExpectationValue", "[", 
   RowBox[{"h", ",", "rho", ",", 
    RowBox[{
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{
      "\[Sigma]12", ",", "one", ",", "one", ",", "one", ",", "\[Sigma]21"}], 
      "]"}], "+", 
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{
      "\[Sigma]21", ",", "one", ",", "one", ",", "one", ",", "\[Sigma]12"}], 
      "]"}]}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"corr2", "=", 
  RowBox[{"ExpectationValue", "[", 
   RowBox[{"h", ",", "rho", ",", 
    RowBox[{
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{
      "one", ",", "one", ",", "one", ",", "\[Sigma]12", ",", "\[Sigma]21"}], 
      "]"}], "+", 
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{
      "one", ",", "one", ",", "one", ",", "\[Sigma]21", ",", "\[Sigma]12"}], 
      "]"}]}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"corr1n", "=", 
   RowBox[{"corr1", "/.", "sol"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"corr2n", "=", 
   RowBox[{"corr2", "/.", "sol"}]}], ";"}]}], "Input",
