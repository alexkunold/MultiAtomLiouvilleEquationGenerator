Cell[TextData[{
 "We then set the matrix basis, define the density matrix and set the initial \
conditions so that the 5 orbitals of 5 ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", 
    RowBox[{"1", "/", "2"}]], TraditionalForm]],ExpressionUUID->
  "936e3b96-dedd-4222-aa85-83f20aa65ce6"],
 "F=2 are equally occupied"
}], "Text",
