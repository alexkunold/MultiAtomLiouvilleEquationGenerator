 RowBox[{"Needs", "[", "\"\<MultiAtomLiouvilleEquationGenerator`\>\"", 
  "]"}]}], "Input",
 CellChangeTimes->{3.965317107876034*^9},
 CellLabel->
  "In[383]:=",ExpressionUUID->"73b51beb-a877-46b4-891e-42068499fd3b"],

Cell[TextData[{
 "The Hamiltonian of a transmon qubit is given by H = \[HBar] \[Omega] ",
 Cell[BoxData[
  FormBox[
   RowBox[{"(", 
    RowBox[{
     SuperscriptBox["a", "\[Dagger]"], "a"}]}], TraditionalForm]],
  ExpressionUUID->"9f1b53ec-f673-46f8-83a0-24b7cce58bcb"],
 " +",
 Cell[BoxData[
  FormBox[
   FractionBox["1", "2"], TraditionalForm]],ExpressionUUID->
  "abe9be05-267f-4726-befe-798af4431e9c"],
 ") + ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["\[Alpha]", "12"], 
    SuperscriptBox[
     RowBox[{"(", 
      RowBox[{
       SuperscriptBox["a", "\[Dagger]"], "+", " ", "a"}], ")"}], "4"]}], 
   TraditionalForm]],ExpressionUUID->"c0f75dcc-6bfc-4998-9277-4056f49b2037"],
 "+\[Lambda](t) (",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["a", "\[Dagger]"], "+", " ", "a"}], TraditionalForm]],
  ExpressionUUID->"c850d34e-a4db-461d-a738-e1e047854136"],
 ") where ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["a", "\[Dagger]"], TraditionalForm]],ExpressionUUID->
  "ab02f936-36a7-4159-bf82-f49c93941089"],
 "and a are the usual creation and annihilation operators, \[Omega] is the \
transmon frequency, \[Alpha] is the anharmonicity parameter and \[Lambda](t) \
represents the drive. We assume that the transmon is coupled to a thermal \
bath, which is modeled by the Lindbladian L = -",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["\[Gamma]", "2"], 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         SuperscriptBox["a", "\[Dagger]"], "a"}], ",", " ", "\[Rho]"}], "}"}],
       "-", 
      RowBox[{"2", "a\[Rho]", " ", 
       SuperscriptBox["a", "\[Dagger]"]}]}], ")"}]}], TraditionalForm]],
  ExpressionUUID->"386308dd-3f42-4e58-a37c-d31cff7f9f56"],
 ". To build the Hamiltonian and Lindbladian we define the creation and \
annihilation operators"
}], "Text",
 CellChangeTimes->{{3.96471191509227*^9, 3.964711918250654*^9}, {
   3.964711985684279*^9, 3.96471220200703*^9}, {3.96471224422184*^9, 
   3.964712249433839*^9}, {3.964712752480998*^9, 3.96471294121474*^9}, {
   3.964712978714662*^9, 3.964713009573384*^9}, {3.964713044490812*^9, 
   3.964713099493615*^9}, {3.964713141736369*^9, 3.964713166886232*^9}, 
   3.964797509608679*^9, {3.964797600015891*^9, 3.9647976304382887`*^9}, 
   3.965225619564435*^9, 3.96531631339736*^9, {3.965317150766539*^9, 
   3.965317151639469*^9}, {3.974891834709962*^9, 
   3.974891858187154*^9}},ExpressionUUID->"a868f955-d308-40d1-8023-\
02653e9b39a4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"aop", "[", "ns_", "]"}], ":=", 
   RowBox[{"SparseArray", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"n", "+", "1"}], ",", "n"}], "}"}], "->", 
        SqrtBox["n"]}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "1", ",", 
         RowBox[{"ns", "-", "1"}]}], "}"}]}], "]"}], ",", "ns"}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"dop", "[", "ns_", "]"}], ":=", 
   RowBox[{"SparseArray", "[", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"n", "+", "1"}], ",", 
          RowBox[{"n", "+", "2"}]}], "}"}], "->", 
        SqrtBox[
         RowBox[{"n", "+", "1"}]]}], ",", 
       RowBox[{"{", 
        RowBox[{"n", ",", "0", ",", 
         RowBox[{"ns", "-", "2"}]}], "}"}]}], "]"}], ",", "ns"}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.964713200305984*^9, 3.964713223413294*^9}},
 CellLabel->
  "In[385]:=",ExpressionUUID->"67a9af49-8aa0-4fb1-acf0-bbb81a691263"],

