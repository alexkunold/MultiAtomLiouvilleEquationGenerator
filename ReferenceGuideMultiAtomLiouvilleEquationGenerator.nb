Cell["\<\
We verify that the adjoint Liouville operator is the conjugate transpose of \
the Liouville operator \
\>", "Text",
 CellChangeTimes->{{3.964711113719589*^9, 
  3.964711153868648*^9}},ExpressionUUID->"7fd3676a-2943-4c53-abbd-\
835ecb83fb52"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Simplify", "[", 
   RowBox[{
    RowBox[{"Normal", "[", 
     RowBox[{
      RowBox[{"Conjugate", "[", 
       RowBox[{"Transpose", "[", "Li", "]"}], "]"}], "-", "Lit"}], "]"}], ",", 
    RowBox[{"Assumptions", "->", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        SubscriptBox["\[Gamma]", "1"], "\[Element]", "Reals"}], ",", " ", 
       RowBox[{
        SubscriptBox["\[Gamma]", "2"], "\[Element]", "Reals"}]}], "}"}]}]}], 
   "]"}], "//", "MatrixForm"}]], "Input",
 CellChangeTimes->{{3.96471115733869*^9, 3.964711189886877*^9}, {
  3.964711269562554*^9, 3.9647113519126*^9}},
 CellLabel->
  "In[125]:=",ExpressionUUID->"d84767ed-00eb-4b5b-a913-3b0bc5600ea1"],

