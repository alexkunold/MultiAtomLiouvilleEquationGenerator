Cell["\<\
We then set the Lindbladian parameters. These are defined via the \
configuration variable transLi\
\>", "Text",
 CellChangeTimes->{
  3.9648713041888723`*^9, {3.971287223904025*^9, 3.9712872355063133`*^9}, {
   3.978605084346149*^9, 
   3.978605091633671*^9}},ExpressionUUID->"6807f18c-e3b6-4148-b35e-\
a85ca93cb098"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"transLi", "=", 
  RowBox[{"{", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", "2"}], "}"}], ",", "1", ",", "1", ",", 
     SubscriptBox["\[Gamma]", "1"], ",", "0"}], "}"}], "}"}]}]], "Input",
 CellChangeTimes->{{3.96487130939715*^9, 3.96487136024664*^9}},
 CellLabel->
  "In[177]:=",ExpressionUUID->"3f5b232b-9eff-4ddf-a57d-2f25b969e6e9"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}], ",", "1", ",", "1", ",", 
    SubscriptBox["\[Gamma]", "1"], ",", "0"}], "}"}], "}"}]], "Output",
 CellChangeTimes->{3.964871360804461*^9, 3.9648770109586887`*^9, 
  3.964877570863899*^9, 3.964964556040629*^9, 3.964964727573299*^9, 
  3.96496487901352*^9, 3.9674768659321623`*^9},
 CellLabel->
  "Out[177]=",ExpressionUUID->"d2962b35-dd1a-49cb-b0b5-4fcf87d25267"]
}, Open  ]],

Cell[TextData[{
 "These parameters  mean that there is only one decay channel between the \
states \[VerticalSeparator]1\[RightAngleBracket] and \[VerticalSeparator]2\
\[RightAngleBracket] ({1,2}). This is a transition between the atom 1 and \
itself, therefore the two transition lists are followed by a 1,1. The \
parameter ",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Gamma]", " "}], TraditionalForm]],ExpressionUUID->
  "836b75fa-3c0e-43fc-95fc-8c071d1e6d34"],
 "is the decay rate of the transition \[VerticalSeparator]1\
\[RightAngleBracket] \[RightArrow]  \
\[VerticalSeparator]2\[RightAngleBracket]. The final 0  in transLi represents \
the energy difference between the two transitions. In this case, both \
transitions are in fact the same, so the difference between the energy gaps \
is strictly zero. All together \[OpenCurlyDoubleQuote]",
 Cell[BoxData[
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{"1", ",", "2"}], "}"}], ",", "1", ",", "1", ",", 
    SubscriptBox["\[Gamma]", "1"], ",", "0"}], "}"}]], "Input",
  CellChangeTimes->{{3.96487130939715*^9, 3.96487136024664*^9}},
  ExpressionUUID->"9f829ce1-6965-40ff-8be9-cda463ffe619"],
 "\[CloseCurlyDoubleQuote] states that the decay involving  the state \
\[VerticalSeparator]1\[RightAngleBracket] and \[VerticalSeparator]2\
\[RightAngleBracket]  ({1,2}) couples to itself ({1,2}), involves only one \
atom (1,1), has decay rate ",
 Cell[BoxData[
  SubscriptBox["\[Gamma]", "1"]], "Input",
  CellChangeTimes->{{3.96487130939715*^9, 3.96487136024664*^9}},
  ExpressionUUID->"b1ea6da4-9da8-4a92-8520-069924146655"],
 " and the energy gap difference between transitions is 0 as the transition \
is coupling to itself. For more complex systems, each transition may couple \
to many other transitions.\n"
}], "Text",
 CellChangeTimes->{{3.9648713853636227`*^9, 3.964871796485074*^9}, {
  3.964871828723584*^9, 3.964871937190982*^9}, {3.964871989354904*^9, 
  3.964872030988288*^9}, {3.964872065116338*^9, 3.964872070272622*^9}, {
  3.964872118870276*^9, 3.964872142582684*^9}, {3.964872177723241*^9, 
  3.964872180762732*^9}, {3.9648722284812593`*^9, 3.964872247936729*^9}, {
  3.964872320249968*^9, 3.964872377279711*^9}, {3.964872529808708*^9, 
  3.964872541550843*^9}, {3.9712872508602877`*^9, 3.971287263196238*^9}, {
  3.971289504133225*^9, 3.971289642003004*^9}, {3.971289943023423*^9, 
  3.971289944860386*^9}, {3.978605127547374*^9, 
  3.9786051317948933`*^9}},ExpressionUUID->"589fc71e-b2d6-4866-8e79-\
7a5d54deada6"],

Cell["\<\
Having defined transLi, we are ready to compute the Liouville operator \
corresponding to the Lindbladian\
\>", "Text",
