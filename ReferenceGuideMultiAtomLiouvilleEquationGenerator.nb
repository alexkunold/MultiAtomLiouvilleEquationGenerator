Cell[CellGroupData[{

Cell["MasterEquation", "Subtitle",
 CellFrame->{{0, 0}, {0, 0.5}},
 CellFrameColor->GrayLevel[0.75],
 CellChangeTimes->{{3.954878763717317*^9, 3.9548787647156553`*^9}, 
   3.954935460414412*^9, {3.954940426468688*^9, 3.954940427257826*^9}, {
   3.95494452029814*^9, 3.954944521619375*^9}, 3.954953213995235*^9, {
   3.954956615527276*^9, 3.954956617965029*^9}, {3.954959646489932*^9, 
   3.9549596518557587`*^9}, {3.955023187679504*^9, 3.955023188726391*^9}, {
   3.9550277873586273`*^9, 3.9550277894759407`*^9}, {3.955034894987132*^9, 
   3.955034896619713*^9}, {3.95504997174227*^9, 3.955049975311408*^9}, {
   3.963764290116918*^9, 3.963764291509638*^9}},
 CellTags->
  "MasterEquation",ExpressionUUID->"bd575093-8099-4c15-8df3-16f1c73bdb6a"],

Cell[TextData[{
 "MasterEquation[h, q, q0, transCE, transdd, transLi, nl, na, t] : h, q, q0 \
\[Element] SparseArray, transCE, trasdd, transLi \[Element] List;  na, nl \
\[Element] Ingeters, t is a Mathematica symbol that represents the time \
variable\nReturns a List of dimension  Length[h]=Length[q] that contains the \
Liouville differential equations that correspond to the Liouville \
superoperator including both the Hamiltonian and  Lindbladian parts generated \
using LiouvilleCommutator and LiouvilleLindbladian. MasterEquation is a \
wrapper of LiouvilleMasterEquation. h is the SparseArray that contains the \
matrix basis generated with MultiAtomBasis. The variable q should be a list \
of the density matrix coefficients, i.e., q = Tr[h \[Rho](t)] . The initial \
conditions are set through q0=\[Rho](0). The configuration variable  transCE \
= {{{",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["ql", 
     RowBox[{"1", ",", "1"}]], ",", " ", 
    SubscriptBox["ql", 
     RowBox[{"1", ",", "2"}]]}], TraditionalForm]],ExpressionUUID->
  "a66d4a57-8acb-413f-9cca-a7e3e071eb74"],
 "}, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Alpha]", "1"], ",", " ", 
    SubscriptBox["Rb", "1"], ",", " ", 
    SubscriptBox["\[CapitalDelta]", "1"], ",", " ", 
    SubscriptBox["\[Phi]", "1"]}], TraditionalForm]],ExpressionUUID->
  "885eae3e-bdc5-473d-83dc-8d16aa0f083d"],
 "}, {{",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["ql", 
     RowBox[{"2", ",", "1"}]], ",", " ", 
    SubscriptBox["ql", 
     RowBox[{"2", ",", "2"}]]}], TraditionalForm]],ExpressionUUID->
  "da194c55-6ee6-4a70-ac4b-cf9ee4c083b5"],
 "}, ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     SubscriptBox["\[Alpha]", "2"], ",", " ", 
     SubscriptBox["Rb", "2"], ",", " ", 
     SubscriptBox["\[CapitalDelta]", "2"], ",", " ", 
     SubscriptBox["\[Phi]", "2"]}]}], TraditionalForm]],ExpressionUUID->
  "01aad5c3-e3ee-4bc3-b377-33426a16e2e7"],
 "}, \[Ellipsis]} contains the parameters for the light-matter interaction of \
the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "k"], TraditionalForm]],ExpressionUUID->
  "a538724d-6e0d-4682-b271-8fec5b283d82"],
 "-th atom. These parameters are: the two quantum levels excited by the laser \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "0e4d9940-46cc-45ce-8528-9d766295d168"],
 "and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "6056cda8-c79c-4bb3-94f6-e27e4482a5aa"],
 ", the Rabi parameter ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Rb", "k"], TraditionalForm]],ExpressionUUID->
  "8c4e3867-18af-4e66-b0d8-e63e396a76e4"],
 ", the detuning  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalDelta]", "k"], TraditionalForm]],ExpressionUUID->
  "3309739e-ca15-4777-943f-89df0882fdc3"],
 " and the phase ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Phi]", "k"], TraditionalForm]],ExpressionUUID->
  "3fb58180-9726-42a8-9c37-490da7bb0612"],
 ".  The configuration variable transdd={{",
 Cell[BoxData[
  FormBox[
   SubscriptBox["tr", 
    RowBox[{"1", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "2fb6bf7d-d41a-49b5-a62c-125db83afe1d"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["tr", 
    RowBox[{"1", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "d61729ed-05bb-4bec-a8ff-a8bb4c3430fc"],
 "}, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "1"], TraditionalForm]],ExpressionUUID->
  "ee42a1e4-04d7-4275-a182-fddf5920a282"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Beta]", "1"], TraditionalForm]],ExpressionUUID->
  "22f8a86a-ee70-4869-a200-af240f43a443"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalOmega]", "1"], TraditionalForm]],ExpressionUUID->
  "79c1b09e-047d-4bb4-92e5-4aa74ca4bbd9"],
 " , ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Delta]", "1"], TraditionalForm]],ExpressionUUID->
  "ccda2a59-645d-4450-b088-8668d327c795"],
 "}, {",
 Cell[BoxData[
  FormBox[
   SubscriptBox["tr", 
    RowBox[{"2", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "4f5e79ca-1eb8-4f25-90d2-371e6fe1d226"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["tr", 
    RowBox[{"2", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "ed611566-67f9-4f8c-a926-bbc6021a58ef"],
 "}, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "2"], TraditionalForm]],ExpressionUUID->
  "f0f03698-5b21-45a6-a214-edc1b37a4410"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Beta]", "2"], TraditionalForm]],ExpressionUUID->
  "e342ff1f-5e6b-4662-b448-65ef32d8150a"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalOmega]", "2"], TraditionalForm]],ExpressionUUID->
  "85b5b00e-8e60-4b5e-b38f-dd255861e4cd"],
 " ,",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Delta]", "2"], TraditionalForm]],ExpressionUUID->
  "c85a3981-3aac-4406-b452-fbfe07b742e6"],
 "}, \[Ellipsis]} contains the parameters for the dipole-dipole interaction.  \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox["tr", 
    RowBox[{"k", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "fe22f531-320d-47b6-98be-6674be03fc33"],
 "={",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "1", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "57c9a53a-92d0-4552-82fd-0c705fcd1352"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "1", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "4d9eec0f-8d3b-485d-843c-6e37bed36bd0"],
 "}, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["tr", 
    RowBox[{"k", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "3f6bf66d-6465-4f36-8e04-d43beb9a3019"],
 "={",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "2", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "bb9702aa-a27e-4181-acf9-c5f236293cb0"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "2", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "3054448c-aefd-44cf-a103-a2df8b28315a"],
 "} are the two interacting dipole transitions corresponding to the two \
distinct ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "k"], TraditionalForm]],ExpressionUUID->
  "35dfea6e-280a-4ffd-bc19-22ac5642516c"],
 "-th and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Beta]", "k"], TraditionalForm]],ExpressionUUID->
  "8fa57f5c-ec5e-4ff7-a397-8e222951952e"],
 "-th atoms (",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "k"], TraditionalForm]],ExpressionUUID->
  "b903072a-475b-4cd0-a33c-c6c98fdbf844"],
 "\[NotEqual]",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    SubscriptBox["\[Beta]", "k"]}], TraditionalForm]],ExpressionUUID->
  "a7f0dafa-0a71-49b8-afdb-e282dc34751f"],
 "). The strength of the interaction is given by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[CapitalOmega]", "k"], ".", " "}], TraditionalForm]],
  ExpressionUUID->"b39221c0-22be-440c-9da2-89f390f64841"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Delta]", "k"], TraditionalForm]],ExpressionUUID->
  "8340c1f0-6552-40e7-ad70-debc48cc0eb6"],
 " is the detuning between these two transitions. For ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Delta]", "k"], TraditionalForm]],ExpressionUUID->
  "191dc226-1fe1-4dd1-8620-8a8050aa1104"],
 " to be significant, it must be much smaller than both energy transitions \
themselves. Usually ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Delta]", "k"], TraditionalForm]],ExpressionUUID->
  "6fc1c048-0f97-4e93-8abb-29c9bce3790d"],
 "=0. transCE and transdd might be empty lists in case there are no \
light-matter interactions or/and there are no dipole-dipole interactions. The \
configuration variable transLi = {{",
 Cell[BoxData[
  FormBox[
   SubscriptBox["tr", 
    RowBox[{"1", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "c77daad8-8fb9-4757-bb61-73bbeab6c025"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["tr", 
    RowBox[{"1", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "d4c96c27-c3a0-4dce-9b4a-74135f77e1c0"],
 "}, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "1"], TraditionalForm]],ExpressionUUID->
  "bbaa9dba-c2fe-4ab7-b808-10b9b4fd9a3a"],
 ",  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Beta]", "1"], TraditionalForm]],ExpressionUUID->
  "9163bd04-5a3c-4ff4-947d-630575e8f26e"],
 ",  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "1"], TraditionalForm]],ExpressionUUID->
  "72195c39-71e1-487e-96b6-9735307c58ba"],
 " , ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Delta]", "1"], TraditionalForm]],ExpressionUUID->
  "e083217a-eb3d-4ead-a559-5f1faeeebf4b"],
 "}, {",
 Cell[BoxData[
  FormBox[
   SubscriptBox["tr", 
    RowBox[{"2", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "e2a9b9d5-4109-4a76-b843-8ca2dea7fdd6"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["tr", 
    RowBox[{"2", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "57c2ca03-b3f9-4b94-9653-736d89a05e69"],
 "}, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "2"], TraditionalForm]],ExpressionUUID->
  "0a8d8075-5638-45f2-865c-3b74bb64a69c"],
 ",  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Beta]", "2"], TraditionalForm]],ExpressionUUID->
  "72a72eef-bd0b-441c-acc4-5d266a9c11f2"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "2"], TraditionalForm]],ExpressionUUID->
  "5ec5d082-c6c9-4391-a6db-53918633f603"],
 " ,",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    SubscriptBox["\[Delta]", "2"]}], TraditionalForm]],ExpressionUUID->
  "9a5171db-ff5f-4073-88e3-9d0a61d490e6"],
 "}, \[Ellipsis]} contains the parameters for the dipole-dipole interaction.  \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox["tr", 
    RowBox[{"k", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "a8026780-e85c-4d73-8812-994598b4e063"],
 "={",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "1", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "e38afe98-1620-4fb7-8189-cbef3390e2e8"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "1", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "49f5f485-17d4-4160-b5c6-936f87182d53"],
 "}, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["tr", 
    RowBox[{"k", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "cd8bd4e2-00da-4d27-9532-bbe7decca9bc"],
 "={",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "2", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "0fa08ee4-7f51-460c-aa9d-93f299d075fd"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "2", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "cc1983c0-0e1a-4ae6-8da0-debc7d3fd6a6"],
 "} are the two interacting dipole transitions ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "1", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "64c14121-38bb-4e33-a018-4abdae631e20"],
 "\[RightArrow] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "1", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "17cb0f50-8166-467b-ba00-0b20c6287543"],
 " (between the quantum levels tagged as ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "1", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "bf5baf28-a050-42f0-9b22-f39af05a25ac"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "1", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "97f1210f-df49-4328-abb3-c30d21bb88b4"],
 ") and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "2", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "d2b9dc0c-5850-4269-ad4d-64224d715292"],
 "\[RightArrow] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "2", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "23f83876-a055-43e0-9d4d-01701aec0376"],
 " (between the quantum levels tagged as ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "2", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "b6d4d796-731d-4e4e-bfcf-76da6c24312b"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "2", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "6caabc0d-6419-46f9-b946-a127d18123ec"],
 ") of the two distinct ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "k"], TraditionalForm]],ExpressionUUID->
  "d565bc0b-59f9-4e09-8057-d2da76107922"],
 "-th and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Beta]", "k"], TraditionalForm]],ExpressionUUID->
  "22ed8491-f958-473c-8199-603196091cd1"],
 "-th atoms. The strength of the interaction is given by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", "k"], ".", " "}], TraditionalForm]],
  ExpressionUUID->"036c31c1-9319-453a-830c-8781efa3c144"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Delta]", "k"], TraditionalForm]],ExpressionUUID->
  "c48cea3b-a7d7-40f6-bcdd-67170333c493"],
 " is the detuning between these two transitions. These usually vanish, i.e. ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Delta]", "k"], TraditionalForm]],ExpressionUUID->
  "40ec0fca-d964-4536-a747-11855af02147"],
 "=0."
}], "Text",
