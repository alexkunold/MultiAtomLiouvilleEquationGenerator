     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}], ",", "2", ",", "2", ",", 
       SubscriptBox["\[Gamma]", "1"], ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
