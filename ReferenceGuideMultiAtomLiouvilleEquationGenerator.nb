Cell[CellGroupData[{

Cell["RotatingFrameParms", "Subtitle",
 CellFrame->{{0, 0}, {0, 0.5}},
 CellFrameColor->GrayLevel[0.75],
 CellChangeTimes->{{3.954878763717317*^9, 3.9548787647156553`*^9}, 
   3.954935460414412*^9, {3.954940426468688*^9, 3.954940427257826*^9}, {
   3.95494452029814*^9, 3.954944521619375*^9}, 3.954953213995235*^9},
 CellTags->
  "RotatingFrameParms",ExpressionUUID->"a498da73-a7b2-4299-8e1c-17ad41d5a909"],

Cell[TextData[{
 "RotatingFrameParms[transCE] : transCE \[Element] List\nReturns a List of \
the rotation parameters {",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Mu]", "1"], TraditionalForm]],ExpressionUUID->
  "1f819feb-4b7b-4511-86a9-5fc6fb5b4096"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Mu]", "2"], TraditionalForm]],ExpressionUUID->
  "422ea258-5277-444d-98ba-237e10d92a70"],
 ", \[Ellipsis]",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Mu]", "n"], TraditionalForm]],ExpressionUUID->
  "a4d0584b-542b-48d4-8609-8f4c9655c7fd"],
 " }, where n=Length[transCE], necessary to transform the time-dependent \
Hamiltonian Ham into the time-independent HamDressed by switching to a \
rotating frame. The variable  transCE = {{{",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["ql", 
     RowBox[{"1", ",", "1"}]], ",", " ", 
    SubscriptBox["ql", 
     RowBox[{"1", ",", "2"}]]}], TraditionalForm]],ExpressionUUID->
  "85997a18-a3bd-4cf0-9bcb-164e5d2bbaa2"],
 "}, ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Alpha]", "1"], ",", " ", 
    SubscriptBox["Rb", "1"], ",", " ", 
    SubscriptBox["\[CapitalDelta]", "1"], ",", " ", 
    SubscriptBox["\[Phi]", "1"]}], TraditionalForm]],ExpressionUUID->
  "237ac72c-e6f8-4478-86c9-25d01fd74e87"],
 "}, {{",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["ql", 
     RowBox[{"2", ",", "1"}]], ",", " ", 
    SubscriptBox["ql", 
     RowBox[{"2", ",", "2"}]]}], TraditionalForm]],ExpressionUUID->
  "1bd9c318-f1ac-49ca-bba6-607c9e124f5d"],
 "}, ",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    RowBox[{
     SubscriptBox["\[Alpha]", "2"], ",", " ", 
     SubscriptBox["Rb", "2"], ",", " ", 
     SubscriptBox["\[CapitalDelta]", "2"], ",", " ", 
     SubscriptBox["\[Phi]", "2"]}]}], TraditionalForm]],ExpressionUUID->
  "f88e0eb6-8261-479c-bb34-343e020a5e73"],
 "}, \[Ellipsis]} contains the parameters for the light-matter interaction of \
the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "k"], TraditionalForm]],ExpressionUUID->
  "8c272038-0d71-49d2-afa0-288f119534be"],
 "-th atom. These parameters are: the two quantum levels excited by the laser \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "6880cede-df6a-4a36-a792-2220dafad155"],
 "and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "a9476c71-e1dd-4607-a7fe-413642eab854"],
 ", the Rabi parameter ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Rb", "k"], TraditionalForm]],ExpressionUUID->
  "392b8530-b492-4118-ad3c-7a085c8425d4"],
 ", the detuning  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[CapitalDelta]", "k"], TraditionalForm]],ExpressionUUID->
  "597244df-38c8-4a53-a9e9-5ca547639ca2"],
 " and the phase ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Phi]", "k"], TraditionalForm]],ExpressionUUID->
  "6f4e2521-351b-4e96-8c51-f9bf8d384fe0"],
 ". The dressed Hamiltonian (HamDressed) is obtained from the time-dependent \
Hamiltonian (Ham) as ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["H", "D"], TraditionalForm]],ExpressionUUID->
  "5c5ae4b6-f881-4f08-a232-64ced7eed83c"],
 "=",
 Cell[BoxData[
  FormBox[
   SubscriptBox["U", "1"], TraditionalForm]],ExpressionUUID->
  "b7ed40fb-30c9-4cbd-a700-b7ed050b3fd8"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["U", "2"], TraditionalForm]],ExpressionUUID->
  "e5bcd0e8-f09f-449a-8063-1426755a4d81"],
 "\[Ellipsis]",
 Cell[BoxData[
  FormBox[
   SubscriptBox["U", "n"], TraditionalForm]],ExpressionUUID->
  "962e5425-42de-4256-8530-1c177903f1da"],
 "H",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["U", "n", "\[Dagger]"], TraditionalForm]],ExpressionUUID->
  "6942d24a-6024-4a07-a3f4-060788d4f99f"],
 "\[Ellipsis]",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["U", "2", "\[Dagger]"], TraditionalForm]],ExpressionUUID->
  "97b883c0-5b5a-492b-b4a6-552bb6dd18d1"],
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["U", "1", "\[Dagger]"], TraditionalForm]],ExpressionUUID->
  "4dca523f-b3da-4910-b58c-9f7091028fc2"],
 " where H is the Hamiltonian given by Ham, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["H", "D"], TraditionalForm]],ExpressionUUID->
  "76257080-60f0-4f67-98c7-9dbacbf512d8"],
 " is the Hamiltonian given by HamDressed, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["U", "k"], TraditionalForm]],ExpressionUUID->
  "3a6ad8e3-04b5-4b05-be0c-a6b329e2aea9"],
 "=MatrixExp[-\[ImaginaryI] t ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Mu]", "k"], TraditionalForm]],ExpressionUUID->
  "ca5e09b3-1183-4f6b-987c-e09fa7373558"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Sigma]", 
    RowBox[{"z", ",", "k"}]], TraditionalForm]],ExpressionUUID->
  "74ba4826-35c3-467b-9ac6-3c3d21aa8963"],
 "] and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Sigma]", 
    RowBox[{"z", ",", "k"}]], TraditionalForm]],ExpressionUUID->
  "e1f5cb4e-df34-4b13-b431-2a4e5b2f7771"],
 " = Sigmaz[transCE[[k,1]], ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "k"], TraditionalForm]],ExpressionUUID->
  "261b25d2-91f0-4759-acfa-be14e6a658d4"],
 ", nl, na]. nl and na are the numbers of quantum states and atoms, \
respectively."
}], "Text",
 CellChangeTimes->{{3.954878897778723*^9, 3.954878905190978*^9}, {
   3.954878942620962*^9, 3.954878970514427*^9}, {3.95487900917933*^9, 
   3.954879062735454*^9}, 3.954879098253928*^9, {3.954879241343924*^9, 
   3.954879412659048*^9}, {3.954879444408186*^9, 3.954879503745882*^9}, {
   3.954934336328712*^9, 3.954934465900693*^9}, {3.954935471017773*^9, 
   3.9549355378302193`*^9}, {3.954939599449833*^9, 3.954939664771409*^9}, {
   3.954939790669551*^9, 3.954939843279072*^9}, {3.954940461427494*^9, 
   3.954940479398761*^9}, {3.95494054112548*^9, 3.954940653505774*^9}, {
   3.954940687568445*^9, 3.9549407046799498`*^9}, {3.954940750010785*^9, 
   3.954940858938773*^9}, {3.954940904971528*^9, 3.954941356369125*^9}, {
   3.954941413010318*^9, 3.954941508190995*^9}, {3.954941568654795*^9, 
   3.954941812591436*^9}, {3.954941877666693*^9, 3.954942441695382*^9}, {
   3.954943150378008*^9, 3.95494319957655*^9}, {3.954943385539165*^9, 
   3.954943496240545*^9}, {3.954944019138126*^9, 3.954944043418404*^9}, {
   3.954944524708544*^9, 3.954944544385077*^9}, {3.954944582875909*^9, 
   3.954944605582519*^9}, {3.954945959818028*^9, 3.954945964066351*^9}, {
   3.954946012727757*^9, 3.9549460663994493`*^9}, {3.954953242740547*^9, 
   3.954953481566698*^9}, {3.954953512411003*^9, 3.954953568907329*^9}, {
   3.9549536723966722`*^9, 3.954953688066697*^9}, {3.954953758714372*^9, 
   3.95495406399152*^9}, {3.9549540974431343`*^9, 3.954954303500168*^9}, {
   3.954954508854928*^9, 3.954954556555798*^9}, {3.954955353167391*^9, 
   3.95495535327582*^9}, {3.9549553891639767`*^9, 3.954955408345117*^9}, 
   3.9549555974620857`*^9, {3.954957937914176*^9, 3.954957944872591*^9}, {
   3.955023766040941*^9, 
   3.95502376689326*^9}},ExpressionUUID->"d4a197f6-d21d-451b-83f7-\
02b660ee2f0f"],

