 "\[VerticalSeparator] \[LessEqual] j \[LessEqual] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["j", "1"], TraditionalForm]],ExpressionUUID->
  "b0ee22e4-8788-4004-a374-e130a651b38b"],
 "+ ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["j", "2"], TraditionalForm]],ExpressionUUID->
  "9c1e9ae5-094c-4290-9cc9-13ca860d5aa8"],
 ", and the magnetic quantum number condition ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["m", "1"], TraditionalForm]],ExpressionUUID->
  "017f13d8-225c-4407-8253-26b55cc36dbe"],
 "+ ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["m", "2"], TraditionalForm]],ExpressionUUID->
  "7c625613-7beb-4e9b-afae-709759ae4e9c"],
 "= m are satisfied. Otherwise, it returns zero."
}], "Text",
