   3.964710776645376*^9}},
 CellTags->
  "LiouvilleDaggerLindbladianFromLindbladOperators",ExpressionUUID->"4db381b1-\
2dfb-4f66-b6fe-4301170dff6e"],

Cell[TextData[{
 "LiouvilleDaggerLindbladianFromLindbladOperators[h, liops, gammas]: h, \
liops, gammas \[Element] SparseArray\nReturns a SparseArray of dimension \
Length[h]\[Times]Length[h] containing the adjoint Liouville superopertor of \
the Lindbladian ",
 Cell[BoxData[
  FormBox[
   SuperscriptBox["L", "\[Dagger]"], TraditionalForm]],ExpressionUUID->
  "aa4e4de3-10a8-4beb-a407-13d102eb6437"],
 " = -",
 Cell[BoxData[
  FormBox[
   RowBox[{
    FractionBox["1", "2"], 
    UnderscriptBox["\[Sum]", 
     RowBox[{"i", ",", "j"}]]}], TraditionalForm]],ExpressionUUID->
  "b81bdbcb-4512-401a-ab04-91636b4b723a"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", 
    RowBox[{"i", ",", "j"}]], TraditionalForm]],ExpressionUUID->
  "5ef53e9e-c6b6-46e4-8160-7146f0280341"],
 "({",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["A", "i", "\[Dagger]"], TraditionalForm]],ExpressionUUID->
  "5245c008-00df-4ff4-9741-4f916950a17f"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["A", "j"], TraditionalForm]],ExpressionUUID->
  "48757ad1-8fb9-404e-aba3-c13b7ea935fa"],
 ", \[Rho]}-2 ",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["A", "i", "\[Dagger]"], TraditionalForm]],ExpressionUUID->
  "5878800b-3d6d-45ca-be76-92d430b61ba6"],
 "\[Rho] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["A", "j"], TraditionalForm]],ExpressionUUID->
  "890ab573-3daf-4d8f-9a59-fdeb9f6024d5"],
 "). Here h is the matrix basis, liops contains the Lindblad operators {",
 Cell[BoxData[
  FormBox[
   SubscriptBox["A", "1"], TraditionalForm]],ExpressionUUID->
  "ce88820c-62fd-4a73-b9c3-ddf32a11a49a"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["A", "2"], TraditionalForm]],ExpressionUUID->
  "c81e8bcb-742e-47dc-bd3d-c69b151fc038"],
 ", ..., ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["A", "m"], TraditionalForm]],ExpressionUUID->
  "51c0dfce-239c-46a7-90bb-8118bd53aa9c"],
 "} and gammas contains the ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", 
    RowBox[{"i", ",", "j"}]], TraditionalForm]],ExpressionUUID->
  "83214642-02eb-4b90-8d8c-7c33c2b149c3"],
 " coefficients."
}], "Text",
 CellChangeTimes->{{3.954878897778723*^9, 3.954878905190978*^9}, {
   3.954878942620962*^9, 3.954878970514427*^9}, {3.95487900917933*^9, 
