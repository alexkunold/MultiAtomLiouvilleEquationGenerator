Cell[TextData[{
 "Notice the consistency between \[CapitalDelta]m and \[LeftAngleBracket]",
 StyleBox["p",
  FontWeight->"Bold"],
 "\[RightAngleBracket] in the previous lists. The first to elements of the \
innermost list of transdd are the coupled transitions. Consider terms 1 and 3 \
of transdd"
}], "Text",
 CellChangeTimes->{{3.965308484682598*^9, 3.965308505426729*^9}, {
  3.965308554070148*^9, 3.965308567888205*^9}, {3.965310927264208*^9, 
