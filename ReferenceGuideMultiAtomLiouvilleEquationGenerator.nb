3732c5bc5e5d"],

Cell[TextData[{
 "LiouvilleLindbladianDagger[h, transLi, nl, na] : h \[Element] SparseArray, \
transLi \[Element] List, nl, na \[Element] Integers\n\
LiouvilleLindbladianDagger[h, transLi, nl, na, t] : h \[Element] SparseArray, \
transLi \[Element] List, nl, na \[Element] Integers, t is a Mathematica \
symbol that represents the time variable\nReturns a SparseArray of dimension  \
Length[h] that contains the adjoint Liouville superoperator corresponding to \
the adjoint Lindbladian of the adjoint master equation.  na and nl are the \
numbers of atoms and quantum levels of the system. h is the SparseArray that \
contains the matrix basis generated with MultiAtomBasis.The variable transLi \
= {{",
 Cell[BoxData[
  FormBox[
   SubscriptBox["tr", 
    RowBox[{"1", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "08c72f1f-5ff4-4faf-926f-cbdf09c4aaf9"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["tr", 
    RowBox[{"1", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "3b563358-e590-47a2-8104-6cda0b9d5044"],
 "}, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "1"], TraditionalForm]],ExpressionUUID->
  "e80edc31-30c1-46e6-b472-408982713339"],
 ",  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Beta]", "1"], TraditionalForm]],ExpressionUUID->
  "28887a90-9b63-4b75-9494-5c6d443ed292"],
 ",  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "1"], TraditionalForm]],ExpressionUUID->
  "07f07c82-00b6-4b22-8744-2fa091a20cb1"],
 " , ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Delta]", "1"], TraditionalForm]],ExpressionUUID->
  "a71f2693-600b-4ed5-be6c-6b020db4e2fa"],
 "}, {",
 Cell[BoxData[
  FormBox[
   SubscriptBox["tr", 
    RowBox[{"2", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "28a342b4-eeb0-41dd-bb1e-390244b4e044"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["tr", 
    RowBox[{"2", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "ebd37fad-ee3c-48bc-addd-168bfa62e788"],
 "}, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "2"], TraditionalForm]],ExpressionUUID->
  "1973855a-5e94-45ad-8fc3-9b226f05dbf1"],
 ",  ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Beta]", "2"], TraditionalForm]],ExpressionUUID->
  "cd21772b-0dea-4134-8bba-5c4d25c33351"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Gamma]", "2"], TraditionalForm]],ExpressionUUID->
  "9b2a04f9-912d-4133-97c6-5e5fcaf5a3ef"],
 " ,",
 Cell[BoxData[
  FormBox[
   RowBox[{" ", 
    SubscriptBox["\[Delta]", "2"]}], TraditionalForm]],ExpressionUUID->
  "ce096270-530d-46c0-82e8-2b56a565fd56"],
 "}, \[Ellipsis]} contains the parameters for the dipole-dipole interaction.  \
",
 Cell[BoxData[
  FormBox[
   SubscriptBox["tr", 
    RowBox[{"k", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "b9f2b249-885f-42df-b8c2-1bfff2c85087"],
 "={",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "1", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "39893489-cf8b-42e6-b8b4-a167b7b65469"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "1", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "77064424-71eb-4ed1-af79-fe1d8fa9637b"],
 "}, ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["tr", 
    RowBox[{"k", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "83faff44-917f-44d3-b255-ebf37b7c6210"],
 "={",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "2", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "567a8c19-9c4a-4c0a-a701-e82e8810aaf8"],
 ", ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "2", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "d3548697-ab05-465b-94eb-13fcff48976d"],
 "} are the two interacting dipole transitions ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "1", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "31120f8f-09b8-40f4-851e-bd678b08f4c4"],
 "\[RightArrow] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "1", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "62d82499-9054-4076-958a-4ee8161bc88d"],
 " (between the quantum levels tagged as ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "1", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "8b637260-27e3-4c00-9a0c-a31721da7891"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "1", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "c679aa75-3b76-403e-9116-957c64e00323"],
 ") and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "2", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "6bb3d4fb-d719-4268-84b5-4a4b079c5a42"],
 "\[RightArrow] ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "2", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "bd7685a7-f461-464f-b1f3-3494f578f190"],
 " (between the quantum levels tagged as ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "2", ",", "1"}]], TraditionalForm]],ExpressionUUID->
  "a7db02db-cc7a-451a-ba4f-8850867a66af"],
 " and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["ql", 
    RowBox[{"k", ",", "2", ",", "2"}]], TraditionalForm]],ExpressionUUID->
  "2c33653e-0118-4f04-ab31-ae00bf03bba9"],
 ") of the two distinct ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Alpha]", "k"], TraditionalForm]],ExpressionUUID->
  "d1d7e58a-d34a-4a31-bbee-3289b36a3dfb"],
 "-th and ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Beta]", "k"], TraditionalForm]],ExpressionUUID->
  "5e6f53b3-f341-4c0b-8a28-062f2cf1e1fb"],
 "-th atoms. The strength of the interaction is given by ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Gamma]", "k"], ".", " "}], TraditionalForm]],
  ExpressionUUID->"4cc5f5bb-e5c6-407c-bf5f-83cb182847ac"],
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Delta]", "k"], TraditionalForm]],ExpressionUUID->
  "43df84cb-2c03-4b8f-b238-f86d937d7928"],
 " is the detuning between these two transitions. These usually vanish, i.e. ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Delta]", "k"], TraditionalForm]],ExpressionUUID->
  "4cabae5c-d3ac-45de-9c18-4373b29347f9"],
 "=0. In this case, the time variable t can be omitted as an argument of \
LiouvilleLindbladianDagger."
}], "Text",
