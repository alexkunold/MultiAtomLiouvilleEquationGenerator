Cell[BoxData[
 RowBox[{" ", 
  RowBox[{
   RowBox[{"H", "=", 
    RowBox[{
     RowBox[{"\[HBar]", " ", "\[Omega]", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"at", ".", "a"}], "+", 
        RowBox[{
         FractionBox["1", "2"], " ", "one"}]}], ")"}]}], "-", 
     RowBox[{
      FractionBox["\[Alpha]", "12"], 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"a", "+", "at"}], ")"}], ".", 
       RowBox[{"(", 
        RowBox[{"a", "+", "at"}], ")"}], ".", 
       RowBox[{"(", 
        RowBox[{"a", "+", "at"}], ")"}], ".", 
       RowBox[{"(", 
        RowBox[{"a", "+", "at"}], ")"}]}]}], "+", " ", 
     RowBox[{"\[Lambda]", " ", 
      RowBox[{"(", 
       RowBox[{"a", "+", "at"}], ")"}]}]}]}], ";"}]}]], "Input",
 CellChangeTimes->{{3.964783556051824*^9, 3.964783560336955*^9}},
 CellLabel->
  "In[392]:=",ExpressionUUID->"1c61c505-b0f4-4bf2-8b75-ed6663c6c36e"],

Cell["We set the constants of the system", "Text",
 CellChangeTimes->{{3.964783609967409*^9, 
  3.964783617487933*^9}},ExpressionUUID->"5820f9ab-9b15-4cd1-b0f3-\
c0a03a18c41e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"consts", "=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"\[HBar]", "->", "1.0"}], ",", 
    RowBox[{"\[Omega]", "->", "4.5"}], ",", 
    RowBox[{"\[Alpha]", "->", 
     RowBox[{"-", "0.30"}]}], ",", 
    RowBox[{"\[Lambda]", "->", "0"}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.964783638468654*^9, 3.964783656703018*^9}, {
  3.964783783076638*^9, 3.964783785994046*^9}},
 CellLabel->
  "In[393]:=",ExpressionUUID->"9a5cb214-cb72-4dc0-8c65-e2849f45093e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"\[HBar]", "\[Rule]", "1.`"}], ",", 
   RowBox[{"\[Omega]", "\[Rule]", "4.5`"}], ",", 
   RowBox[{"\[Alpha]", "\[Rule]", 
    RowBox[{"-", "0.3`"}]}], ",", 
   RowBox[{"\[Lambda]", "\[Rule]", "0"}]}], "}"}]], "Output",
 CellChangeTimes->{{3.964783759130243*^9, 3.964783786501403*^9}, 
   3.964785161544488*^9, 3.964786001488307*^9, 3.964786098131956*^9, 
   3.964793608868111*^9, 3.964795464472474*^9, 3.964796075790545*^9, 
   3.967286076315688*^9, 3.967477509447866*^9},
 CellLabel->
  "Out[393]=",ExpressionUUID->"5fb598ad-b96a-444c-9c6f-fb6d702d6e1e"]
}, Open  ]],

Cell["\<\
and calculate the eigenvalues of H in order to know the excitation energy \
\[CapitalDelta] between the ground and the first excited states\
\>", "Text",
 CellChangeTimes->{{3.964783664760607*^9, 3.964783741338711*^9}, {
  3.964783878526001*^9, 
  3.964783880180275*^9}},ExpressionUUID->"e9083780-c427-4fee-89b7-\
68894ae2cce8"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Hn", "=", 
   RowBox[{
    RowBox[{"Normal", "[", "H", "]"}], "/.", "consts"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"eval", "=", 
  RowBox[{"Eigenvalues", "[", "Hn", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"\[CapitalDelta]", "=", 
  RowBox[{
   RowBox[{"eval", "[", 
    RowBox[{"[", "7", "]"}], "]"}], "-", 
   RowBox[{"eval", "[", 
    RowBox[{"[", "8", "]"}], "]"}]}]}]}], "Input",
 CellChangeTimes->{{3.964783744380113*^9, 3.964783862466157*^9}},
 CellLabel->
  "In[394]:=",ExpressionUUID->"f937b165-74a9-4af6-afaf-35ca0d98da89"],

