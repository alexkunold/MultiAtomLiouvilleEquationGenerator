Cell[TextData[{
 "We can also perform a spectroscopic analysis of the emission of two atom \
pairs by sweeping the detuning and evaluating the correlations \
\[LeftAngleBracket]",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Sigma]", 
    RowBox[{"2", ",", "1"}], "1"], TraditionalForm]],ExpressionUUID->
  "1f78d01e-03f1-46df-95a6-90b166752df8"],
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Sigma]", 
    RowBox[{"1", ",", "2"}], "2"], TraditionalForm]],ExpressionUUID->
  "b31abdde-7c81-4632-b923-70e3a5d341c5"],
 "+",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Sigma]", 
    RowBox[{"2", ",", "1"}], "2"], TraditionalForm]],ExpressionUUID->
  "448eb056-f5bc-4cc9-bc9a-967e66f16bbb"],
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Sigma]", 
    RowBox[{"1", ",", "2"}], "1"], TraditionalForm]],ExpressionUUID->
  "0a04a989-9b6b-496e-90ff-27aaf87105aa"],
 "\[RightAngleBracket]  and \[LeftAngleBracket]",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Sigma]", 
    RowBox[{"2", ",", "1"}], "1"], TraditionalForm]],ExpressionUUID->
  "f932f30e-60b8-4cca-9e29-e7cb661a1bb7"],
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Sigma]", 
    RowBox[{"1", ",", "2"}], "5"], TraditionalForm]],ExpressionUUID->
  "3a4aff46-7e3b-408e-a946-49cb09dd5e44"],
 "+",
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Sigma]", 
    RowBox[{"2", ",", "1"}], "5"], TraditionalForm]],ExpressionUUID->
  "3eb73066-83ca-4b97-a32c-d3b4c52dbdef"],
 Cell[BoxData[
  FormBox[
   SubsuperscriptBox["\[Sigma]", 
    RowBox[{"1", ",", "2"}], "1"], TraditionalForm]],ExpressionUUID->
  "a542952a-dc31-418f-bd33-4c3315ccd84c"],
 "\[RightAngleBracket]"
}], "Text",
 CellChangeTimes->{{3.964874665519184*^9, 3.964874722487727*^9}, {
   3.964875676599267*^9, 3.964875680201333*^9}, {3.964875822148663*^9, 
