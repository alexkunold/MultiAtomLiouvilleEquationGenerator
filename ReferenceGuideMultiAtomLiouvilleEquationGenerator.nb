Cell[TextData[{
 "ExpectationValue[h, q, Op]: h, q, Op \[Element] SparseArray\nReturns an \
expression for the expectation value ",
 Cell[BoxData[
  FormBox[
   UnderscriptBox["\[Sum]", "i"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "535426b3-4807-4455-a5d9-4d7649879325"],
 "Tr[",
 Cell[BoxData[
  FormBox[
   SubscriptBox["h", "i"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "0e88fe01-5b05-4579-991c-8b1095e3194a"],
 " Op]",
 Cell[BoxData[
  FormBox[
   SubscriptBox["q", "i"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "d5bb38f4-b91f-4e75-b2a8-62188d07eeb3"],
 " of the operator Op where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["q", "i"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "8220fa41-56c9-4d36-8e8b-c2bcfa1dd595"],
 " =Tr[",
 Cell[BoxData[
  FormBox[
   SubscriptBox["h", "i"], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "712f356b-1d77-4131-b358-9bd5f7011ac0"],
 "\[Rho]] are the density matrix coefficients and h is the matrix basis."
}], "Text",
