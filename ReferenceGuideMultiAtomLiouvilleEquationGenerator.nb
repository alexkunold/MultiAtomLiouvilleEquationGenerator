Cell["\<\
Now we calculate the emission of five strongly coupled atoms. To this end, we \
set the coupling parameters W and M to 0.752 and 0.45, compute the numerical \
form of the differential equations, and obtain the corresponding solution\
\>", "Text",
 CellChangeTimes->{{3.968265932007585*^9, 
  3.9682660249293013`*^9}},ExpressionUUID->"ed625248-15bb-4a7c-bced-\
3bf147d7c031"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"consts", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"\[Gamma]", "\[Rule]", "0.151458"}], ",", 
     RowBox[{"W", "\[Rule]", "0.752"}], ",", 
     RowBox[{"M", "->", "0.45"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"diffeqsn", "=", 
    RowBox[{"diffeqs", "/.", "consts"}]}], ";"}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"sol", "=", 
   RowBox[{
    RowBox[{"NDSolve", "[", 
     RowBox[{"diffeqsn", ",", "rho", ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "tmin", ",", "tmax"}], "}"}]}], "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}]}], "Input",
 CellLabel->"In[34]:=",ExpressionUUID->"a69ff075-2432-42d2-9d68-2c180c1ed213"],

Cell[TextData[{
 "Using the solution, we compute \[LeftAngleBracket]",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["E", "\[Dagger]"], "E"}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "1e66f83c-fd16-4e4e-8b37-65269e6c490e"],
 "\[RightAngleBracket], the expectation value of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SuperscriptBox["E", "\[Dagger]"], "E"}], TraditionalForm]],ExpressionUUID->
  "01d56f23-022d-4489-9530-ceae2727d2cf"],
 ", which was obtained previously"
}], "Text",
 CellChangeTimes->{{3.968266116250065*^9, 3.9682661384611273`*^9}, {
  3.9682661828498173`*^9, 
  3.9682662272728643`*^9}},ExpressionUUID->"3c8f780d-1f86-47ca-9664-\
84d62fc23569"],

Cell[BoxData[
 RowBox[{
  RowBox[{"evd", "=", 
   RowBox[{
    RowBox[{"Re", "[", 
     RowBox[{"ExpectationValue", "[", 
      RowBox[{"h", ",", "rho", ",", "EtE"}], "]"}], "]"}], "/.", "sol"}]}], 
  ";"}]], "Input",
 CellLabel->"In[37]:=",ExpressionUUID->"a3cd2628-71e6-4955-9e93-ac1483077772"],

Cell[TextData[{
 "We then calculate a list of 60 emission power  points as a function of time \
and again fit the list to ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["I", "0"], 
    RowBox[{"exp", "(", 
     RowBox[{
      RowBox[{"-", "t"}], "/", "\[Tau]"}], ")"}]}], TraditionalForm]],
  ExpressionUUID->"1c4441e4-6ac2-4fcc-a167-4e29fdf6e8d1"],
 " in order to extract the decay time  \[Tau] "
}], "Text",
 CellChangeTimes->{{3.968266269815507*^9, 3.968266274222769*^9}, {
  3.968266333864094*^9, 3.968266368777027*^9}, {3.9730148917809353`*^9, 
  3.973014907293095*^9}},ExpressionUUID->"e8164f13-b078-400a-852c-\
043933cb87c6"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"nd", "=", "60"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"datad", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"tmin", "+", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"tmax", "-", "tmin"}], ")"}], 
         RowBox[{"ii", "/", "nd"}]}]}], ",", 
       RowBox[{"evd", "/.", 
        RowBox[{"{", 
         RowBox[{"t", "->", 
          RowBox[{"tmin", "+", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{"tmax", "-", "tmin"}], ")"}], 
            RowBox[{"ii", "/", "nd"}]}]}]}], "}"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"ii", ",", "0", ",", "nd"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{"fit", "=", 
  RowBox[{"FindFit", "[", 
   RowBox[{
    RowBox[{"datad", "[", 
     RowBox[{"[", 
      RowBox[{"15", ";;"}], "]"}], "]"}], ",", 
    RowBox[{"I0", " ", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", " ", "t"}], "/", "\[Tau]"}], "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"I0", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[Tau]", ",", "5"}], "}"}]}], "}"}], ",", "t"}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"fund", "=", 
   RowBox[{
    RowBox[{"I0", " ", 
     RowBox[{"Exp", "[", 
      RowBox[{
       RowBox[{"-", " ", "t"}], "/", "\[Tau]"}], "]"}]}], "/.", "fit"}]}], 
  ";"}]}], "Input",
 CellLabel->"In[38]:=",ExpressionUUID->"432830b4-6b62-4cbe-98da-dad6ce049ad6"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"I0", "\[Rule]", "17.322871799165597`"}], ",", 
   RowBox[{"\[Tau]", "\[Rule]", "2.906956576376059`"}]}], "}"}]], "Output",
 CellChangeTimes->{3.968266392510756*^9},
 CellLabel->"Out[40]=",ExpressionUUID->"11d9ffe8-1e52-4f43-832a-d8ca99726ca2"]
}, Open  ]],

Cell["\<\
In this case, we used only the last 45 points, since the first 15 do not \
exhibit an exponential decay. Note that the decay time for coupled atoms is \
shorter. We plot the fitted function together with the data points and the \
numerical solution for the expectation value\
\>", "Text",
 CellChangeTimes->{{3.968266415135159*^9, 3.968266477668125*^9}, {
  3.968266512520496*^9, 3.9682666036956673`*^9}, {3.968266642796688*^9, 
  3.968266646005664*^9}},ExpressionUUID->"84401364-369c-468f-90f8-\
2eef2a8b2f86"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Show", "[", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Plot", "[", 
     RowBox[{"fund", ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "tmin", ",", "tmax"}], "}"}], ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Thickness", "[", "0.02", "]"}], ",", 
         RowBox[{"Opacity", "[", "0.3", "]"}]}], "}"}]}], ",", 
      RowBox[{"Axes", "->", "False"}], ",", 
      RowBox[{"Frame", "->", "True"}], ",", 
      RowBox[{"FrameLabel", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Style", "[", 
          RowBox[{"\"\<t (ns)\>\"", ",", "20"}], "]"}], ",", 
         RowBox[{"Style", "[", 
          RowBox[{
          "\"\<\[LeftAngleBracket]\!\(\*SuperscriptBox[\(E\), \
\(\[Dagger]\)]\)E\[RightAngleBracket]\>\"", ",", "20"}], "]"}]}], "}"}]}], 
      ",", 
      RowBox[{"PlotRange", "->", "All"}]}], "]"}], ",", 
    RowBox[{"Plot", "[", 
     RowBox[{"evd", ",", 
      RowBox[{"{", 
       RowBox[{"t", ",", "tmin", ",", "tmax"}], "}"}], ",", 
      RowBox[{"PlotRange", "->", "All"}]}], "]"}], ",", 
    RowBox[{"ListPlot", "[", 
     RowBox[{"datad", ",", 
      RowBox[{"PlotStyle", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Opacity", "[", "0.7", "]"}], ",", 
         RowBox[{"PointSize", "[", "0.02", "]"}]}], "}"}]}]}], "]"}]}], "}"}],
   "]"}]], "Input",
 CellLabel->"In[42]:=",ExpressionUUID->"69d0649c-2c0f-4fed-af28-e7f84c46740c"],

