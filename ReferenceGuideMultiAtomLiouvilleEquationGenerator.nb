Cell["\<\
Now we can observe the dynamics of different expectation values or the \
density matrix coefficients. For example, to compute the populations of \
\[VerticalSeparator]1\[RightAngleBracket] and \[VerticalSeparator]2\
\[RightAngleBracket] we calculate the expectation values\
\>", "Text",
 CellChangeTimes->{{3.9648740586453*^9, 
  3.9648741926048603`*^9}},ExpressionUUID->"e9e0f16f-0396-4ea8-8e3c-\
27a173c44d42"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"pop1", "=", 
  RowBox[{"ExpectationValue", "[", 
   RowBox[{"h", ",", "rho", ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}]}], "}"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"pop2", "=", 
  RowBox[{"ExpectationValue", "[", 
   RowBox[{"h", ",", "rho", ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"0", ",", "1"}], "}"}]}], "}"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pop1n", "=", 
   RowBox[{"pop1", "/.", "sol"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pop2n", "=", 
   RowBox[{"pop2", "/.", "sol"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.964874198065336*^9, 3.964874304193437*^9}},
 CellLabel->
  "In[187]:=",ExpressionUUID->"f89934fe-c16c-4af2-b849-e8fc2768b2e2"],

