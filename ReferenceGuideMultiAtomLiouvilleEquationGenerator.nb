Cell[TextData[{
 "We can assume that the atoms are both initially in the lowest energy level  \
\[VerticalSeparator]1\[RightAngleBracket] . Therefore, we set the initial \
conditions to ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Rho]", "0"], TraditionalForm]],ExpressionUUID->
  "3a936803-4dad-4fe4-8b66-9ddcd65b6b11"],
 "=",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Eta]", "0"], TraditionalForm]],ExpressionUUID->
  "d61c5eb9-52fc-4fed-8dcb-44323a583759"],
 Cell[BoxData[
  FormBox["\[CircleTimes]", TraditionalForm]],ExpressionUUID->
  "a5192be5-a27a-41ca-8c07-9e6aaf163caf"],
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["\[Eta]", "0"], " "}], TraditionalForm]],ExpressionUUID->
  "a2fd034c-110a-4f61-9e16-c89eeef3b5cb"],
 "where ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["\[Eta]", "0"], TraditionalForm]],ExpressionUUID->
  "8aa9ad0f-33d7-4331-a661-1539c6c04973"],
 "=\[VerticalSeparator]0\[RightAngleBracket]\[LeftAngleBracket]0\
\[VerticalSeparator]"
}], "Text",
