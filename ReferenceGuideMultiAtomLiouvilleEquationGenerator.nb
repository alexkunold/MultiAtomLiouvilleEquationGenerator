Cell[TextData[{
 "In the variable transistions the first number in the innermost list indexes \
the transition as stated by levtrlist. In this way the transition index 1 \
corresponds to any transition going from the levels of 5 ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["S", 
    RowBox[{"1", "/", "2"}]], TraditionalForm]],ExpressionUUID->
  "e44c34e9-b881-44b5-9d7d-e548a57201e2"],
 "F=2, with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["j", "1"], TraditionalForm]],ExpressionUUID->
  "59d3e9b0-698e-4362-9aeb-675bf7b98961"],
 "=1/2 and f=2 to those of 5 ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["P", 
    RowBox[{"3", "/", "2"}]], TraditionalForm]],ExpressionUUID->
  "7a8d6b4b-ccdf-4dac-a142-09b7c700d107"],
 "F=3 with ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["j", "1"], TraditionalForm]],ExpressionUUID->
  "401cbc48-160c-4e7e-ab26-4105601545dc"],
 "=3/2 and f=3 as it is shown for the first 5 elements of transitions"
}], "Text",
 CellChangeTimes->{{3.965306406300475*^9, 3.965306432852696*^9}, {
   3.9653064764102793`*^9, 3.965306669256566*^9}, 3.965306810863426*^9, {
