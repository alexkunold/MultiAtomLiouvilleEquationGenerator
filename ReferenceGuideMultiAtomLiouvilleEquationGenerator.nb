Cell["\<\
MASTER EQUATION
Set the initial conditions for the master equation,\
\>", "Text",
 CellChangeTimes->{{3.955038599444381*^9, 3.9550386042155523`*^9}, {
  3.964029867055401*^9, 3.964029921044456*^9}, {3.964030370066251*^9, 
  3.964030375498715*^9}},ExpressionUUID->"e2634ec9-fe08-4b9d-9b1f-\
dc5bdb538f33"],

Cell[BoxData[
 RowBox[{
  RowBox[{"inconds", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       SubscriptBox["\[Rho]", "ii"], "[", "0", "]"}], "==", 
      RowBox[{"Tr", "[", 
       RowBox[{
        RowBox[{"h", "[", 
         RowBox[{"[", "ii", "]"}], "]"}], ".", "\[Rho]0"}], "]"}]}], ",", 
     RowBox[{"{", 
      RowBox[{"ii", ",", "1", ",", "81"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.955037809567502*^9, 3.955037862837812*^9}, {
  3.955037899340591*^9, 3.955037926037444*^9}, {3.955038710181897*^9, 
  3.955038724849325*^9}, {3.955038859177465*^9, 3.955038885758461*^9}},
 CellLabel->"In[69]:=",ExpressionUUID->"25a5b735-d9f7-4143-9cf3-e9c3944421b5"],

Cell["join the differential equations with the initial conditions", "Text",
 CellChangeTimes->{{3.964029930585758*^9, 3.964029939803925*^9}, 
   3.964029977829417*^9},ExpressionUUID->"2e33858b-b3d9-45bd-9dd0-\
3c2781781781"],

Cell[BoxData[
 RowBox[{
  RowBox[{"deqs", "=", 
   RowBox[{
    RowBox[{"Join", "[", 
     RowBox[{"leqs", ",", "inconds"}], "]"}], "/.", "conds"}]}], 
  ";"}]], "Input",
 CellChangeTimes->{{3.955037933528566*^9, 3.955037948192758*^9}, {
  3.9550379865070972`*^9, 3.955037994938753*^9}, {3.955038176855754*^9, 
  3.955038179629255*^9}, {3.9550387222339973`*^9, 3.955038730454807*^9}, {
  3.955038892137939*^9, 3.955038901073423*^9}},
 CellLabel->"In[70]:=",ExpressionUUID->"149a2ebc-7f8e-4c7a-88c9-a3210f4b7731"],

Cell["and numerically solve the differential equations", "Text",
 CellChangeTimes->{{3.9640299558248253`*^9, 
  3.964029990308799*^9}},ExpressionUUID->"7d8f47f7-47ce-4cdd-a037-\
8f57ce5ad3a4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"sol", "=", 
   RowBox[{"NDSolve", "[", 
    RowBox[{"deqs", ",", 
     RowBox[{"Normal", "[", "rho", "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"t", ",", "0", ",", "10.0"}], "}"}]}], "]"}]}], ";"}]], "Input",\

 CellChangeTimes->{{3.955038224798077*^9, 3.955038312785888*^9}, {
  3.9550387328243017`*^9, 3.9550387375586967`*^9}, {3.955038909426608*^9, 
  3.955038920257182*^9}},
 CellLabel->"In[71]:=",ExpressionUUID->"768caca2-ae0f-4f87-ba31-1e7e5b412ab5"],

Cell["\<\
Build some operator op  =  \[VerticalSeparator]1\[RightAngleBracket]\
\[LeftAngleBracket]2\[VerticalSeparator]\[CircleTimes]1+ \
\[VerticalSeparator]2\[RightAngleBracket]\[LeftAngleBracket]1\
\[VerticalSeparator]\[CircleTimes]1, obtain the expected value and plot it\
\>", "Text",
 CellChangeTimes->{{3.964030021176975*^9, 3.964030043882319*^9}, {
  3.964030090190791*^9, 3.964030096889349*^9}, {3.964030127525902*^9, 
  3.9640301299600983`*^9}, {3.964030268710431*^9, 3.96403029012081*^9}, {
  3.964030346838591*^9, 
  3.96403035101052*^9}},ExpressionUUID->"088b6149-6465-471e-ba67-\
52444596dd59"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"op", "=", 
   RowBox[{
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{
      RowBox[{"SparseArray", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", "2"}], "}"}], "->", "1"}], ",", "3"}], "]"}], ",", 
      RowBox[{"IdentityMatrix", "[", "3", "]"}]}], "]"}], "+", 
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{
      RowBox[{"SparseArray", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"{", 
          RowBox[{"2", ",", "1"}], "}"}], "->", "1"}], ",", "3"}], "]"}], ",", 
      RowBox[{"IdentityMatrix", "[", "3", "]"}]}], "]"}]}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"expval", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"TensorContract", "[", 
      RowBox[{
       RowBox[{"h", ".", "op"}], ",", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"2", ",", "3"}], "}"}], "}"}]}], "]"}], ".", "rho"}], "/.", 
    "sol"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"Plot", "[", 
  RowBox[{"expval", ",", 
   RowBox[{"{", 
    RowBox[{"t", ",", "0", ",", "5"}], "}"}], ",", 
   RowBox[{"PlotRange", "->", "All"}]}], "]"}]}], "Input",
 CellChangeTimes->{{3.9550383229094887`*^9, 3.9550384117255363`*^9}, {
  3.955038472887144*^9, 3.955038475466589*^9}, {3.955039709071257*^9, 
  3.955039711015461*^9}, {3.9550481582421427`*^9, 3.9550481595683327`*^9}, {
  3.955048211634665*^9, 3.955048232865461*^9}, {3.955048363019829*^9, 
  3.955048448236741*^9}, {3.955048480958725*^9, 3.955048526121402*^9}, {
  3.9640301560673656`*^9, 3.964030256881363*^9}},
