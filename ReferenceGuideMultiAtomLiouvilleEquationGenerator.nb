Cell["\<\
Now we can observe the dynamics of different expectation values. For example, \
to compute the populations of levels \
\[VerticalSeparator]1\[RightAngleBracket] and \[VerticalSeparator]2\
\[RightAngleBracket] for both atoms we calculate the expectation values\
\>", "Text",
 CellChangeTimes->{{3.9648740586453*^9, 3.9648741926048603`*^9}, {
  3.964882840333768*^9, 3.964882843790159*^9}, {3.97860705088131*^9, 
  3.9786070610320597`*^9}},ExpressionUUID->"a59bcd9f-78cc-423d-87e1-\
ec6b7ed7a60d"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"p1", "=", 
   RowBox[{"SparseArray", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", "1"}], "}"}], "->", "1"}], "}"}], ",", "2"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"p2", "=", 
   RowBox[{"SparseArray", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"2", ",", "2"}], "}"}], "->", "1"}], "}"}], ",", "2"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"one", "=", 
   RowBox[{"SparseArray", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{
        RowBox[{"{", 
         RowBox[{"1", ",", "1"}], "}"}], "->", "1"}], ",", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"2", ",", "2"}], "}"}], "->", "1"}]}], "}"}], ",", "2"}], 
    "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"pop11", "=", 
  RowBox[{"ExpectationValue", "[", 
   RowBox[{"h", ",", "rho", ",", 
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{"p1", ",", "one"}], "]"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"pop21", "=", 
  RowBox[{"ExpectationValue", "[", 
   RowBox[{"h", ",", "rho", ",", 
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{"p2", ",", "one"}], "]"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{"pop12", "=", 
  RowBox[{"ExpectationValue", "[", 
   RowBox[{"h", ",", "rho", ",", 
    RowBox[{"KroneckerProduct", "[", 
     RowBox[{"one", ",", "p1"}], "]"}]}], "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pop22", "=", 
   RowBox[{"ExpectationValue", "[", 
    RowBox[{"h", ",", "rho", ",", 
     RowBox[{"KroneckerProduct", "[", 
      RowBox[{"one", ",", "p2"}], "]"}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pop11n", "=", 
   RowBox[{"pop11", "/.", "sol"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pop21n", "=", 
   RowBox[{"pop21", "/.", "sol"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pop12n", "=", 
   RowBox[{"pop12", "/.", "sol"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pop22n", "=", 
   RowBox[{"pop22", "/.", "sol"}]}], ";"}], "\[IndentingNewLine]"}], "Input",
