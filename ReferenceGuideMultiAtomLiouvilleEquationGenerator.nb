  3.964871056974976*^9}},ExpressionUUID->"f52e0f7e-add5-4024-918b-\
b2a3b0501f1e"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"LiH", "=", 
  RowBox[{"-", 
   RowBox[{"LiouvilleCommutator", "[", 
    RowBox[{"h", ",", "ham"}], "]"}]}]}]], "Input",
 CellChangeTimes->{{3.964871085885831*^9, 3.9648710925539417`*^9}, {
