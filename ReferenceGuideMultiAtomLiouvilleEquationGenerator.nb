Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{
    RowBox[{
     SuperscriptBox[
      SubscriptBox["\[Rho]", "1"], "\[Prime]",
      MultilineFunction->None], "[", "t", "]"}], "\[Equal]", 
    RowBox[{
     RowBox[{
      SubscriptBox["\[Gamma]", "1"], " ", 
      RowBox[{
       SubscriptBox["\[Rho]", "2"], "[", "t", "]"}]}], "-", 
     RowBox[{
      SqrtBox["2"], " ", 
      RowBox[{"Sin", "[", 
       RowBox[{"\[Phi]", "-", 
        RowBox[{"t", " ", 
         SubscriptBox["\[CapitalDelta]", "1"]}]}], "]"}], " ", 
      SubscriptBox["R", "1"], " ", 
      RowBox[{
       SubscriptBox["\[Rho]", "3"], "[", "t", "]"}]}], "-", 
     RowBox[{
      SqrtBox["2"], " ", 
      RowBox[{"Cos", "[", 
       RowBox[{"\[Phi]", "-", 
        RowBox[{"t", " ", 
         SubscriptBox["\[CapitalDelta]", "1"]}]}], "]"}], " ", 
      SubscriptBox["R", "1"], " ", 
      RowBox[{
       SubscriptBox["\[Rho]", "4"], "[", "t", "]"}]}], "+", 
     RowBox[{
      SubscriptBox["\[Gamma]", "1"], " ", 
      RowBox[{
       SubscriptBox["\[Rho]", "5"], "[", "t", "]"}]}], "+", 
     RowBox[{
      SqrtBox["2"], " ", 
      RowBox[{"Sin", "[", 
       RowBox[{"t", " ", 
        SubscriptBox["\[CapitalDelta]", "1"]}], "]"}], " ", 
      SubscriptBox["R", "1"], " ", 
      RowBox[{
       SubscriptBox["\[Rho]", "9"], "[", "t", "]"}]}], "+", 
     RowBox[{
      SubscriptBox["\[Gamma]", 
       RowBox[{"1", ",", "2"}]], " ", 
      RowBox[{
       SubscriptBox["\[Rho]", "11"], "[", "t", "]"}]}], "-", 
     RowBox[{
      SqrtBox["2"], " ", 
      RowBox[{"Cos", "[", 
       RowBox[{"t", " ", 
        SubscriptBox["\[CapitalDelta]", "1"]}], "]"}], " ", 
      SubscriptBox["R", "1"], " ", 
      RowBox[{
       SubscriptBox["\[Rho]", "13"], "[", "t", "]"}]}], "+", 
     RowBox[{
      SubscriptBox["\[Gamma]", 
       RowBox[{"1", ",", "2"}]], " ", 
      RowBox[{
       SubscriptBox["\[Rho]", "16"], "[", "t", "]"}]}]}]}], ",", 
   RowBox[{
    RowBox[{
     SuperscriptBox[
      SubscriptBox["\[Rho]", "2"], "\[Prime]",
      MultilineFunction->None], "[", "t", "]"}], "\[Equal]", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       SubscriptBox["\[Gamma]", "1"]}], " ", 
      RowBox[{
       SubscriptBox["\[Rho]", "2"], "[", "t", "]"}]}], "+", 
     RowBox[{
      SqrtBox["2"], " ", 
      RowBox[{"Sin", "[", 
       RowBox[{"\[Phi]", "-", 
        RowBox[{"t", " ", 
         SubscriptBox["\[CapitalDelta]", "1"]}]}], "]"}], " ", 
      SubscriptBox["R", "1"], " ", 
      RowBox[{
       SubscriptBox["\[Rho]", "3"], "[", "t", "]"}]}], "+", 
     RowBox[{
      SqrtBox["2"], " ", 
      RowBox[{"Cos", "[", 
       RowBox[{"\[Phi]", "-", 
        RowBox[{"t", " ", 
         SubscriptBox["\[CapitalDelta]", "1"]}]}], "]"}], " ", 
      SubscriptBox["R", "1"], " ", 
      RowBox[{
       SubscriptBox["\[Rho]", "4"], "[", "t", "]"}]}], "+", 
     RowBox[{
      SubscriptBox["\[Gamma]", "1"], " ", 
      RowBox[{
       SubscriptBox["\[Rho]", "6"], "[", "t", "]"}]}], "+", 
     RowBox[{
      SqrtBox["2"], " ", 
      RowBox[{"Sin", "[", 
       RowBox[{"t", " ", 
        SubscriptBox["\[CapitalDelta]", "1"]}], "]"}], " ", 
      SubscriptBox["R", "1"], " ", 
      RowBox[{
       SubscriptBox["\[Rho]", "10"], "[", "t", "]"}]}], "-", 
     RowBox[{
      FractionBox["1", "2"], " ", 
      SubscriptBox["\[Gamma]", 
       RowBox[{"1", ",", "2"}]], " ", 
      RowBox[{
       SubscriptBox["\[Rho]", "11"], "[", "t", "]"}]}], "-", 
     RowBox[{
      SubscriptBox["\[CapitalOmega]", "1"], " ", 
      RowBox[{
       SubscriptBox["\[Rho]", "12"], "[", "t", "]"}]}], "-", 
     RowBox[{
      SqrtBox["2"], " ", 
      RowBox[{"Cos", "[", 
       RowBox[{"t", " ", 
        SubscriptBox["\[CapitalDelta]", "1"]}], "]"}], " ", 
      SubscriptBox["R", "1"], " ", 
      RowBox[{
       SubscriptBox["\[Rho]", "14"], "[", "t", "]"}]}], "+", 
     RowBox[{
      SubscriptBox["\[CapitalOmega]", "1"], " ", 
      RowBox[{
       SubscriptBox["\[Rho]", "15"], "[", "t", "]"}]}], "-", 
     RowBox[{
      FractionBox["1", "2"], " ", 
      SubscriptBox["\[Gamma]", 
       RowBox[{"1", ",", "2"}]], " ", 
      RowBox[{
       SubscriptBox["\[Rho]", "16"], "[", "t", "]"}]}]}]}], ",", 
