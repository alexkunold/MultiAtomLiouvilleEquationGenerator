   RowBox[{"{", 
    RowBox[{"1", ",", "3"}], "}"}], "]"}], "]"}]], "Input",
 CellChangeTimes->{{3.965308698000107*^9, 3.965308706036894*^9}, {
  3.965310843612973*^9, 3.965310848555485*^9}},
 CellLabel->"In[17]:=",ExpressionUUID->"7ebd6183-ddea-4db3-9344-b86f450559e4"],

