Cell[CellGroupData[{

Cell["Examples", "Title",
 CellChangeTimes->{{3.965230567091264*^9, 3.965230578778409*^9}},
 CellTags->"Examples",ExpressionUUID->"40666b19-fa6c-49d2-a700-64118fac90b6"],

Cell["\<\
These are some examples that walk users through the process of solving the \
dynamics of a variety of physical systems.\
\>", "Text",
 CellChangeTimes->{{3.965230611179061*^9, 3.965230615963036*^9}, {
  3.967476619674815*^9, 3.967476620748086*^9}, {3.97488886879327*^9, 
  3.974888906711404*^9}},ExpressionUUID->"513e6089-f1a2-4f2d-8096-\
c68a9afb9dab"],

