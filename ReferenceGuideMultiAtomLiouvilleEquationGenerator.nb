Cell["\<\
Assuming that the transitions \[VerticalSeparator]1\[RightAngleBracket] \
\[RightArrow] \[VerticalSeparator]2\[RightAngleBracket] and \
\[VerticalSeparator]2\[RightAngleBracket] \[RightArrow] \[VerticalSeparator]3\
\[RightAngleBracket] have distinct energy gaps and therefore do not couple to \
each other, the transdd variable is given by\
\>", "Text",
 CellChangeTimes->{
  3.963769453558571*^9, 3.964034220115075*^9, 3.96486861699891*^9, {
   3.9730153459725437`*^9, 3.973015347215589*^9}, {3.9730154701050797`*^9, 
