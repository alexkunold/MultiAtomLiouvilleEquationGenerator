 ", ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["tr", "2"], ",", " ", "\[Alpha]", ",", " ", "na", ",", " ", 
    RowBox[{"nl", " ", "\[Element]"}]}], TraditionalForm]],
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"2df67958-3122-4948-907c-c5459b14e794"],
 " Ingeters\nReturns a SparseArray with the jump operator \
\[VerticalSeparator]",
 Cell[BoxData[
  FormBox[
   RowBox[{
    SubscriptBox["tr", "1"], "\[RightAngleBracket]"}], TraditionalForm]],
  FontWeight->"Plain",
  FontSlant->"Plain",ExpressionUUID->"cf5a3f66-c5c2-429a-bed3-aab8b376d0f5"],
