89b981944aa4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"ns", "=", "8"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"a", "=", 
   RowBox[{"dop", "[", "ns", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"at", "=", 
   RowBox[{"aop", "[", "ns", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"one", "=", 
   RowBox[{"SparseArray", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"ii", ",", "ii"}], "}"}], "->", "1"}], ",", 
      RowBox[{"{", 
       RowBox[{"ii", ",", "1", ",", "ns"}], "}"}]}], "]"}], "]"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.964783484480375*^9, 3.964783485255618*^9}, {
  3.964783532789624*^9, 3.964783535922825*^9}},
 CellLabel->
