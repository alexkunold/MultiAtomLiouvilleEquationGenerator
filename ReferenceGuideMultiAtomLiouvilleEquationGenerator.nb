Cell[TextData[{
 "Proj[h, Op]: h, Op \[Element] SparseArray\nReturns a SparseArray of \
dimension Length[h] = Length[Op] that contains the expansion coefficients ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Op", "i"], TraditionalForm]],ExpressionUUID->
  "0d7e2c3e-9915-4cc6-8465-5f16577e97d8"],
 " of the operator Op given by ",
 Cell[BoxData[
  FormBox[
   SubscriptBox["Op", "i"], TraditionalForm]],ExpressionUUID->
  "7328b457-ca7d-4813-a587-3ca111ff38fd"],
 " = Tr[",
 Cell[BoxData[
  FormBox[
   RowBox[{
    RowBox[{
     SubscriptBox["h", "i"], "Op"}], "]"}], TraditionalForm]],ExpressionUUID->
  "701167f7-deec-4387-b1bc-dec46a9879e0"],
 " where h is the matrix basis."
}], "Text",
