       Subscript[$CellContext`R, 1] + 
      Complex[0, 1] 2^Rational[-1, 2] 
       E^(Complex[0, 1] $CellContext`t 
         Subscript[$CellContext`\[CapitalDelta], 1]) 
       Subscript[$CellContext`R, 1]), 
     Complex[0, -1] (
      2^Rational[-1, 2] 
       E^(Complex[0, -1] $CellContext`t 
         Subscript[$CellContext`\[CapitalDelta], 1]) 
       Subscript[$CellContext`R, 1] - 2^Rational[-1, 2] 
      E^(Complex[0, 1] $CellContext`t 
        Subscript[$CellContext`\[CapitalDelta], 1]) 
      Subscript[$CellContext`R, 1]), 
     Complex[0, -1] ((-2^Rational[-1, 2]) 
       E^(Complex[0, -1] $CellContext`t 
         Subscript[$CellContext`\[CapitalDelta], 1]) 
       Subscript[$CellContext`R, 1] + 
      2^Rational[-1, 2] 
       E^(Complex[0, 1] $CellContext`t 
         Subscript[$CellContext`\[CapitalDelta], 1]) 
       Subscript[$CellContext`R, 1]), 
     Complex[0, -1] (
      Complex[0, 1] 2^Rational[-1, 2] 
       E^(Complex[0, -1] $CellContext`t 
         Subscript[$CellContext`\[CapitalDelta], 1]) 
       Subscript[$CellContext`R, 1] + 
      Complex[0, 1] 2^Rational[-1, 2] 
       E^(Complex[0, 1] $CellContext`t 
         Subscript[$CellContext`\[CapitalDelta], 1]) 
       Subscript[$CellContext`R, 1]), 
     Complex[0, -1] (
      Complex[0, -1] 2^Rational[-1, 2] 
       E^(Complex[0, -1] $CellContext`t 
         Subscript[$CellContext`\[CapitalDelta], 1]) 
       Subscript[$CellContext`R, 1] + 
      Complex[0, -1] 2^Rational[-1, 2] 
       E^(Complex[0, 1] $CellContext`t 
         Subscript[$CellContext`\[CapitalDelta], 1]) 
       Subscript[$CellContext`R, 1])}}],
  Editable->False,
  SelectWithContents->True,
  Selectable->False]], "Output",
