        RowBox[{"ii", ",", "2"}], "]"}]}], ",", 
      RowBox[{"{", 
       RowBox[{"ii", ",", "n"}], "}"}]}], "]"}]}], 
   "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rhon", "=", 
   RowBox[{"Normal", "[", "rho", "]"}]}], ";"}], "\[IndentingNewLine]", 
